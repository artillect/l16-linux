#!/usr/bin/env python3
# l16-lri-assemble [--wb R,B] [--awb-mode N] [--iso ISO] [--exposure-us US] OUT.lri RAW...:
# build an LRI file from l16-capture's per-ASIC transfers (a burst: one per frame, OUT_1.lri ...).
# --wb: white balance gains (red, blue) instead of gray-world ones; --awb-mode: ViewPreferences'
# AWBMode (0 auto, 1 daylight, 3 cloudy, 4 tungsten, 5 fluorescent); --iso and --exposure-us: the
# photo's exposure, recorded as the view preferences' image gain (ISO/100: above ISO 775 it is
# only here, the modules' analog gain stops at 7.75) and integration time, as stock's.
#
# Each ASIC sends its capture as one LRI block, cut into 16 228 352-byte records (the last one
# holds the block's LightHeader protobuf). CAMSS receives every record as a 1408 x 9219 RAW10
# frame, 16 225 440 bytes: the record minus padding after the image. So each RAW here is a
# series of such frames, the block's records in order. Putting them back together, each padded
# to the record size, gives the block, and the blocks one after another give the LRI file.
#
# Stock LRIs also carry this camera's factory calibration (hw_info, module and device
# calibration, sensor data) and view preferences in their last blocks, which renderers like
# lri-rs need. If DEVICE_BLOCKS exists (those blocks cut from one of this camera's own stock
# LRIs; it holds the camera's unique ID, so it is kept on the device only), it is appended.
import re
import struct
import sys

RECORD = 16228352		# 3962 pages of 4 KiB
FRAME = 1760 * 9219		# what CAMSS stores per record
DEVICE_BLOCKS = "/var/lib/l16/lri-device-blocks.bin"


def blocks(path):
	"""The LRI blocks in one ASIC's transfer: one per burst frame (usually one). Each starts
	with an LELR header; its message offset says how many records it spans."""
	with open(path, "rb") as f:
		frames = []
		while True:
			fr = f.read(FRAME)
			if not fr:
				break
			if len(fr) != FRAME:
				sys.exit("%s: short frame (%d bytes)" % (path, len(fr)))
			frames.append(fr)
	out = []
	while frames:
		sig, length, msg_off, msg_len, msg_type = struct.unpack_from("<4sQQIB", frames[0])
		if sig != b"LELR":
			sys.exit("%s: record %d has no LELR block header" % (path, len(out)))
		n = msg_off // RECORD + 1
		# the block ends right after the message (ASIC1) or at the next 4 KiB page (ASIC2)
		if msg_off % RECORD or n > len(frames) or not msg_off + msg_len <= length <= msg_off + FRAME:
			sys.exit("%s: block header (length %d, message at %d, %d bytes) does not fit %d records"
				 % (path, length, msg_off, msg_len, len(frames)))
		pad = bytes(RECORD - FRAME)
		parts = [fr + pad for fr in frames[:n - 1]]
		parts.append(frames[n - 1][:length - msg_off])
		print("%s: %d images, LightHeader %d bytes, block %d bytes" % (path, n - 1, msg_len, length))
		out.append(parts)
		frames = frames[n:]
	return out


def awb_gains(frame, red=(1, 0)):
	"""Gray-world gains (red, blue) from the first image of a block, sampled every 40 pixels,
	as a little-endian 10-bit bitstream; @red: where red is in its 2x2 quad (x, y): A1 GRBG
	(1, 0), B2 at 70 mm BGGR (1, 1)."""
	W, H, STRIDE, BLACK = 4160, 3120, 5200, 42
	def px(row, col):
		o = 32 + row * STRIDE + col * 10 // 8
		v = frame[o] | frame[o + 1] << 8 | frame[o + 2] << 16
		return (v >> (col * 10 % 8) & 1023) - BLACK
	r = g = b = 0
	for row in range(200, H - 200, 40):
		for col in range(200, W - 200, 40):
			rx, ry = red
			rr, bb = px(row + ry, col + rx), px(row + 1 - ry, col + 1 - rx)
			g1, g2 = px(row + ry, col + 1 - rx), px(row + 1 - ry, col + rx)
			if min(g1, rr, bb, g2) > 8 and max(g1, rr, bb, g2) < 940:
				r += rr; g += (g1 + g2) / 2; b += bb
	return (g / r, g / b) if r and b else (1.0, 1.0)


def varint(v):
	out = b""
	while True:
		out += bytes([v & 0x7f | (0x80 if v > 0x7f else 0)])
		v >>= 7
		if not v:
			return out


def read_varint(b, i):
	v = sh = 0
	while True:
		v |= (b[i] & 0x7f) << sh
		sh += 7
		i += 1
		if b[i - 1] < 0x80:
			return v, i


def fields(msg):
	"""A protobuf message's top-level fields: (number, raw bytes of the whole field)."""
	out, i = [], 0
	while i < len(msg):
		start = i
		key, i = read_varint(msg, i)
		wt = key & 7
		if wt == 0:
			_, i = read_varint(msg, i)
		elif wt == 1:
			i += 8
		elif wt == 2:
			n, i = read_varint(msg, i)
			i += n
		elif wt == 5:
			i += 4
		else:
			raise ValueError("wire type %d" % wt)
		out.append((key >> 3, msg[start:i]))
	return out


def length_field(num, data):
	return varint(num << 3 | 2) + varint(len(data)) + data


def first_red(header):
	"""Where red is in the 2x2 quad of a block's first image (x, y), from its LightHeader
	(camera modules, field 12: sensor data surface 9 with its data offset 5, Bayer red
	override 13 {x 1, y 2}); A1's by default."""
	best = None
	for n, f in fields(header):
		if n != 12:
			continue
		_, i = read_varint(f, 0)
		_, i = read_varint(f, i)
		off, red = None, None
		for m, g in fields(f[i:]):
			if m in (9, 13):
				_, j = read_varint(g, 0)
				_, j = read_varint(g, j)
				sub = {k: v for k, v in fields(g[j:])}
				if m == 9 and 5 in sub:
					off, _ = read_varint(sub[5], 1)
				if m == 13:
					xy = [read_varint(sub[k], 1)[0] if k in sub else 0 for k in (1, 2)]
					red = tuple(xy) if all(v < 2 for v in xy) else None
		if off is not None and red and (best is None or off < best[0]):
			best = (off, red)
	return best[1] if best else (1, 0)


def taken(header):
	"""What the modules took, from an ASIC's LightHeader (camera modules, field 12: analog gain
	7, exposure ns 8, digital gain 14): the highest gain (the reference module runs a stop
	under the others) and the median exposure (the modules differ by microseconds)."""
	gains, times = [], []
	for n, f in fields(header):
		if n != 12:
			continue
		_, i = read_varint(f, 0)
		_, i = read_varint(f, i)
		ag = dg = 1.0
		ns = None
		for m, g in fields(f[i:]):
			if m == 7:
				ag = struct.unpack("<f", g[-4:])[0]
			elif m == 14:
				dg = struct.unpack("<f", g[-4:])[0]
			elif m == 8:
				ns, _ = read_varint(g, 1)
		if ns:
			gains.append(ag * dg)
			times.append(ns)
	if not times:
		return None, None
	return max(gains), sorted(times)[len(times) // 2]


def with_view(blocks, gains, awb_mode, gain, exposure_ns):
	"""The device blocks end with a LightHeader holding the view preferences (field 19).
	Rewrite them with this photo's white balance (awb_mode 7, awb_gains 15) and exposure
	(image_gain 10 / display_gain 18, integration time 11 / 19), keeping the other fields."""
	o = last = 0
	while o + 32 <= len(blocks):
		sig, length = struct.unpack_from("<4sQ", blocks, o)
		if sig != b"LELR" or length < 32:
			return blocks
		last, o = o, o + length
	sig, length, msg_off, msg_len, _ = struct.unpack_from("<4sQQIB", blocks, last)
	header = fields(blocks[last + msg_off:last + msg_off + msg_len])
	vp = [f for n, f in header if n == 19]
	if not vp:
		return blocks
	_, i = read_varint(vp[0], 0)
	_, i = read_varint(vp[0], i)
	keep = [f for n, f in fields(vp[0][i:]) if n not in (7, 10, 11, 15, 18, 19)]
	chan = struct.pack("<BfBfBfBf", 0x0d, gains[0], 0x15, 1.0, 0x1d, 1.0, 0x25, gains[1])
	new = b"".join(keep) + varint(7 << 3) + varint(awb_mode) + length_field(15, chan)
	if gain:
		new += varint(10 << 3 | 5) + struct.pack("<f", gain) + varint(18 << 3 | 5) + struct.pack("<f", gain)
	if exposure_ns:
		new += varint(11 << 3) + varint(exposure_ns) + varint(19 << 3) + varint(exposure_ns)
	msg = b"".join(f for n, f in header if n != 19) + length_field(19, new)
	size = max(length, msg_off + len(msg))
	block = blocks[last:last + msg_off]
	block = struct.pack("<4sQQIB", b"LELR", size, msg_off, len(msg), block[24]) + block[25:]
	block += msg + bytes(size - msg_off - len(msg))
	return blocks[:last] + block


args = sys.argv[1:]
wb, awb_mode, iso, exposure_us = None, 0, None, None
while args and args[0].startswith("--"):
	opt, val = args[0], args[1]
	args = args[2:]
	if opt == "--wb":
		wb = tuple(float(x) for x in val.split(","))
	elif opt == "--awb-mode":
		awb_mode = int(val)
	elif opt == "--iso":
		iso = float(val)
	elif opt == "--exposure-us":
		exposure_us = int(val)
	else:
		sys.exit("unknown option " + opt)
out = args[0]
per_asic = [blocks(path) for path in args[1:]]
count = len(per_asic[0])
if any(len(b) != count for b in per_asic):
	sys.exit("the ASICs sent different numbers of blocks: %s" % [len(b) for b in per_asic])
try:
	with open(DEVICE_BLOCKS, "rb") as f:
		device = f.read()
except FileNotFoundError:
	device = None
	print("no", DEVICE_BLOCKS, "(calibration); renderers may need it")
# a burst: one LRI per frame, OUT_1.lri, OUT_2.lri, ...
for i in range(count):
	name = out if count == 1 else "%s_%d%s" % (out[:-4], i + 1, out[-4:]) if out.endswith(".lri") else "%s_%d" % (out, i + 1)
	gains = wb or awb_gains(per_asic[0][i][0], first_red(per_asic[0][i][-1]))
	print("white balance: red %.3f blue %.3f" % gains)
	with open(name, "wb") as o:
		for asic in per_asic:
			for part in asic[i]:
				o.write(part)
		if device:
			# the exposure as taken (the ASICs choose it in auto and the priority modes);
			# the gain too, but above the modules' 7.75 the rest is digital, recorded only
			# here: the app's ISO then
			gain, ns = taken(per_asic[0][i][-1])
			if gain is None or (iso and gain >= 7.74 and iso / 100 > gain):
				gain = iso and iso / 100
			ns = ns or (exposure_us and exposure_us * 1000)
			o.write(with_view(device, gains, awb_mode, gain, ns))
	print("wrote", name)
