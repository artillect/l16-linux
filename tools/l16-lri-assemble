#!/usr/bin/env python3
# l16-lri-assemble OUT.lri RAW...: build an LRI file from l16-capture's per-ASIC transfers
# (a burst: one per frame, OUT_1.lri ...).
#
# Each ASIC sends its capture as one LRI block, cut into 16 228 352-byte records (the last one
# holds the block's LightHeader protobuf). CAMSS receives every record as a 1408 x 9219 RAW10
# frame, 16 225 440 bytes: the record minus padding after the image. So each RAW here is a
# series of such frames, the block's records in order. Putting them back together, each padded
# to the record size, gives the block, and the blocks one after another give the LRI file.
#
# Stock LRIs also carry this camera's factory calibration (hw_info, module and device
# calibration, sensor data) and view preferences in their last blocks, which renderers like
# lri-rs need. If DEVICE_BLOCKS exists (those blocks cut from one of this camera's own stock
# LRIs; it holds the camera's unique ID, so it is kept on the device only), it is appended.
import re
import struct
import sys

RECORD = 16228352		# 3962 pages of 4 KiB
FRAME = 1760 * 9219		# what CAMSS stores per record
DEVICE_BLOCKS = "/var/lib/l16/lri-device-blocks.bin"


def blocks(path):
	"""The LRI blocks in one ASIC's transfer: one per burst frame (usually one). Each starts
	with an LELR header; its message offset says how many records it spans."""
	with open(path, "rb") as f:
		frames = []
		while True:
			fr = f.read(FRAME)
			if not fr:
				break
			if len(fr) != FRAME:
				sys.exit("%s: short frame (%d bytes)" % (path, len(fr)))
			frames.append(fr)
	out = []
	while frames:
		sig, length, msg_off, msg_len, msg_type = struct.unpack_from("<4sQQIB", frames[0])
		if sig != b"LELR":
			sys.exit("%s: record %d has no LELR block header" % (path, len(out)))
		n = msg_off // RECORD + 1
		# the block ends right after the message (ASIC1) or at the next 4 KiB page (ASIC2)
		if msg_off % RECORD or n > len(frames) or not msg_off + msg_len <= length <= msg_off + FRAME:
			sys.exit("%s: block header (length %d, message at %d, %d bytes) does not fit %d records"
				 % (path, length, msg_off, msg_len, len(frames)))
		pad = bytes(RECORD - FRAME)
		parts = [fr + pad for fr in frames[:n - 1]]
		parts.append(frames[n - 1][:length - msg_off])
		print("%s: %d images, LightHeader %d bytes, block %d bytes" % (path, n - 1, msg_len, length))
		out.append(parts)
		frames = frames[n:]
	return out


def awb_gains(frame):
	"""Gray-world gains (red, blue) from the first image of a block: the reference module,
	GRBG (A1), sampled every 40 pixels, as a little-endian 10-bit bitstream."""
	W, H, STRIDE, BLACK = 4160, 3120, 5200, 42
	def px(row, col):
		o = 32 + row * STRIDE + col * 10 // 8
		v = frame[o] | frame[o + 1] << 8 | frame[o + 2] << 16
		return (v >> (col * 10 % 8) & 1023) - BLACK
	r = g = b = 0
	for row in range(200, H - 200, 40):
		for col in range(200, W - 200, 40):
			g1, rr, bb, g2 = px(row, col), px(row, col + 1), px(row + 1, col), px(row + 1, col + 1)
			if min(g1, rr, bb, g2) > 8 and max(g1, rr, bb, g2) < 940:
				r += rr; g += (g1 + g2) / 2; b += bb
	return (g / r, g / b) if r and b else (1.0, 1.0)


def with_awb(blocks, gains):
	"""The view preferences' awb_gains (a ChannelGain: four fixed32 floats, fields 1-4) are the
	last ChannelGain in the device blocks; set them to this photo's gains, same size."""
	pat = b"".join(bytes([tag]) + b"(....)" for tag in (0x0d, 0x15, 0x1d, 0x25))
	m = list(re.finditer(pat, blocks, re.S))
	if not m:
		return blocks
	new = struct.pack("<BfBfBfBf", 0x0d, gains[0], 0x15, 1.0, 0x1d, 1.0, 0x25, gains[1])
	return blocks[:m[-1].start()] + new + blocks[m[-1].end():]


out = sys.argv[1]
per_asic = [blocks(path) for path in sys.argv[2:]]
count = len(per_asic[0])
if any(len(b) != count for b in per_asic):
	sys.exit("the ASICs sent different numbers of blocks: %s" % [len(b) for b in per_asic])
try:
	with open(DEVICE_BLOCKS, "rb") as f:
		device = f.read()
except FileNotFoundError:
	device = None
	print("no", DEVICE_BLOCKS, "(calibration); renderers may need it")
# a burst: one LRI per frame, OUT_1.lri, OUT_2.lri, ...
for i in range(count):
	name = out if count == 1 else "%s_%d%s" % (out[:-4], i + 1, out[-4:]) if out.endswith(".lri") else "%s_%d" % (out, i + 1)
	gains = awb_gains(per_asic[0][i][0])
	print("white balance: red %.3f blue %.3f" % gains)
	with open(name, "wb") as o:
		for asic in per_asic:
			for part in asic[i]:
				o.write(part)
		if device:
			o.write(with_awb(device, gains))
	print("wrote", name)
