#!/usr/bin/env python3
# l16-raw2png RAW PNG [FRAME]: one frame of a packed RAW10 GRBG capture (2080x1560, as
# l16-preview-test writes it) to a half-resolution PNG with gray-world auto white balance.
# The ASICs do no white balance; on stock, Qualcomm's ISP did it. Needs numpy and Pillow.
import sys
import numpy as np
from PIL import Image

W, H, BLACK = 2080, 1560, 43
raw, out = sys.argv[1], sys.argv[2]
frame = int(sys.argv[3]) if len(sys.argv) > 3 else 0

size = H * W * 5 // 4
d = np.fromfile(raw, np.uint8, count=size, offset=frame * size).reshape(H, W // 4, 5).astype(np.uint16)
px = np.empty((H, W), np.uint16)
for i in range(4):
    px[:, i::4] = (d[:, :, i] << 2) | ((d[:, :, 4] >> (2 * i)) & 3)

g = np.clip(px.astype(np.float32) - BLACK, 0, None)
rgb = np.dstack([g[0::2, 1::2], (g[0::2, 0::2] + g[1::2, 1::2]) / 2, g[1::2, 0::2]])

# gray world over pixels that are neither near-black nor clipped
ok = (rgb.min(axis=2) > 8) & (rgb.max(axis=2) < 1023 - BLACK - 8)
mean = rgb[ok].mean(axis=0) if ok.sum() > 1000 else rgb.reshape(-1, 3).mean(axis=0)
gains = mean[1] / mean
rgb *= gains

rgb /= np.percentile(rgb, 99.5)
Image.fromarray((np.clip(rgb, 0, 1) ** (1 / 2.2) * 255).astype(np.uint8)).save(out)
print(f"frame {frame}: white balance gains R {gains[0]:.2f} G 1.00 B {gains[2]:.2f}")
