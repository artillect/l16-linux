From: Riley <oreo4455@gmail.com>
Subject: [PATCH] layer-shell-effects: no slide for a resting folded surface whose margin changes

The commit handler re-targets a slide in to a changed folded margin
("in case it's ongoing") whenever anim_dir is ANIM_DIR_IN, which it stays
once the surface has folded. So every later folded margin change, as a
rotation brings, slid the surface from its old margin: Phosh's home and its
overview background crossed the screen. Only re-target a running slide;
move a resting folded surface to the new margin at once.
---
--- a/src/layer-shell-effects.c
+++ b/src/layer-shell-effects.c
@@ -626,6 +626,9 @@
 }
 
 
+static void apply_margin (PhocDraggableLayerSurface *drag_surface, double margin);
+
+
 static void
 draggable_layer_surface_handle_commit (struct wl_listener *listener, void *data)
 {
@@ -647,10 +650,23 @@
   drag_surface->current.drag_mode = drag_surface->pending.drag_mode;
   drag_surface->current.drag_handle = drag_surface->pending.drag_handle;
 
-  /* Update animation end in case it's ongoing to compensate for size changes */
+  /* Update animation end in case it's ongoing to compensate for size changes. anim_dir
+   * stays ANIM_DIR_IN once folded, so check that it is: otherwise a resting folded surface
+   * whose folded margin changes (a rotation) slid there from its old margin, Phosh's home
+   * (overview and its background) showing on the way. Move it there at once instead */
   if (changed && drag_surface->drag.anim_dir == ANIM_DIR_IN) {
-    drag_surface->drag.anim_end = drag_surface->current.folded;
-    phoc_draggable_layer_surface_slide (drag_surface, ANIM_DIR_IN);
+    if (drag_surface->drag.anim_id) {
+      drag_surface->drag.anim_end = drag_surface->current.folded;
+      phoc_draggable_layer_surface_slide (drag_surface, ANIM_DIR_IN);
+    } else if (drag_surface->drag.last_state ==
+               ZPHOC_DRAGGABLE_LAYER_SURFACE_V1_DRAG_END_STATE_FOLDED &&
+               layer_surface->layer_surface->output) {
+      PhocOutput *output = PHOC_OUTPUT (layer_surface->layer_surface->output->data);
+
+      apply_margin (drag_surface, drag_surface->current.folded);
+      phoc_layer_shell_arrange (output);
+      phoc_output_damage_whole (output);
+    }
   }
 
   /* TODO: cancel related gestures on drag mode changes */
