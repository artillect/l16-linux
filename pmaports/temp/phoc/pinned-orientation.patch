+typedef struct {
+  bool                     whole;
+  enum wl_output_transform transform;
+} DamageViewTransformData;
+
+/* As damage_surface_iterator, for a view drawn with another transform than the output's:
+ * the damage goes to the damage ring through that transform */
+static void
+damage_view_transform_surface_iterator (PhocOutput         *self,
+                                        struct wlr_surface *wlr_surface,
+                                        struct wlr_box     *_box,
+                                        float               scale,
+                                        void               *data)
+{
+  PhocOutputPrivate *priv = phoc_output_get_instance_private (self);
+  DamageViewTransformData *d = data;
+  PhocSurface *surface = wlr_surface->data;
+  struct wlr_box box = *_box;
+  int width = self->wlr_output->width, height = self->wlr_output->height;
+  pixman_region32_t damage;
+
+  /* that transform's resolution */
+  if (d->transform & WL_OUTPUT_TRANSFORM_90) {
+    width = self->wlr_output->height;
+    height = self->wlr_output->width;
+  }
+
+  phoc_utils_scale_box (&box, scale);
+  phoc_utils_scale_box (&box, self->wlr_output->scale);
+
+  pixman_region32_init (&damage);
+  wlr_surface_get_effective_damage (wlr_surface, &damage);
+  pixman_region32_union (&damage, &damage, phoc_surface_get_damage (surface));
+  phoc_surface_clear_damage (surface);
+
+  wlr_region_scale (&damage, &damage, scale);
+  wlr_region_scale (&damage, &damage, self->wlr_output->scale);
+  if (ceil (self->wlr_output->scale) > wlr_surface->current.scale)
+    wlr_region_expand (&damage, &damage, ceil (self->wlr_output->scale) - wlr_surface->current.scale);
+  pixman_region32_translate (&damage, box.x, box.y);
+
+  if (d->whole)
+    pixman_region32_union_rect (&damage, &damage, box.x, box.y, box.width, box.height);
+
+  pixman_region32_intersect_rect (&damage, &damage, 0, 0, width, height);
+  if (!pixman_region32_empty (&damage)) {
+    /* to the damage ring's buffer coordinates */
+    wlr_region_transform (&damage, &damage, wlr_output_transform_invert (d->transform),
+                          width, height);
+    wlr_damage_ring_add (&priv->damage_ring, &damage);
+    wlr_output_schedule_frame (self->wlr_output);
+  }
+  pixman_region32_fini (&damage);
+
+  if (!wl_list_empty (&wlr_surface->current.frame_callback_list))
+    wlr_output_schedule_frame (self->wlr_output);
+}
