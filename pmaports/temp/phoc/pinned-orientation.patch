+/**
+ * phoc_output_transform_box_as:
+ * @self: The output
+ * @box: A box in output coordinates of an output with @transform
+ * @transform: The transform
+ *
+ * As [method@Output.transform_box], for the output as it would be with @transform:
+ * a pinned view's boxes (see [method@Output.get_view_transform]).
+ */
+void
+phoc_output_transform_box_as (PhocOutput *self, struct wlr_box *box,
+                              enum wl_output_transform transform)
+{
+  int ow = self->wlr_output->width, oh = self->wlr_output->height;
+
+  if (transform & WL_OUTPUT_TRANSFORM_90) {
+    ow = self->wlr_output->height;
+    oh = self->wlr_output->width;
+  }
+  wlr_box_transform (box, box, wlr_output_transform_invert (transform), ow, oh);
+}
+
+/**
+ * phoc_output_get_view_transform:
+ * @self: The output
+ * @view: A view
+ *
+ * The transform @view is drawn with on this output: the output's, or for a view
+ * fullscreen on it whose app pins an orientation (X-Phosh-Orientation in its desktop
+ * file), that one. Such a view keeps its size when the output rotates, and only the
+ * shell's layers turn with the device.
+ *
+ * Returns: The transform
+ */
+enum wl_output_transform
+phoc_output_get_view_transform (PhocOutput *self, PhocView *view)
+{
+  int pinned;
+
+  if (view && phoc_view_is_fullscreen (view) && phoc_view_get_fullscreen_output (view) == self) {
+    pinned = phoc_view_get_pinned_transform (view);
+    if (pinned >= 0)
+      return pinned;
+  }
+  return self->wlr_output->transform;
+}
+
+/**
+ * phoc_output_view_is_rotated:
+ * @self: The output
+ * @view: A view
+ *
+ * Returns: Whether @view is drawn with another transform than the output's
+ */
+gboolean
+phoc_output_view_is_rotated (PhocOutput *self, PhocView *view)
+{
+  return phoc_output_get_view_transform (self, view) != self->wlr_output->transform;
+}
+
+/**
+ * phoc_output_map_to_view:
+ * @self: The output
+ * @view: A view
+ * @ox: (inout): x in output coordinates
+ * @oy: (inout): y in output coordinates
+ *
+ * Map a point in output coordinates to those of the output as @view is drawn
+ * (see [method@Output.get_view_transform]): where it lands in a pinned view.
+ */
+void
+phoc_output_map_to_view (PhocOutput *self, PhocView *view, double *ox, double *oy)
+{
+  float scale = self->wlr_output->scale;
+  struct wlr_box box;
+
+  if (!phoc_output_view_is_rotated (self, view))
+    return;
+
+  /* to the buffer's pixels, then into the view's orientation */
+  box = (struct wlr_box) { .x = floor (*ox * scale), .y = floor (*oy * scale), .width = 1, .height = 1 };
+  phoc_output_transform_box (self, &box);
+  wlr_box_transform (&box, &box, phoc_output_get_view_transform (self, view),
+                     self->wlr_output->width, self->wlr_output->height);
+  *ox = (box.x + 0.5) / scale;
+  *oy = (box.y + 0.5) / scale;
+}
+
