+/* X-Phosh-Orientation=landscape in the app's desktop file: drawn in landscape (the
+ * transform Phosh rotates to for "right-up") while it's fullscreen, whatever the output's */
+static int
+lookup_pinned_transform (const char *app_id)
+{
+  g_autoptr (GKeyFile) key_file = g_key_file_new ();
+  g_autofree char *path = NULL;
+  g_autofree char *orientation = NULL;
+
+  if (!app_id)
+    return -1;
+
+  path = g_strdup_printf ("applications/%s.desktop", app_id);
+  if (!g_key_file_load_from_data_dirs (key_file, path, NULL, G_KEY_FILE_NONE, NULL))
+    return -1;
+
+  orientation = g_key_file_get_string (key_file, G_KEY_FILE_DESKTOP_GROUP,
+                                       "X-Phosh-Orientation", NULL);
+  if (g_strcmp0 (orientation, "landscape") == 0) {
+    g_debug ("%s is pinned to landscape", app_id);
+    return WL_OUTPUT_TRANSFORM_270;
+  }
+  return -1;
+}
+
+
+/**
+ * phoc_view_get_pinned_transform:
+ * @self: The view
+ *
+ * Returns: The transform the view's app pins it to when fullscreen, or -1
+ */
+int
+phoc_view_get_pinned_transform (PhocView *self)
+{
+  PhocViewPrivate *priv;
+
+  g_assert (PHOC_IS_VIEW (self));
+  priv = phoc_view_get_instance_private (self);
+
+  return priv->pinned_transform;
+}
