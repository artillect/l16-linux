+/**
+ * phoc_xdg_toplevel_set_bounds:
+ * @self: The toplevel
+ * @width: The width
+ * @height: The height
+ *
+ * Tell the client the size it should keep within (xdg_toplevel.configure_bounds), for
+ * clients that bind a version that knows it. Without bounds, GTK keeps a window within
+ * its monitor's size, which a view pinned to the other orientation is bigger than.
+ */
+void
+phoc_xdg_toplevel_set_bounds (PhocXdgToplevel *self, int width, int height)
+{
+  g_assert (PHOC_IS_XDG_TOPLEVEL (self));
+
+  if (!self->xdg_toplevel->base->initialized ||
+      wl_resource_get_version (self->xdg_toplevel->resource) <
+      XDG_TOPLEVEL_CONFIGURE_BOUNDS_SINCE_VERSION)
+    return;
+
+  wlr_xdg_toplevel_set_bounds (self->xdg_toplevel, width, height);
+}
