# Forked from Alpine (3.24-stable community/phoc) for downstream patches:
# layer-pending-frame-done.patch sends frame callbacks to layer surfaces that owe a
# configure commit, wherever their geometry is (Phosh's home bar vanished for good when a
# rotation landed while it had a frame pending); pinned-orientation.patch keeps an app that
# pins an orientation (X-Phosh-Orientation) in it while the shell rotates;
# draggable-fold-no-slide.patch stops a folded home bar sliding across the screen
# when a rotation changes its margin. pkgrel 100+ keeps it ahead of Alpine's 0.55.1
# builds; a new upstream pkgver replaces it (re-fork then).
# Contributor: Bart Ribbers <bribbers@disroot.org>
# Contributor: Danct12 <danct12@disroot.org>
# Contributor: Clayton Craft <clayton@craftyguy.net>
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
maintainer="team/phosh <newbie13xd@gmail.com>"
pkgname=phoc
pkgver=0.55.1
pkgrel=114
pkgdesc="wlroots based Phone compositor for the Phosh shell"
arch="all"
url="https://gitlab.gnome.org/World/Phosh/phoc"
license="GPL-3.0-only"
depends="
	$pkgname-schemas
	dbus
	gsettings-desktop-schemas
	mutter-schemas
	"
_wlrootsmakedepends="
	eudev-dev
	glslang
	hwdata-dev
	libcap-dev
	libdisplay-info-dev
	libseat-dev
	libxcb-dev
	xcb-util-image-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkeyboard-config-dev
	xwayland-dev
	"
makedepends="
	glib-dev
	gmobile-dev
	gnome-desktop-dev
	json-glib-dev
	libdrm-dev
	libinput-dev
	libxkbcommon-dev
	mesa-dev
	meson
	pixman-dev
	py3-docutils
	wayland-dev
	wayland-protocols
	$_wlrootsmakedepends
	"
checkdepends="xvfb-run"
subpackages="
	$pkgname-dbg
	$pkgname-doc
	$pkgname-lang
	$pkgname-schemas::noarch
	"
options="!check" # Needs fullblown EGL
source="https://sources.phosh.mobi/releases/phoc/phoc-${pkgver/_/.}.tar.xz
	layer-pending-frame-done.patch
	pinned-orientation.patch
	draggable-fold-no-slide.patch
	"
replaces="wlroots-phosh"
builddir="$srcdir/$pkgname-${pkgver/_/.}"

prepare() {
	default_prepare

	patch -Np1 < subprojects/packagefiles/wlroots/0001-Revert-layer-shell-error-on-0-dimension-without-anch.patch \
		-d subprojects/wlroots-0.20.x
}

build() {
	abuild-meson \
		-Db_lto=true \
		-Dembed-wlroots=enabled \
		-Dman=true \
		-Dtests="$(want_check && echo true || echo false)" \
		--default-library=static \
		. output
	meson compile -C output
}

check() {
	xvfb-run -a meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild -C output
	install -Dm755 tools/scale-to-fit \
		-t "$pkgdir"/usr/bin

	# remove unneeded wlroots dev. files
	rm -r "$pkgdir"/usr/include
	rm -r "$pkgdir"/usr/lib/libwlroots-*.a
	rm -r "$pkgdir"/usr/lib/pkgconfig
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}

