+ * 14 bits in and out), every fourth entry and the last, normalised: 129 points for 0..1.
+ */
+static const GLfloat kStockGamma[129] = {
+	0.00000, 0.02716, 0.05378, 0.07984, 0.10529, 0.13013, 0.15431, 0.17793, 0.20088,
+	0.22322, 0.24489, 0.26589, 0.28633, 0.30605, 0.32522, 0.34371, 0.36159, 0.37893,
