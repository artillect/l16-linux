From d53b42e7caa436ed7783a4380e2b1481e49a6a32 Mon Sep 17 00:00:00 2001
From: L16 Linux <oreo4455@gmail.com>
Date: Wed, 30 Sep 2026 15:29:51 -0700
Subject: [PATCH] software_isp: Light L16 stock preview tone: digital gain,
 GTM, gamma

The Light L16's camera ASICs send the preview at analogue gain only and
report a digital boost of up to 4.13x on top. Stock applies it as a
linear ISP digital gain, then Qualcomm's global tone map (GTM, enabled
in its chromatix preview tuning only) and a 512-entry gamma table.

Do the same: the DigitalGain control multiplies the linear image after
the colour matrix, the GTM's key and maximum come from each frame's
luminance histogram with the stock tuning's parameters, and the stock
gamma table replaces the power-law gamma.
---
 .../internal/software_isp/debayer_params.h    |  6 ++
 src/ipa/simple/algorithms/adjust.cpp          | 80 ++++++++++++++++++-
 src/ipa/simple/algorithms/adjust.h            |  1 +
 src/ipa/simple/ipa_context.h                  |  7 ++
 src/libcamera/shaders/bayer_1x_packed.frag    | 32 +++++++-
 src/libcamera/shaders/bayer_unpacked.frag     | 32 +++++++-
 src/libcamera/software_isp/debayer_egl.cpp    | 36 +++++++++
 src/libcamera/software_isp/debayer_egl.h      |  4 +
 8 files changed, 192 insertions(+), 6 deletions(-)

diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 6772b43..3c84c0d 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -25,6 +25,12 @@ struct DebayerParams {
 	float gamma = 1.0;
 	float contrastExp = 1.0;
 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
+	/* digital gain, applied in linear space after the colour matrix */
+	float digitalGain = 1.0;
+	/* global tone map (Qualcomm GTM, as the Light L16's stock preview): key and maximum in
+	 * 14-bit linear units; a key of 0 turns it off */
+	float gtmKey = 0.0;
+	float gtmMax = 16383.0;
 };
 
 } /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/adjust.cpp b/src/ipa/simple/algorithms/adjust.cpp
index 8bf39c4..9f48655 100644
--- a/src/ipa/simple/algorithms/adjust.cpp
+++ b/src/ipa/simple/algorithms/adjust.cpp
@@ -14,6 +14,7 @@
 #include <libcamera/control_ids.h>
 
 #include "libcamera/internal/matrix.h"
+#include "libcamera/internal/software_isp/swisp_stats.h"
 
 namespace libcamera {
 
@@ -30,6 +31,8 @@ int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningDa
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
 		ControlInfo(0.0f, 2.0f, kDefaultContrast);
+	context.ctrlMap[&controls::DigitalGain] =
+		ControlInfo(1.0f, 32.0f, 1.0f);
 	if (context.ccmEnabled)
 		context.ctrlMap[&controls::Saturation] =
 			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
@@ -42,6 +45,8 @@ int Adjust::configure(IPAContext &context,
 	context.activeState.knobs.gamma = kDefaultGamma;
 	context.activeState.knobs.contrast = std::optional<float>();
 	context.activeState.knobs.saturation = std::optional<float>();
+	context.activeState.knobs.digitalGain = 1.0f;
+	context.activeState.gtm.valid = false;
 
 	return 0;
 }
@@ -63,6 +68,10 @@ void Adjust::queueRequest(typename Module::Context &context,
 		LOG(IPASoftAdjust, Debug) << "Setting contrast to " << contrast.value();
 	}
 
+	const auto &digitalGain = controls.get(controls::DigitalGain);
+	if (digitalGain.has_value())
+		context.activeState.knobs.digitalGain = std::clamp(digitalGain.value(), 1.0f, 32.0f);
+
 	const auto &saturation = controls.get(controls::Saturation);
 	if (saturation.has_value()) {
 		context.activeState.knobs.saturation = saturation;
@@ -109,12 +118,75 @@ void Adjust::prepare(IPAContext &context,
 	params->gamma = 1.0 / context.activeState.knobs.gamma;
 	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
 	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+
+	params->digitalGain = context.activeState.knobs.digitalGain;
+	/* before the first statistics: the GTM's default curve (gtm46_calculate_default_cuve) */
+	const auto &gtm = context.activeState.gtm;
+	params->gtmKey = gtm.valid ? gtm.key : 170.06f;
+	params->gtmMax = gtm.valid ? gtm.max : 2863.0f;
+}
+
+/*
+ * The global tone map of the Light L16's stock preview (Qualcomm's GTM, as its chromatix
+ * preview tuning sets it: middle tone 0.14, middle tone weight 3.6, key 64 to 4096,
+ * maximum at least 1024, minimum at most 128, temporal weight 0.92), from the frame's
+ * luminance histogram, after the black level and the digital gain, in 14-bit units.
+ */
+void Adjust::updateGtm(IPAContext &context, const SwIspStats *stats)
+{
+	constexpr float kWhite = 16383.0f;
+	constexpr float kMaxPercentile = 0.99999f, kMinPercentile = 0.00001f;
+	constexpr float kMiddleToneW = 3.6f, kTemporalW = 0.92f;
+
+	const auto &hist = stats->yHistogram;
+	const unsigned int bins = SwIspStats::kYHistogramSize;
+	const float black = context.activeState.blc.level;
+	const float gain = context.activeState.knobs.digitalGain;
+	/* a histogram position (0..bins) in 14-bit linear units, as the shader makes it */
+	auto linear = [&](float pos) {
+		float v = (pos * 256.0f / bins - black) / 255.0f * gain;
+		return std::clamp(v, 0.0f, 1.0f) * kWhite;
+	};
+
+	uint64_t n = 0;
+	for (unsigned int i = 0; i < bins; i++)
+		n += hist[i];
+	if (!n)
+		return;
+
+	/* the percentiles, interpolated within the bins; the log average at the bins' middles */
+	auto percentile = [&](float p) {
+		const float want = p * n;
+		uint64_t cum = 0;
+		for (unsigned int i = 0; i < bins; i++) {
+			if (cum + hist[i] >= want && hist[i])
+				return linear(i + (want - cum) / hist[i]);
+			cum += hist[i];
+		}
+		return linear(bins);
+	};
+	float maxV = std::max(percentile(kMaxPercentile), 1024.0f);
+	float minV = std::min(percentile(kMinPercentile), 128.0f);
+	double logSum = 0.0;
+	for (unsigned int i = 0; i < bins; i++)
+		logSum += hist[i] * std::log(std::max(linear(i + 0.5f), 1.0f));
+	const float logAvg = std::exp(logSum / n);
+	const float range = std::max(maxV - minV, 1024.0f);
+	float key = std::clamp(kMiddleToneW * logAvg * 1024.0f / range, 64.0f, 4096.0f);
+
+	auto &gtm = context.activeState.gtm;
+	if (gtm.valid) {
+		key = key + kTemporalW * (gtm.key - key);
+		maxV = maxV + kTemporalW * (gtm.max - maxV);
+		minV = minV + kTemporalW * (gtm.min - minV);
+	}
+	gtm = { true, key, maxV, minV };
 }
 
-void Adjust::process([[maybe_unused]] IPAContext &context,
+void Adjust::process(IPAContext &context,
 		     [[maybe_unused]] const uint32_t frame,
 		     IPAFrameContext &frameContext,
-		     [[maybe_unused]] const SwIspStats *stats,
+		     const SwIspStats *stats,
 		     ControlList &metadata)
 {
 	const auto &gamma = frameContext.gamma;
@@ -125,6 +197,10 @@ void Adjust::process([[maybe_unused]] IPAContext &context,
 
 	const auto &saturation = frameContext.saturation;
 	metadata.set(controls::Saturation, saturation.value_or(kDefaultSaturation));
+
+	metadata.set(controls::DigitalGain, context.activeState.knobs.digitalGain);
+	if (stats && stats->valid)
+		updateGtm(context, stats);
 }
 
 REGISTER_IPA_ALGORITHM(Adjust, "Adjust")
