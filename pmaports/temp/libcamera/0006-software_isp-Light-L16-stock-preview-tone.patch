From 4b410ae766c48888f53d8c64b6c6b29d3b8a7ff3 Mon Sep 17 00:00:00 2001
From: L16 Linux <oreo4455@gmail.com>
Date: Wed, 30 Sep 2026 16:29:20 -0700
Subject: [PATCH] software_isp: Light L16 stock preview tone: digital gain,
 gamma

The Light L16's camera ASICs send the preview at analogue gain only and
report a digital boost on top, which stock applies as a linear ISP
digital gain, then its 512-entry preview gamma table. (Its global tone
map is programmed flat, gain 1.0 throughout, as its ISP debug log
shows.)

Do the same: the DigitalGain control multiplies the linear image after
the colour matrix, and the stock gamma table replaces the power-law
gamma.
---
 .../internal/software_isp/debayer_params.h    |  2 ++
 src/ipa/simple/algorithms/adjust.cpp          | 13 +++++++-
 src/ipa/simple/ipa_context.h                  |  1 +
 src/libcamera/shaders/bayer_1x_packed.frag    | 15 +++++++--
 src/libcamera/shaders/bayer_unpacked.frag     | 15 +++++++--
 src/libcamera/software_isp/debayer_egl.cpp    | 31 +++++++++++++++++++
 src/libcamera/software_isp/debayer_egl.h      |  2 ++
 7 files changed, 74 insertions(+), 5 deletions(-)

diff --git a/include/libcamera/internal/software_isp/debayer_params.h b/include/libcamera/internal/software_isp/debayer_params.h
index 6772b43..7e0a584 100644
--- a/include/libcamera/internal/software_isp/debayer_params.h
+++ b/include/libcamera/internal/software_isp/debayer_params.h
@@ -25,6 +25,8 @@ struct DebayerParams {
 	float gamma = 1.0;
 	float contrastExp = 1.0;
 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
+	/* digital gain, applied in linear space after the colour matrix */
+	float digitalGain = 1.0;
 };
 
 } /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/adjust.cpp b/src/ipa/simple/algorithms/adjust.cpp
index 8bf39c4..43e48de 100644
--- a/src/ipa/simple/algorithms/adjust.cpp
+++ b/src/ipa/simple/algorithms/adjust.cpp
@@ -30,6 +30,8 @@ int Adjust::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningDa
 		ControlInfo(0.1f, 10.0f, kDefaultGamma);
 	context.ctrlMap[&controls::Contrast] =
 		ControlInfo(0.0f, 2.0f, kDefaultContrast);
+	context.ctrlMap[&controls::DigitalGain] =
+		ControlInfo(1.0f, 32.0f, 1.0f);
 	if (context.ccmEnabled)
 		context.ctrlMap[&controls::Saturation] =
 			ControlInfo(0.0f, 2.0f, kDefaultSaturation);
@@ -42,6 +44,7 @@ int Adjust::configure(IPAContext &context,
 	context.activeState.knobs.gamma = kDefaultGamma;
 	context.activeState.knobs.contrast = std::optional<float>();
 	context.activeState.knobs.saturation = std::optional<float>();
+	context.activeState.knobs.digitalGain = 1.0f;
 
 	return 0;
 }
@@ -63,6 +66,10 @@ void Adjust::queueRequest(typename Module::Context &context,
 		LOG(IPASoftAdjust, Debug) << "Setting contrast to " << contrast.value();
 	}
 
+	const auto &digitalGain = controls.get(controls::DigitalGain);
+	if (digitalGain.has_value())
+		context.activeState.knobs.digitalGain = std::clamp(digitalGain.value(), 1.0f, 32.0f);
+
 	const auto &saturation = controls.get(controls::Saturation);
 	if (saturation.has_value()) {
 		context.activeState.knobs.saturation = saturation;
@@ -109,9 +116,11 @@ void Adjust::prepare(IPAContext &context,
 	params->gamma = 1.0 / context.activeState.knobs.gamma;
 	const float contrast = context.activeState.knobs.contrast.value_or(kDefaultContrast);
 	params->contrastExp = tan(std::clamp(contrast * M_PI_4, 0.0, M_PI_2 - 0.00001));
+
+	params->digitalGain = context.activeState.knobs.digitalGain;
 }
 
-void Adjust::process([[maybe_unused]] IPAContext &context,
+void Adjust::process(IPAContext &context,
 		     [[maybe_unused]] const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     [[maybe_unused]] const SwIspStats *stats,
@@ -125,6 +134,8 @@ void Adjust::process([[maybe_unused]] IPAContext &context,
 
 	const auto &saturation = frameContext.saturation;
 	metadata.set(controls::Saturation, saturation.value_or(kDefaultSaturation));
+
+	metadata.set(controls::DigitalGain, context.activeState.knobs.digitalGain);
 }
 
 REGISTER_IPA_ALGORITHM(Adjust, "Adjust")
diff --git a/src/ipa/simple/ipa_context.h b/src/ipa/simple/ipa_context.h
index 34f7403..d90b6e6 100644
--- a/src/ipa/simple/ipa_context.h
+++ b/src/ipa/simple/ipa_context.h
@@ -60,6 +60,7 @@ struct IPAActiveState {
 		/* 0..2 range, 1.0 = normal */
 		std::optional<float> contrast;
 		std::optional<float> saturation;
+		float digitalGain;
 	} knobs;
 };
 
diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 23747f7..b5dc688 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -69,6 +69,17 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform float digitalGain;
+uniform float stockGamma[129];
+
+/* the stock gamma, interpolated between its points */
+float stock_gamma(float v)
+{
+	float p = clamp(v, 0.0, 1.0) * 128.0;
+	int i = int(min(floor(p), 127.0));
+	return mix(stockGamma[i], stockGamma[i + 1], p - float(i));
+}
+
 
 float apply_contrast(float value)
 {
@@ -275,13 +286,13 @@ void main(void)
 	 * Contrast
 	 * contrastExp 0..2 contrast to 0..infinity; avoid actual infinity at tan(pi/2)
 	 */
-	rgb = clamp(rgb, 0.0, 1.0);
+	rgb = clamp(rgb * digitalGain, 0.0, 1.0);
 	rgb.r = apply_contrast(rgb.r);
 	rgb.g = apply_contrast(rgb.g);
 	rgb.b = apply_contrast(rgb.b);
 
 	/* Apply gamma after colour correction */
-	rgb = pow(rgb, vec3(gamma));
+	rgb = vec3(stock_gamma(rgb.r), stock_gamma(rgb.g), stock_gamma(rgb.b));
 
 #if defined (SWAP_BLUE)
 	gl_FragColor = vec4(rgb.bgr, 1.0);
diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
index 1b85196..3b6ee5a 100644
--- a/src/libcamera/shaders/bayer_unpacked.frag
+++ b/src/libcamera/shaders/bayer_unpacked.frag
@@ -28,6 +28,17 @@ uniform mat3            ccm;
 uniform vec3            blacklevel;
 uniform float           gamma;
 uniform float           contrastExp;
+uniform float digitalGain;
+uniform float stockGamma[129];
+
+/* the stock gamma, interpolated between its points */
+float stock_gamma(float v)
+{
+	float p = clamp(v, 0.0, 1.0) * 128.0;
+	int i = int(min(floor(p), 127.0));
+	return mix(stockGamma[i], stockGamma[i + 1], p - float(i));
+}
+
 
 float apply_contrast(float value)
 {
@@ -177,13 +188,13 @@ void main(void) {
     /*
      * Contrast
      */
-    rgb = clamp(rgb, 0.0, 1.0);
+    rgb = clamp(rgb * digitalGain, 0.0, 1.0);
     rgb.r = apply_contrast(rgb.r);
     rgb.g = apply_contrast(rgb.g);
     rgb.b = apply_contrast(rgb.b);
 
     /* Apply gamma after colour correction */
-    rgb = pow(rgb, vec3(gamma));
+    rgb = vec3(stock_gamma(rgb.r), stock_gamma(rgb.g), stock_gamma(rgb.b));
 
 #if defined (SWAP_BLUE)
     gl_FragColor = vec4(rgb.bgr, 1.0);
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index f4fc2a6..3f241b9 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -93,6 +93,28 @@ int DebayerEGL::getOutputConfig(PixelFormat outputFormat, DebayerOutputConfig &c
 	return -EINVAL;
 }
 
+/*
+ * The Light L16's stock preview gamma (its chromatix preview tuning's 512-entry table,
+ * 14 bits in and out), every fourth entry and the last, normalised: 129 points for 0..1.
+ */
+static const GLfloat kStockGamma[129] = {
+	0.00000, 0.02716, 0.05378, 0.07984, 0.10529, 0.13013, 0.15431, 0.17793, 0.20088,
+	0.22322, 0.24489, 0.26589, 0.28633, 0.30605, 0.32522, 0.34371, 0.36159, 0.37893,
+	0.39559, 0.41177, 0.42727, 0.44229, 0.45681, 0.47073, 0.48422, 0.49716, 0.50967,
+	0.52170, 0.53330, 0.54447, 0.55521, 0.56565, 0.57566, 0.58530, 0.59464, 0.60361,
+	0.61234, 0.62070, 0.62882, 0.63670, 0.64433, 0.65171, 0.65891, 0.66587, 0.67265,
+	0.67924, 0.68565, 0.69188, 0.69798, 0.70390, 0.70976, 0.71544, 0.72099, 0.72648,
+	0.73186, 0.73711, 0.74223, 0.74736, 0.75230, 0.75725, 0.76207, 0.76689, 0.77159,
+	0.77623, 0.78081, 0.78527, 0.78972, 0.79412, 0.79845, 0.80278, 0.80700, 0.81115,
+	0.81524, 0.81932, 0.82335, 0.82726, 0.83117, 0.83501, 0.83886, 0.84258, 0.84624,
+	0.84991, 0.85351, 0.85705, 0.86053, 0.86401, 0.86736, 0.87072, 0.87402, 0.87731,
+	0.88055, 0.88372, 0.88689, 0.89001, 0.89306, 0.89617, 0.89916, 0.90222, 0.90521,
+	0.90820, 0.91119, 0.91412, 0.91711, 0.92004, 0.92303, 0.92602, 0.92901, 0.93200,
+	0.93505, 0.93811, 0.94116, 0.94427, 0.94738, 0.95056, 0.95379, 0.95697, 0.96026,
+	0.96356, 0.96686, 0.97021, 0.97357, 0.97693, 0.98028, 0.98364, 0.98700, 0.99029,
+	0.99359, 0.99683, 1.00000
+};
+
 int DebayerEGL::getShaderVariableLocations(void)
 {
 	attributeVertex_ = glGetAttribLocation(programId_, "vertexIn");
@@ -103,6 +125,8 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	digitalGainUniformDataIn_ = glGetUniformLocation(programId_, "digitalGain");
+	stockGammaUniformDataIn_ = glGetUniformLocation(programId_, "stockGamma");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -492,6 +516,13 @@ void DebayerEGL::setShaderVariableValues(const DebayerParams &params)
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Digital gain and the stock gamma
+	 */
+	glUniform1f(digitalGainUniformDataIn_, params.digitalGain);
+	glUniform1fv(stockGammaUniformDataIn_, 129, kStockGamma);
+	LOG(Debayer, Debug) << " digitalGain " << params.digitalGain;
+
 	return;
 }
 
diff --git a/src/libcamera/software_isp/debayer_egl.h b/src/libcamera/software_isp/debayer_egl.h
index 5a1e4df..c29e174 100644
--- a/src/libcamera/software_isp/debayer_egl.h
+++ b/src/libcamera/software_isp/debayer_egl.h
@@ -101,6 +101,8 @@ private:
 
 	/* Contrast */
 	GLint contrastExpUniformDataIn_;
+	GLint digitalGainUniformDataIn_;
+	GLint stockGammaUniformDataIn_;
 
 	Rectangle window_;
 	std::unique_ptr<SwStatsCpu> stats_;
-- 
2.47.1.windows.1

