diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 23747f7..ddc0caa 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -69,6 +69,32 @@ uniform mat3 ccm;
 uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
+uniform float digitalGain;
+uniform float gtmKey;
+uniform float gtmMax;
+uniform float stockGamma[129];
+
+/* the stock gamma, interpolated between its points */
+float stock_gamma(float v)
+{
+	float p = clamp(v, 0.0, 1.0) * 128.0;
+	int i = int(min(floor(p), 127.0));
+	return mix(stockGamma[i], stockGamma[i + 1], p - float(i));
+}
+
+/*
+ * The global tone map (Qualcomm's GTM, as the Light L16's stock preview): Reinhard's curve
+ * on the luminance, with the frame's key and maximum, in 14-bit units, as a ratio on RGB
+ */
+vec3 apply_gtm(vec3 rgb)
+{
+	float x = max(dot(rgb, vec3(0.299, 0.587, 0.114)) * 16383.0, 1.0);
+	float l = 0.14 * x / gtmKey;
+	float lw = 0.14 * gtmMax / gtmKey;
+	float y = 16383.0 * l * (1.0 + l / (lw * lw)) / (1.0 + l);
+	return rgb * (y / x);
+}
+
 
 float apply_contrast(float value)
 {
@@ -275,13 +301,15 @@ void main(void)
 	 * Contrast
 	 * contrastExp 0..2 contrast to 0..infinity; avoid actual infinity at tan(pi/2)
 	 */
-	rgb = clamp(rgb, 0.0, 1.0);
+	rgb = clamp(rgb * digitalGain, 0.0, 1.0);
+	if (gtmKey > 0.0)
+		rgb = clamp(apply_gtm(rgb), 0.0, 1.0);
 	rgb.r = apply_contrast(rgb.r);
 	rgb.g = apply_contrast(rgb.g);
 	rgb.b = apply_contrast(rgb.b);
 
 	/* Apply gamma after colour correction */
-	rgb = pow(rgb, vec3(gamma));
+	rgb = vec3(stock_gamma(rgb.r), stock_gamma(rgb.g), stock_gamma(rgb.b));
 
 #if defined (SWAP_BLUE)
 	gl_FragColor = vec4(rgb.bgr, 1.0);
