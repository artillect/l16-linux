@@ -60,7 +60,14 @@ struct IPAActiveState {
 		/* 0..2 range, 1.0 = normal */
 		std::optional<float> contrast;
 		std::optional<float> saturation;
+		float digitalGain;
 	} knobs;
+	struct {
+		bool valid;
+		float key;
+		float max;
+		float min;
+	} gtm;
 };
 
