# Forked from Alpine (3.24-stable community/iio-sensor-proxy) for a downstream patch:
# claim-active-sensor-readings.patch sends a client that claims an already running sensor
# its current readings (Phosh, claiming the accelerometer again after Viewfinder's rotation
# lock, otherwise kept the orientation from before it, while light-lfc-rotate held the
# sensor). pkgrel 100+ keeps it ahead of Alpine's 3.9 builds; a new upstream pkgver
# replaces it (re-fork then). With Alpine's OpenRC service, for OpenRC installs
# (community-supported; 0.2.0 on is tested on systemd only).
# Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Maintainer: Natanael Copa <ncopa@alpinelinux.org>
pkgname=iio-sensor-proxy
pkgver=3.9
pkgrel=101
pkgdesc="IIO sensors to D-Bus proxy"
url="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy"
arch="all"
license="GPL-2.0-or-later"
depends="dbus"
makedepends="
	eudev-dev
	glib-dev
	libgudev-dev
	meson
	polkit-dev
	libssc-dev
	"
subpackages="$pkgname-openrc $pkgname-systemd $pkgname-udev $pkgname-dbg"
source="https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/-/archive/$pkgver/iio-sensor-proxy-$pkgver.tar.gz
	iio-sensor-proxy.initd
	claim-active-sensor-readings.patch
	"

build() {
	abuild-meson \
		-Db_lto=true \
		-Dssc-support=enabled \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		. output
	meson compile -C output
}

check() {
	meson test --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output

	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
}
