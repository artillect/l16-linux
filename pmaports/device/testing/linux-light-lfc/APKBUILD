# Maintainer: Riley <oreo4455@gmail.com>
# Kernel config: the config the L16 port was tested with (msm8996-mainline arm64
# defconfig + the L16 fragment); patches: l16-linux kernel/patches (mkpatches.sh)
_flavor="light-lfc"
pkgname=linux-$_flavor
pkgver=6.19.5
pkgrel=105
pkgdesc="Light L16 kernel (msm8996-mainline with L16 patches)"
arch="aarch64"
_carch="arm64"
url="https://gitlab.com/msm8996-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bison
	findutils
	flex
	installkernel
	openssl-dev
	perl
	python3
	zstd
	"

# Source
_tag=v${pkgver//_/-}-msm8996
source="
	linux-$_tag.tar.gz::$url/-/archive/$_tag/linux-$_tag.tar.gz
	config-$_flavor.$arch
	0001-arm64-dts-qcom-add-light-l16.patch
	0002-drm-panel-add-innolux-nt35695-l16.patch
	0003-backlight-add-lm3630-l16.patch
	0004-input-add-l16-touchstrip-and-dw7800.patch
	0005-usb-misc-add-anx7688.patch
	0006-soc-qcom-add-l16-canary.patch
	0007-power-supply-smbchg-l16.patch
	0008-power-supply-qcom-fg-current-sign.patch
	0009-usb-gadget-u-ether-keep-endpoints.patch
	0010-drm-msm-mdp5-first-pairable-mixer.patch
	0011-drm-msm-mdp5-stale-hwpipe.patch
	0012-input-pm8941-pwrkey-abort-suspend.patch
	0013-iio-qcom-smgr-metadata-array.patch
	0014-iio-qcom-smgr-l16-light.patch
	0015-asoc-wcd9335-dec-volume-unmute.patch
	0016-power-reset-reboot-mode-default.patch
	0017-media-i2c-add-light-ccb.patch
	0018-slimbus-qcom-ngd-base-before-add.patch
	0019-tty-serial-msm-fourth-port.patch
	0020-media-qcom-camss-l16-capture.patch
	0021-drm-msm-a5xx-a530-no-preemption.patch
	0022-cpuidle-psci-domain-osi-firmware.patch
	0023-soc-qcom-smp2p-sleepstate.patch
	0024-pci-qcom-power-down-linked.patch
	0025-clk-qcom-smd-rpm-withdraw-unused-handoff.patch
	0026-clk-qcom-gcc-msm8996-mss-gpll0-no-parent.patch
	0027-scsi-ufs-qcom-v2-no-unipro-clock-gating.patch
	"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$CARCH" .config
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" \
		"$pkgdir/boot/vmlinuz"

	install -D "$builddir/include/config/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
}
