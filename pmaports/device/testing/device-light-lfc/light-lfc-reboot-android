#!/bin/sh
# light-lfc-reboot-android: dual boot only; reboot into the stock LightOS. A reboot
# without a reason boots "boot" (Android); light-lfc-bootmode made plain reboots ask
# for "recovery" (Linux) and let the user change that, so undo it for this reboot.
printf normal > /sys/module/reboot_mode/parameters/default_mode || exit 1
# systemd's, or elogind's on OpenRC (community-supported)
if command -v systemctl > /dev/null; then
	systemctl reboot && exit 0
else
	loginctl reboot && exit 0
fi
# refused: plain reboots go to Linux again
printf recovery > /sys/module/reboot_mode/parameters/default_mode
exit 1
