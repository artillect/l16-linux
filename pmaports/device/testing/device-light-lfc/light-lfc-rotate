#!/bin/sh
# light-lfc-rotate: follow the accelerometer on the lock screen and the phrog login
# screen too. Phosh deliberately stops rotating while locked (and the login screen is
# Phosh locked for good); while unlocked it rotates by itself, to the same transforms
# as here, so the two agree. Honours Phosh's rotation lock.
#
# Also covers phrog's startup: it starts locked before it knows the device type,
# takes the L16 for a phone and forces portrait. The orientation is applied again a
# few seconds after start to undo that.
OUTPUT=DSI-1

log() { logger -t light-lfc-rotate "$*"; }

# same mapping as Phosh's rotation manager
transform_for() {
	case "$1" in
	normal) echo normal ;;
	right-up) echo 270 ;;
	bottom-up) echo 180 ;;
	left-up) echo 90 ;;
	esac
}

apply() {
	t=$(transform_for "$1")
	[ -n "$t" ] || return 0
	[ "$(gsettings get org.gnome.settings-daemon.peripherals.touchscreen \
		orientation-lock 2>/dev/null)" = true ] && return 0
	cur=$(wlr-randr 2>/dev/null | sed -n 's/^ *Transform: *//p' | head -1)
	[ "$cur" = "$t" ] && return 0
	log "orientation $1: transform $cur -> $t"
	wlr-randr --output "$OUTPUT" --transform "$t"
}

# current orientation from iio-sensor-proxy (valid while the accelerometer is claimed)
current() {
	gdbus call --system -d net.hadess.SensorProxy -o /net/hadess/SensorProxy \
		-m org.freedesktop.DBus.Properties.Get net.hadess.SensorProxy \
		AccelerometerOrientation 2>/dev/null | sed -n "s/.*'\(.*\)'.*/\1/p"
}

# monitor-sensor claims the accelerometer for as long as it runs and prints the
# current orientation first, then every change
monitor-sensor --accel 2>/dev/null | while read -r line; do
	case "$line" in
	*"Has accelerometer (orientation: "*)
		o=${line#*orientation: }
		o=${o%%,*}
		;;
	*"Accelerometer orientation changed: "*)
		o=${line##*: }
		;;
	*)
		continue
		;;
	esac
	apply "$o"
	# after the first reading, apply the orientation again once phrog/Phosh have
	# finished starting up
	if [ -z "$started" ]; then
		started=1
		( sleep 4; apply "$(current)" ) &
	fi
done
