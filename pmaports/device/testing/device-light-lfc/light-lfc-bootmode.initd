#!/sbin/openrc-run
# OpenRC (community-supported): dual boot or Linux only, see light-lfc-bootmode (start at
# boot, stop when rebooting to Android); before the login screen

name="Light L16 boot mode"
description="Set up reboots and kernel updates for dual boot or a Linux-only install"

depend() {
	after localmount
	before greetd
}

start() {
	ebegin "Checking the Light L16 install mode"
	/usr/libexec/light-lfc-bootmode start
	eend $?
}

stop() {
	/usr/libexec/light-lfc-bootmode stop
}
