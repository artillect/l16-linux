#!/sbin/openrc-run

name="l16-linux package repository"
description="List the l16-linux package repository in /etc/apk/repositories"

# A fresh install's: pmbootstrap rewrites /etc/apk/repositories while building the image,
# after the device package added it (see /usr/libexec/light-lfc-repo)

depend() {
	need localmount
}

start() {
	/usr/libexec/light-lfc-repo
}
