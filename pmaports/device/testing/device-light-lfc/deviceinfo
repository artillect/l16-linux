# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="Light L16"
deviceinfo_manufacturer="Light"
deviceinfo_codename="light-lfc"
deviceinfo_year="2017"
deviceinfo_dtb="qcom/apq8096-light-l16"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_drm="true"
# A camera; "tablet" gives the Phosh behaviour we want (no docked mode without a
# pointer, no portrait lock screen)
deviceinfo_chassis="tablet"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="1920"
deviceinfo_rootfs_image_sector_size="4096"

# Bootloader related
deviceinfo_flash_method="fastboot"
# Dual boot with the stock LightOS: Linux lives in "recovery" (FIH LK boots it on the
# "recovery" reboot reason) and a "linux" partition carved from userdata. Never
# "boot": that is stock Android's kernel.
deviceinfo_flash_fastboot_partition_kernel="recovery"
deviceinfo_flash_fastboot_partition_rootfs="linux"
deviceinfo_flash_sparse="true"
# FIH LK only boots images followed by an AVB 1.0 boot signature (any key); boot-deploy
# cannot append one yet, so a kernel update must not overwrite "recovery" by itself.
deviceinfo_flash_kernel_on_update="false"

# earlycon=l16ram + keep_bootcon: the kernel log goes to stock's pstore console zone
# for the whole boot. A panic resets the board after 5 s (PANIC_TIMEOUT), and stock
# then shows the log in /sys/fs/pstore/console-ramoops.
deviceinfo_kernel_cmdline="earlycon=l16ram,0x91bbe000 keep_bootcon"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x80000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x01000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x00000100"
