# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Riley <oreo4455@gmail.com>
pkgname=device-light-lfc
pkgdesc="Light L16"
pkgver=1
pkgrel=24
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# swclock-offset: the PM8994 RTC is read-only (as on stock);
# shutdown-clear-rtc-wakealarm: the PMIC's RTC alarm can power on a switched-off
# device, and suspend-on-blank arms it;
# reboot-mode: "reboot-mode bootloader" reboots into fastboot;
# openssl, python3: light-lfc-bootsig
depends="
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	linux-light-lfc
	mkbootimg
	msm-firmware-loader
	openssl
	postmarketos-base
	python3
	reboot-mode
	shutdown-clear-rtc-wakealarm
	swclock-offset
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-openrc
	$pkgname-phosh
	"
source="
	50-light-lfc-suspend.rules
	90-device-light-lfc.rules
	90_light-lfc.gschema.override
	HiFi.conf
	L16.conf
	deviceinfo
	initfs-hook.sh
	l16-linux.list
	l16-linux@artillect-6ab9d2e0.rsa.pub
	l16-mics.pa
	light-lfc-bootmode.initd
	light-lfc-bootsig
	light-lfc-chrony.dispatcher
	light-lfc-firmware.initd
	light-lfc-firmware.sh
	light-lfc-led
	light-lfc-led.initd
	light-lfc-android-libs
	light-lfc-android-libs.initd
	light-lfc-strip-volume
	light-lfc-strip-volume.initd
	libcamera-light-ccb.yaml
	light-lfc-camss.conf
	light-lfc-postprocess.sh
	light-lfc-reboot-android
	light-lfc-reboot-android.desktop
	light-lfc-rotate
	light-lfc-rotate.desktop
	light-lfc-suspend-on-blank
	light-lfc-suspend-on-blank.desktop
	logind-light-lfc.conf
	megapixels-light,l16.conf
	modules-initfs
	phoc.ini
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# the user at the device may suspend it even while other sessions (ssh) exist
	install -Dm644 "$srcdir"/50-light-lfc-suspend.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/50-light-lfc-suspend.rules

	# UCM for the "Light L16" card (apq8096 machine driver)
	install -Dm644 "$srcdir"/L16.conf "$srcdir"/HiFi.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/Light/L16
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096
	ln -s ../../Light/L16/L16.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/Light L16.conf"

	# Megapixels (libmegapixels): the light-ccb preview through CAMSS
	install -Dm644 "$srcdir"/megapixels-light,l16.conf \
		"$pkgdir"/usr/share/megapixels/config/light,l16.conf

	# front and rear microphones as separate mono inputs
	install -Dm644 "$srcdir"/l16-mics.pa \
		"$pkgdir"/etc/pulse/default.pa.d/light-lfc-mics.pa

	# No GPU firmware in the initramfs: with pm4/pfp there, the GPU initialises at
	# bind time, before the zap shader (stock system partition, msm-firmware-loader)
	# is reachable, and hw init fails for the whole boot. Without them it initialises
	# on first use, when everything is there.

	# firmware msm-firmware-loader does not find on its own (see the script)
	install -Dm755 "$srcdir"/light-lfc-firmware.sh \
		"$pkgdir"/usr/libexec/light-lfc-firmware

	# the status LED: charging and low battery, as stock
	install -Dm755 "$srcdir"/light-lfc-led \
		"$pkgdir"/usr/libexec/light-lfc-led
	# Light's renderer, Android's runtime and the calibration, from the stock partitions
	install -Dm755 "$srcdir"/light-lfc-android-libs \
		"$pkgdir"/usr/libexec/light-lfc-android-libs

	# the touch strip as volume keys outside the camera app (a uinput device)
	install -Dm755 "$srcdir"/light-lfc-strip-volume \
		"$pkgdir"/usr/libexec/light-lfc-strip-volume

	# libcamera's software ISP for the camera ASICs (no AGC: the ASICs meter)
	install -Dm644 "$srcdir"/libcamera-light-ccb.yaml \
		"$pkgdir"/usr/share/libcamera/ipa/simple/light-ccb.yaml

	# CAMSS: the preview and photo transfers over one CSI-2 link at once
	install -Dm644 "$srcdir"/light-lfc-camss.conf \
		"$pkgdir"/etc/modprobe.d/light-lfc-camss.conf

	# dual boot: "Reboot to Android" (shown by light-lfc-bootmode only when dual booting)
	install -Dm755 "$srcdir"/light-lfc-reboot-android \
		"$pkgdir"/usr/bin/light-lfc-reboot-android
	install -Dm644 "$srcdir"/light-lfc-reboot-android.desktop \
		-t "$pkgdir"/usr/share/applications

	# no RTC to keep time across installs: set the clock as soon as the network is up
	install -Dm755 "$srcdir"/light-lfc-chrony.dispatcher \
		"$pkgdir"/usr/lib/NetworkManager/dispatcher.d/50-light-lfc-chrony

	# boot image signature for FIH's LK (deviceinfo_mkinitfs_postprocess)
	install -Dm755 "$srcdir"/light-lfc-bootsig \
		"$pkgdir"/usr/libexec/light-lfc-bootsig
	install -Dm644 "$srcdir"/light-lfc-postprocess.sh \
		"$pkgdir"/usr/share/light-lfc/postprocess.sh

	# updates: the l16-linux package repository and its signing key
	install -Dm644 "$srcdir"/l16-linux.list \
		-t "$pkgdir"/lib/apk/repositories.d
	install -Dm644 "$srcdir"/l16-linux@artillect-6ab9d2e0.rsa.pub \
		-t "$pkgdir"/etc/apk/keys
}

openrc() {
	# what abuild's default openrc() would set; overriding it drops that
	install_if="openrc $pkgname=$pkgver-r$pkgrel"
	install="$subpkgname.post-install $subpkgname.post-upgrade"
	depends="msm-firmware-loader-openrc"

	install -Dm755 "$srcdir"/light-lfc-firmware.initd \
		"$subpkgdir"/etc/init.d/light-lfc-firmware
	install -Dm755 "$srcdir"/light-lfc-bootmode.initd \
		"$subpkgdir"/etc/init.d/light-lfc-bootmode
	install -Dm755 "$srcdir"/light-lfc-led.initd \
		"$subpkgdir"/etc/init.d/light-lfc-led
	install -Dm755 "$srcdir"/light-lfc-android-libs.initd \
		"$subpkgdir"/etc/init.d/light-lfc-android-libs
	install -Dm755 "$srcdir"/light-lfc-strip-volume.initd \
		"$subpkgdir"/etc/init.d/light-lfc-strip-volume
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"
	replaces="phosh"
	# greetd: the post-install configures its user; light-lfc-rotate: monitor-sensor,
	# wlr-randr
	depends="greetd iio-sensor-proxy wlr-randr"
	install="$subpkgname.post-install $subpkgname.post-upgrade"

	# landscape (kernel panel orientation) at 1.75x; the phrog login screen falls
	# back to this one too
	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/usr/share/phosh/phoc.ini

	# on-screen keyboard on, Suspend in the power menu
	install -Dm644 "$srcdir"/90_light-lfc.gschema.override \
		-t "$subpkgdir"/usr/share/glib-2.0/schemas

	# phone-like sleep: suspend a few seconds after the screen blanks, on battery,
	# in the session and on the login screen
	install -Dm755 "$srcdir"/light-lfc-suspend-on-blank \
		"$subpkgdir"/usr/bin/light-lfc-suspend-on-blank
	install -Dm644 "$srcdir"/light-lfc-suspend-on-blank.desktop \
		-t "$subpkgdir"/etc/xdg/autostart
	install -Dm644 "$srcdir"/light-lfc-suspend-on-blank.desktop \
		-t "$subpkgdir"/usr/share/phrog/autostart
	install -Dm644 "$srcdir"/logind-light-lfc.conf \
		"$subpkgdir"/etc/elogind/logind.conf.d/50-light-lfc.conf

	# rotate the lock and login screens with the accelerometer too (Phosh stops
	# rotating while locked)
	install -Dm755 "$srcdir"/light-lfc-rotate \
		"$subpkgdir"/usr/bin/light-lfc-rotate
	install -Dm644 "$srcdir"/light-lfc-rotate.desktop \
		-t "$subpkgdir"/etc/xdg/autostart
	install -Dm644 "$srcdir"/light-lfc-rotate.desktop \
		-t "$subpkgdir"/usr/share/phrog/autostart
}
