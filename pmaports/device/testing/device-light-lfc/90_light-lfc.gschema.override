# Light L16: the on-screen keyboard is off by default, and Phosh has no Suspend entry
# in its power menu by default (its schema is still sm.puri.phosh)
[org.gnome.desktop.a11y.applications]
screen-keyboard-enabled=true

[sm.puri.phosh]
enable-suspend=true
# a camera's favourites: Viewfinder, Lightbox, the browser (not postmarketos-ui-phosh's phone apps)
favorites=['org.l16linux.Camera.desktop', 'org.l16linux.Gallery.desktop', 'firefox-esr.desktop']

# Phosh's own quick settings plus "Android" (dual boot: reboot to the stock system;
# l16-phosh-plugins, hidden on a Linux-only install)
[sm.puri.phosh.plugins:Phosh]
quick-settings=['wifi-hotspot-quick-setting', 'mobile-data-quick-setting', 'lfc-android-quick-setting']
