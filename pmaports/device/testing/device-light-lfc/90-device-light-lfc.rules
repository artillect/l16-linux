# Light L16

# SLPI accelerometer (BMI160 via qcom_smgr). Relative to the panel's native (portrait)
# orientation, as iio-sensor-proxy/Phosh expect: the camera held upright in landscape reads
# as "right-up", matching the panel rotation. X/Y as the driver's own in_mount_matrix
# (from the sensor registry); Z flipped (lying screen up read face-down with it).
SUBSYSTEM=="iio", ATTR{name}=="qcom-smgr-accel", ENV{ACCEL_MOUNT_MATRIX}="0, -1, 0; -1, 0, 0; 0, 0, -1"

# feedbackd: the L16 vibration motor (DW7800)
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT}=="1", SUBSYSTEMS=="input", ATTRS{name}=="dw7800-haptics", TAG+="uaccess", ENV{FEEDBACKD_TYPE}="vibra"

# L16: light-lfc-suspend-on-blank (running as the logged-in user, group wheel) re-arms the
# RTC alarm when a power-button press lands while a suspend is starting.
ACTION=="add", SUBSYSTEM=="rtc", KERNEL=="rtc0", RUN+="/bin/chgrp wheel /sys%p/wakealarm", RUN+="/bin/chmod g+w /sys%p/wakealarm"

# L16 touchscreen (Synaptics RMI4). In landscape (phoc transform 270) the bottom screen
# edge is raw X = 0, and a swipe from the bezel reports exactly 0, which maps onto the
# output's far boundary: the touch lands on no surface and Phosh's home bar swipe is
# missed. Pull raw X in by 1% so the edge lands a few pixels inside the screen.
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="Synaptics s2726", ENV{LIBINPUT_CALIBRATION_MATRIX}="0.99 0 0.01 0 1 0"

# L16 camera app (l16-camera) and the touch strip volume, as the user (group video): the
# shutter button (gpio-keys: half press KEY_CAMERA_FOCUS, full press KEY_CAMERA) and the
# touch strip
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="gpio-keys", GROUP="video"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Light L16 touch strip", GROUP="video"

# l16-capture (group video): CAMSS's virtual channel and data type parameters, set for the
# ASICs' capture transfers
ACTION=="add", SUBSYSTEM=="module", KERNEL=="qcom_camss", RUN+="/bin/chgrp video /sys/module/qcom_camss/parameters/vc /sys/module/qcom_camss/parameters/dt", RUN+="/bin/chmod g+w /sys/module/qcom_camss/parameters/vc /sys/module/qcom_camss/parameters/dt"

# l16-camera (group video): the SLPI gyroscope (BMI160 via qcom_smgr), read while the preview
# runs to tell when the camera is still (tripod mode); its buffer and scan settings too
SUBSYSTEM=="iio", KERNEL=="iio:device*", ATTR{name}=="qcom-smgr-gyro", GROUP="video", MODE="0660", RUN+="/bin/sh -c 'chgrp video /sys%p/buffer/enable /sys%p/buffer/length /sys%p/scan_elements/*_en && chmod g+w /sys%p/buffer/enable /sys%p/buffer/length /sys%p/scan_elements/*_en'"
