# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Riley <oreo4455@gmail.com>
pkgname=device-light-l16
pkgdesc="Light L16"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	linux-light-l16
	mkbootimg
	postmarketos-base
	"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-phosh
	"
source="
	50-light-l16-suspend.rules
	90-device-light-l16.rules
	HiFi.conf
	L16.conf
	deviceinfo
	initfs-hook.sh
	l16-mics.pa
	modules-initfs
	phoc.ini
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# the user at the device may suspend it even while other sessions (ssh) exist
	install -Dm644 "$srcdir"/50-light-l16-suspend.rules \
		"$pkgdir"/usr/share/polkit-1/rules.d/50-light-l16-suspend.rules

	# UCM for the "Light L16" card (apq8096 machine driver)
	install -Dm644 "$srcdir"/L16.conf "$srcdir"/HiFi.conf \
		-t "$pkgdir"/usr/share/alsa/ucm2/Light/L16
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096
	ln -s ../../Light/L16/L16.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/Light L16.conf"

	# front and rear microphones as separate mono inputs
	install -Dm644 "$srcdir"/l16-mics.pa \
		"$pkgdir"/etc/pulse/default.pa.d/light-l16-mics.pa
}

phosh() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-phosh"

	install -Dm644 "$srcdir"/phoc.ini \
		"$subpkgdir"/usr/share/phosh/phoc.ini
}
