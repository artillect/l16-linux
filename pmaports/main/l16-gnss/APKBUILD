# Maintainer: Riley <oreo4455@gmail.com>
# The Light L16's GNSS for geoclue: the modem DSP's receiver (QMI LOC over QRTR) served as
# NMEA on a socket geoclue reads, running only while something wants a location. From this
# repository (pmaports/sync.sh packs l16-gnss/ into $pkgname-src.tar.gz here).
pkgname=l16-gnss
pkgver=0.1.0
pkgrel=6
pkgdesc="Light L16 GNSS for geoclue"
url="https://github.com/artillect/l16-linux"
arch="noarch"
license="MIT"
depends="geoclue libqmi libqrtr-glib py3-gobject3 python3 rmtfs"
depends_systemd="rmtfs-systemd"
subpackages="$pkgname-systemd"
options="!check"
source="$pkgname-src.tar.gz"
builddir="$srcdir/l16-gnss"

package() {
	install -Dm755 l16-gnss -t "$pkgdir"/usr/bin
	install -Dm644 90-l16-gnss.conf -t "$pkgdir"/etc/geoclue/conf.d
	install -dm755 "$pkgdir"/var/lib/l16-gnss

	install -Dm644 l16-gnss.service -t "$pkgdir"/usr/lib/systemd/system
	# enabled as it's installed (postmarketos-base-systemd's trigger applies presets)
	install -Dm644 80-l16-gnss.preset -t "$pkgdir"/usr/lib/systemd/system-preset
}
sha512sums="
ad7531e2a4562312eb8e1dfe022eae228d2bee285633dab6762a456705504ed4b0d9e2c6f17a72df0aef18879ea7a93780aafb22aeeedfaf08c7c3d82157ddc8  l16-gnss-src.tar.gz
"
