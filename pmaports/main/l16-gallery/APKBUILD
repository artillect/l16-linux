# Maintainer: Riley <oreo4455@gmail.com>
# The L16's gallery: its photos by day, a quick look at each, and Light's own processing
# (l16-render). From this repository (pmaports/sync.sh packs l16-gallery/, with the icons
# and LRI reader it shares with l16-camera and glycin-lri, into $pkgname-src.tar.gz here).
pkgname=l16-gallery
pkgver=0.1.0
pkgrel=9
pkgdesc="Gallery for the Light L16's photos"
url="https://github.com/artillect/l16-linux"
arch="aarch64"
license="MIT AND CC-BY-4.0"
depends="
	font-nerd-fonts-symbols
	glycin-lri
	l16-render
	"
makedepends="cargo cargo-auditable gtk4.0-dev"
options="net !check"	# net: cargo fetches the crates in prepare()
source="$pkgname-src.tar.gz"
builddir="$srcdir/$pkgname"

# pmbootstrap sets RUSTC_WRAPPER=/usr/bin/sccache on native builds without installing it
unset RUSTC_WRAPPER

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

package() {
	install -Dm755 target/release/l16-gallery "$pkgdir"/usr/bin/l16-gallery
	install -Dm644 org.l16linux.Gallery.desktop "$pkgdir"/usr/share/applications/org.l16linux.Gallery.desktop
	install -Dm644 l16-gallery.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/l16-gallery.svg
	# place names for geotagged photos (tools/make-places: GeoNames, CC BY 4.0)
	install -d "$pkgdir"/usr/share/l16-gallery
	gunzip -c places.tsv.gz > "$pkgdir"/usr/share/l16-gallery/places.tsv
}
sha512sums="
d8584d210861f16c72983668535ce206d7e2fcf77707b1794804ea0815e3f6f83cd75e59573cecb1487fbdcb4bd5ba5c4cf11228f2a164baee2555e6582d1f85  l16-gallery-src.tar.gz
"
