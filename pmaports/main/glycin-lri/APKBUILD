# Maintainer: Riley <oreo4455@gmail.com>
# LRI files (Light L16 photos) as images everywhere: a glycin loader (Loupe, thumbnails in
# file managers and choosers), the file type, and Loupe as their default viewer. From this
# repository (pmaports/sync.sh packs glycin-lri/ into $pkgname-src.tar.gz here).
pkgname=glycin-lri
pkgver=0.1.0
pkgrel=1
pkgdesc="Light L16 LRI photos in image viewers and file managers"
url="https://github.com/artillect/l16-linux"
arch="aarch64"
license="MIT"
depends="glycin-thumbnailer shared-mime-info"
makedepends="cargo cargo-auditable libseccomp-dev"
options="net !check"	# net: cargo fetches the crates in prepare()
source="$pkgname-src.tar.gz"
builddir="$srcdir/$pkgname"

# pmbootstrap sets RUSTC_WRAPPER=/usr/bin/sccache on native builds without installing it
unset RUSTC_WRAPPER

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release --bin glycin-lri
}

package() {
	install -Dm755 target/release/glycin-lri "$pkgdir"/usr/libexec/glycin-loaders/2+/glycin-lri
	install -Dm644 data/glycin-lri.conf "$pkgdir"/usr/share/glycin-loaders/2+/conf.d/glycin-lri.conf
	install -Dm644 data/glycin-lri.thumbnailer "$pkgdir"/usr/share/thumbnailers/glycin-lri.thumbnailer
	install -Dm644 data/light-lri.xml "$pkgdir"/usr/share/mime/packages/light-lri.xml
	# Loupe opens them (its own entry lists only the types it knows)
	install -Dm644 data/phosh-mimeapps.list "$pkgdir"/usr/share/applications/phosh-mimeapps.list
}
sha512sums="
bb2567cbea55aed38406e064cfacbe1e1b6e4f8d47f1c814a110776e8d2f90c7b2acb6c9f04b34a465ed37258cdc0e7c855314a9142cc112d24a1fa3709a8348  glycin-lri-src.tar.gz
"
