# Maintainer: Riley <oreo4455@gmail.com>
# l16-render: LRIs rendered by Light's own renderer (libcp), which runs from the camera's
# stock partitions (light-lfc-android-libs gathers it at boot; nothing of Light's is in
# this package). The program is an Android one, built with the NDK outside pmbootstrap
# (l16-render/build.sh; CI builds it first); pmaports/sync.sh packs l16-render/ with that
# build into $pkgname-src.tar.gz here.
pkgname=l16-render
pkgver=0.1.0
pkgrel=1
pkgdesc="Light L16 photos rendered by Light's own renderer, from the stock partitions"
url="https://github.com/artillect/l16-linux"
arch="aarch64"
license="MIT"
depends="device-light-lfc python3"
# an Android (bionic) program: left as the NDK built it, and its libraries (bionic's, Light's)
# come from the stock partitions, not packages
options="!check !strip !tracedeps"
source="$pkgname-src.tar.gz"
builddir="$srcdir/$pkgname"

package() {
	install -Dm755 build/l16-render "$pkgdir"/usr/libexec/l16-render
	install -Dm755 l16-render.sh "$pkgdir"/usr/bin/l16-render
	install -Dm755 l16-render-orient "$pkgdir"/usr/libexec/l16-render-orient
}
sha512sums="
c0f179e065d962b45695cf47aa776e8f5da35dc103f16ebe60735a1cc9b2ffa8953c2039ea80e36d54c2a6b8a0e9b95346f2ebd4fab6ea521ee67375f52be2db  l16-render-src.tar.gz
"
