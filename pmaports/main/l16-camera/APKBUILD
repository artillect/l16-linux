# Maintainer: Riley <oreo4455@gmail.com>
# The L16 camera app and the photo tools it runs, from this repository (pmaports/sync.sh
# packs l16-camera/ and the tools into $pkgname-src.tar.gz here).
pkgname=l16-camera
pkgver=0.1.0
pkgrel=21
pkgdesc="Camera app for the Light L16, after OpenLight's layout"
url="https://github.com/artillect/l16-linux"
arch="aarch64"
license="MIT"
depends="
	font-nerd-fonts-symbols
	gst-plugins-base
	gst-plugins-rs-gtk4
	libcamera-gstreamer
	python3
	v4l-utils
	"
makedepends="cargo cargo-auditable gtk4.0-dev gstreamer-dev"
options="net !check"	# net: cargo fetches the crates in prepare()
source="$pkgname-src.tar.gz"
builddir="$srcdir/$pkgname"

# pmbootstrap sets RUSTC_WRAPPER=/usr/bin/sccache on native builds without installing it
unset RUSTC_WRAPPER

prepare() {
	default_prepare
	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
}

package() {
	install -Dm755 target/release/l16-camera "$pkgdir"/usr/bin/l16-camera
	install -Dm755 tools/l16-shoot "$pkgdir"/usr/bin/l16-shoot
	install -Dm755 tools/l16-lri-assemble "$pkgdir"/usr/bin/l16-lri-assemble
	install -Dm644 org.l16linux.Camera.desktop "$pkgdir"/usr/share/applications/org.l16linux.Camera.desktop
	# (GNOME Software lists it as an app only with its metainfo)
	install -Dm644 org.l16linux.Camera.metainfo.xml -t "$pkgdir"/usr/share/metainfo
	# and as a catalog entry, with its package: Software searches catalogs, and only
	# Alpine's repositories get one (alpine-appstream-downloader)
	install -d "$pkgdir"/usr/share/swcatalog/xml
	{
		echo '<?xml version="1.0" encoding="UTF-8"?>'
		echo '<components version="1.0" origin="l16-linux">'
		sed -e '1d' -e '/^<!--/d' \
			-e "/<\/component>/i\\  <pkgname>$pkgname</pkgname>" \
			-e "/<\/component>/i\\  <icon type=\"stock\">l16-camera</icon>" \
			org.l16linux.Camera.metainfo.xml
		echo '</components>'
	} > "$pkgdir"/usr/share/swcatalog/xml/org.l16linux.Camera.xml
	install -Dm644 l16-camera.svg "$pkgdir"/usr/share/icons/hicolor/scalable/apps/l16-camera.svg
}
sha512sums="
119cb55f8a62e559c9b76477126db6a6cef000150d5314e7e5457eb919e55a1c3bff025dc59c5582862f0687213dfd39d6e062fede8e9ad696982b98303c54f4  l16-camera-src.tar.gz
"
