From: Riley <oreo4455@gmail.com>
Subject: [PATCH] rotation-manager: landscape for apps that ask for it in their desktop file

X-Phosh-Orientation=landscape in an app's desktop file shows it in landscape while
it's the active app, whatever the sensor and the orientation lock say, as Android's
screenOrientation. The camera app had to take over the orientation lock and the
output transform for this, behind Phosh's back.
---
diff --git a/src/rotation-manager.c b/src/rotation-manager.c
index 403e267..edf482b 100644
--- a/src/rotation-manager.c
+++ b/src/rotation-manager.c
@@ -11,10 +11,16 @@
 #include "rotation-manager.h"
 #include "shell-priv.h"
 #include "sensor-proxy-manager.h"
+#include "toplevel.h"
+#include "toplevel-manager.h"
 #include "util.h"
 
 #define ORIENTATION_LOCK_SCHEMA_ID "org.gnome.settings-daemon.peripherals.touchscreen"
 #define ORIENTATION_LOCK_KEY       "orientation-lock"
+/* An app whose desktop file sets this to "landscape" is shown in landscape while it's
+ * the active app, whatever the sensor or the orientation lock say (as Android's
+ * screenOrientation): a camera app held either way */
+#define APP_ORIENTATION_KEY        "X-Phosh-Orientation"
 
 /**
  * PhoshRotationManager:
@@ -57,6 +63,12 @@ typedef struct _PhoshRotationManager {
   gboolean                 orientation_locked;
 
   PhoshRotationManagerMode mode;
+
+  /* the active app wants landscape (APP_ORIENTATION_KEY) */
+  gboolean                 app_landscape;
+  PhoshMonitorTransform    preapp_transform;
+  char                    *app_id;
+  gboolean                 app_id_landscape;
 } PhoshRotationManager;
 
 G_DEFINE_TYPE (PhoshRotationManager, phosh_rotation_manager, G_TYPE_OBJECT);
@@ -100,6 +112,12 @@ match_orientation (PhoshRotationManager *self)
   const char *orient;
   PhoshMonitorTransform transform;
 
+  if (self->app_landscape &&
+      !phosh_lockscreen_manager_get_locked (self->lockscreen_manager)) {
+    apply_transform (self, PHOSH_MONITOR_TRANSFORM_270);
+    return TRUE;
+  }
+
   if (self->orientation_locked || !self->claimed ||
       phosh_lockscreen_manager_get_locked (self->lockscreen_manager) ||
       self->mode == PHOSH_ROTATION_MANAGER_MODE_OFF)
@@ -456,6 +474,66 @@ phosh_rotation_manager_get_property (GObject    *object,
   }
 }
 
+static gboolean
+app_wants_landscape (PhoshRotationManager *self, PhoshToplevelManager *toplevel_manager)
+{
+  for (guint i = 0; i < phosh_toplevel_manager_get_num_toplevels (toplevel_manager); i++) {
+    PhoshToplevel *toplevel = phosh_toplevel_manager_get_toplevel (toplevel_manager, i);
+    const char *app_id;
+    g_autoptr (GDesktopAppInfo) app_info = NULL;
+    g_autofree char *orientation = NULL;
+
+    if (!phosh_toplevel_is_activated (toplevel))
+      continue;
+
+    app_id = phosh_toplevel_get_app_id (toplevel);
+    if (!app_id)
+      return FALSE;
+
+    /* toplevels change often (titles): look the desktop file up once per app */
+    if (g_strcmp0 (app_id, self->app_id) == 0)
+      return self->app_id_landscape;
+
+    g_free (self->app_id);
+    self->app_id = g_strdup (app_id);
+    app_info = phosh_get_desktop_app_info_for_app_id (app_id);
+    if (app_info)
+      orientation = g_desktop_app_info_get_string (app_info, APP_ORIENTATION_KEY);
+    self->app_id_landscape = g_strcmp0 (orientation, "landscape") == 0;
+    return self->app_id_landscape;
+  }
+
+  return FALSE;
+}
+
+
+static void
+on_toplevels_changed (PhoshRotationManager *self)
+{
+  PhoshToplevelManager *toplevel_manager;
+  gboolean locked, want;
+
+  toplevel_manager = phosh_shell_get_toplevel_manager (phosh_shell_get_default ());
+  want = toplevel_manager && app_wants_landscape (self, toplevel_manager);
+  if (want == self->app_landscape)
+    return;
+
+  g_debug ("Active app %s landscape", want ? "wants" : "no longer wants");
+  locked = phosh_lockscreen_manager_get_locked (self->lockscreen_manager);
+  if (want) {
+    if (self->monitor)
+      self->preapp_transform = phosh_monitor_get_transform (self->monitor);
+    self->app_landscape = TRUE;
+    match_orientation (self);
+  } else {
+    self->app_landscape = FALSE;
+    /* the sensor's orientation, or (lock on) the one from before */
+    if (!match_orientation (self) && !locked)
+      apply_transform (self, self->preapp_transform);
+  }
+}
+
+
 static void
 phosh_rotation_manager_constructed (GObject *object)
 {
@@ -482,6 +560,18 @@ phosh_rotation_manager_constructed (GObject *object)
                            self,
                            G_CONNECT_SWAPPED);
 
+  if (phosh_shell_get_toplevel_manager (phosh_shell_get_default ())) {
+    PhoshToplevelManager *toplevel_manager =
+      phosh_shell_get_toplevel_manager (phosh_shell_get_default ());
+
+    g_signal_connect_object (toplevel_manager, "toplevel-added",
+                             G_CALLBACK (on_toplevels_changed), self, G_CONNECT_SWAPPED);
+    g_signal_connect_object (toplevel_manager, "toplevel-changed",
+                             G_CALLBACK (on_toplevels_changed), self, G_CONNECT_SWAPPED);
+    g_signal_connect_object (toplevel_manager, "notify::num-toplevels",
+                             G_CALLBACK (on_toplevels_changed), self, G_CONNECT_SWAPPED);
+  }
+
   if (!self->sensor_proxy_manager) {
     g_message ("Got no sensor-proxy, no automatic rotation");
     return;
@@ -509,6 +599,7 @@ phosh_rotation_manager_dispose (GObject *object)
   g_clear_object (&self->cancel);
 
   g_clear_object (&self->settings);
+  g_clear_pointer (&self->app_id, g_free);
 
   if (self->sensor_proxy_manager) {
     g_signal_handlers_disconnect_by_data (self->sensor_proxy_manager,
