From: Riley <oreo4455@gmail.com>
Subject: [PATCH] backlight: add LM3630 as programmed by the Light L16

---
diff --git a/drivers/video/backlight/Kconfig b/drivers/video/backlight/Kconfig
index a1422ddd1..f8a2f34f1 100644
--- a/drivers/video/backlight/Kconfig
+++ b/drivers/video/backlight/Kconfig
@@ -393,6 +393,13 @@ config BACKLIGHT_LM3509
 	help
 	  This supports TI LM3509 Backlight Driver
 
+config BACKLIGHT_LM3630_L16
+	tristate "TI LM3630 backlight of the Light L16 (stock register values)"
+	depends on I2C
+	select REGMAP_I2C
+	help
+	  LM3630 programmed exactly as the Light L16 stock kernel does.
+
 config BACKLIGHT_LM3630A
 	tristate "Backlight Driver for LM3630A"
 	depends on I2C && PWM
diff --git a/drivers/video/backlight/Makefile b/drivers/video/backlight/Makefile
index a5d62b018..487a292e3 100644
--- a/drivers/video/backlight/Makefile
+++ b/drivers/video/backlight/Makefile
@@ -41,6 +41,7 @@ obj-$(CONFIG_BACKLIGHT_KTZ8866)		+= ktz8866.o
 obj-$(CONFIG_BACKLIGHT_LM3509)		+= lm3509_bl.o
 obj-$(CONFIG_BACKLIGHT_LM3533)		+= lm3533_bl.o
 obj-$(CONFIG_BACKLIGHT_LM3630A)		+= lm3630a_bl.o
+obj-$(CONFIG_BACKLIGHT_LM3630_L16)	+= lm3630_bl.o
 obj-$(CONFIG_BACKLIGHT_LM3639)		+= lm3639_bl.o
 obj-$(CONFIG_BACKLIGHT_LOCOMO)		+= locomolcd.o
 obj-$(CONFIG_BACKLIGHT_LP855X)		+= lp855x_bl.o
diff --git a/drivers/video/backlight/lm3630_bl.c b/drivers/video/backlight/lm3630_bl.c
new file mode 100755
index 000000000..4e8aa104f
--- /dev/null
+++ b/drivers/video/backlight/lm3630_bl.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * TI LM3630 LCD backlight driver for the Light L16.
+ *
+ * Mainline port of the stock LFC (FIH) driver (reconstructed in the L16 3.18 tree).
+ * The chip is programmed exactly as stock does: the DT's def_* values are written in
+ * stock's order at probe, and brightness goes through stock's set-level sequence.
+ * Mainline's lm3630a driver is not used because it programs different values
+ * (e.g. LED A full-scale current 0x1f instead of the L16's 0x15).
+ *
+ * Stock MDSS called lm3630_lcd_backlight_set_level() directly; here the same path
+ * sits behind a backlight class device, with stock MDSS's level clamping.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+#define REG_CTRL		0x00
+#define REG_CONFIG		0x01
+#define REG_BOOST_CTRL		0x02
+#define REG_BRT_A		0x03
+#define REG_CURRENT_A		0x05
+#define REG_FILTER_STR		0x50
+#define REG_MAX			REG_FILTER_STR
+
+#define CTRL_SLEEP		0x80
+#define CTRL_BANK_ENABLE	0x15
+
+struct lm3630_chip {
+	struct device *dev;
+	struct regmap *regmap;
+	struct gpio_desc *hwen;
+	u32 def_ctrl, def_config, def_boost_ctrl, def_brt, def_current, def_filter_str;
+	u32 max_brt_led;
+};
+
+static const struct regmap_config lm3630_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = REG_MAX,
+};
+
+/* stock retries every access up to 4 times, 10 ms apart */
+static int reg_write(struct lm3630_chip *pchip, unsigned int reg, unsigned int val)
+{
+	int ret, retry = 0;
+
+	do {
+		ret = regmap_write(pchip->regmap, reg, val);
+		if (ret < 0) {
+			retry++;
+			dev_err(pchip->dev, "write fail, reg=%d, val=0x%X\n", reg, val);
+			msleep(10);
+		}
+	} while (retry < 4 && ret < 0);
+
+	return ret;
+}
+
+/* read-modify-write of REG_CTRL, same retries */
+static int reg_update_ctrl(struct lm3630_chip *pchip, unsigned int mask, unsigned int val)
+{
+	int ret, retry = 0;
+
+	do {
+		ret = regmap_update_bits(pchip->regmap, REG_CTRL, mask, val);
+		if (ret < 0) {
+			retry++;
+			dev_err(pchip->dev, "ctrl update fail, mask=0x%X, val=0x%X\n", mask, val);
+			msleep(10);
+		}
+	} while (retry < 4 && ret < 0);
+
+	return ret;
+}
+
+/* stock lm3630_lcd_backlight_set_level() */
+static int lm3630_set_level(struct lm3630_chip *pchip, int level, int enable)
+{
+	int ret;
+
+	if (!enable)
+		return reg_update_ctrl(pchip, 0xff, CTRL_SLEEP);
+
+	ret = reg_update_ctrl(pchip, CTRL_SLEEP, 0);
+	if (ret < 0)
+		return ret;
+	msleep(1);
+	if (level > pchip->max_brt_led)
+		level = pchip->max_brt_led;
+	ret = reg_write(pchip, REG_BRT_A, level);
+	if (ret < 0)
+		return ret;
+	return reg_update_ctrl(pchip, 0x1f, CTRL_BANK_ENABLE);
+}
+
+static int lm3630_update_status(struct backlight_device *bl)
+{
+	struct lm3630_chip *pchip = bl_get_data(bl);
+	int level = backlight_get_brightness(bl);
+
+	/* stock MDSS bl_i2c_lm3630 case: levels 1..5 become 6, cap at 255 */
+	if (level > 0 && level < 6)
+		level = 6;
+	if (level > 255)
+		level = 255;
+
+	return lm3630_set_level(pchip, level, level != 0);
+}
+
+static const struct backlight_ops lm3630_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = lm3630_update_status,
+};
+
+/* stock lm3630_chip_init(): same registers, same order */
+static int lm3630_chip_init(struct lm3630_chip *pchip)
+{
+	int ret;
+
+	ret = reg_write(pchip, REG_FILTER_STR, pchip->def_filter_str);
+	if (!ret)
+		ret = reg_write(pchip, REG_CONFIG, pchip->def_config);
+	if (!ret)
+		ret = reg_write(pchip, REG_BOOST_CTRL, pchip->def_boost_ctrl);
+	if (!ret)
+		ret = reg_write(pchip, REG_CURRENT_A, pchip->def_current);
+	if (!ret)
+		ret = reg_write(pchip, REG_CTRL, pchip->def_ctrl);
+	if (!ret)
+		ret = reg_write(pchip, REG_BRT_A, pchip->def_brt);
+	return ret;
+}
+
+static int lm3630_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct backlight_properties props = {};
+	struct backlight_device *bl;
+	struct lm3630_chip *pchip;
+	int ret;
+
+	pchip = devm_kzalloc(dev, sizeof(*pchip), GFP_KERNEL);
+	if (!pchip)
+		return -ENOMEM;
+	pchip->dev = dev;
+
+	/* all required, as in stock */
+	if (of_property_read_u32(dev->of_node, "ti,max-brt-led", &pchip->max_brt_led) ||
+	    of_property_read_u32(dev->of_node, "def_ctrl", &pchip->def_ctrl) ||
+	    of_property_read_u32(dev->of_node, "def_config", &pchip->def_config) ||
+	    of_property_read_u32(dev->of_node, "def_boost_ctrl", &pchip->def_boost_ctrl) ||
+	    of_property_read_u32(dev->of_node, "def_brt", &pchip->def_brt) ||
+	    of_property_read_u32(dev->of_node, "def_current", &pchip->def_current) ||
+	    of_property_read_u32(dev->of_node, "def_filter_str", &pchip->def_filter_str))
+		return dev_err_probe(dev, -EINVAL, "missing stock def_* / ti,max-brt-led properties\n");
+	pchip->max_brt_led &= 0xff;
+
+	pchip->hwen = devm_gpiod_get(dev, "ti,hwen", GPIOD_OUT_HIGH);
+	if (IS_ERR(pchip->hwen))
+		return dev_err_probe(dev, PTR_ERR(pchip->hwen), "hwen gpio\n");
+	mdelay(50);
+
+	pchip->regmap = devm_regmap_init_i2c(client, &lm3630_regmap);
+	if (IS_ERR(pchip->regmap))
+		return dev_err_probe(dev, PTR_ERR(pchip->regmap), "regmap\n");
+
+	ret = lm3630_chip_init(pchip);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "chip init failed\n");
+
+	props.type = BACKLIGHT_RAW;
+	props.max_brightness = pchip->max_brt_led;
+	props.brightness = pchip->def_brt;
+	bl = devm_backlight_device_register(dev, "lm3630", dev, pchip, &lm3630_bl_ops, &props);
+	if (IS_ERR(bl))
+		return dev_err_probe(dev, PTR_ERR(bl), "backlight register\n");
+
+	i2c_set_clientdata(client, pchip);
+	dev_info(dev, "LM3630 backlight register OK.\n");
+	return 0;
+}
+
+/* stock shutdown: backlight off */
+static void lm3630_shutdown(struct i2c_client *client)
+{
+	struct lm3630_chip *pchip = i2c_get_clientdata(client);
+
+	if (pchip)
+		lm3630_set_level(pchip, 0, 0);
+}
+
+static const struct of_device_id lm3630_match_table[] = {
+	{ .compatible = "ti,lm3630" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lm3630_match_table);
+
+static struct i2c_driver lm3630_i2c_driver = {
+	.driver = {
+		.name = "lm3630_bl",
+		.of_match_table = lm3630_match_table,
+	},
+	.probe = lm3630_probe,
+	.shutdown = lm3630_shutdown,
+};
+module_i2c_driver(lm3630_i2c_driver);
+
+MODULE_DESCRIPTION("TI LM3630 LCD backlight driver (Light L16)");
+MODULE_LICENSE("GPL v2");
