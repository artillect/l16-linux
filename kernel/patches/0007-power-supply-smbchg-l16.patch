From: Riley <oreo4455@gmail.com>
Subject: [PATCH] power: supply: qcom-smbchg: input current cap and JEITA settings

---
diff --git a/drivers/power/supply/qcom-smbchg.c b/drivers/power/supply/qcom-smbchg.c
index 6ea17bceb..36cce33f4 100644
--- a/drivers/power/supply/qcom-smbchg.c
+++ b/drivers/power/supply/qcom-smbchg.c
@@ -430,6 +430,9 @@ static int smbchg_usb_aicl_enable(struct smbchg_chip *chip)
 	ret = qcom_pmic_sec_masked_write(chip->regmap,
 					 chip->base + SMBCHG_USB_CHGPTH_IL_CFG,
 					 USBIN_INPUT_MASK,
+					 chip->ilim_max_ua ?
+					 find_closest_smaller(chip->ilim_max_ua, chip->data->ilim_table,
+							      (unsigned int)chip->data->ilim_table_len) :
 					 chip->data->ilim_table_len - 1);
 	if (ret) {
 		dev_err(chip->dev, "Failed to set current limit index: %pe\n",
@@ -942,6 +945,10 @@ static irqreturn_t smbchg_handle_usb_source_detect(int irq, void *data)
 
 	usb_type = smbchg_usb_get_type(chip);
 
+	/* L16: SDP gets the USB 2.0 configured current in low-current mode */
+	if (usb_present && usb_type == POWER_SUPPLY_USB_TYPE_SDP)
+		smbchg_usb_set_ilim_lc(chip, 500000);
+
 	/*
 	 * Prepare for running AICL to find a suitable input current
 	 * limit if connected to a DCP or a CDP
@@ -1425,6 +1432,29 @@ static int smbchg_init(struct smbchg_chip *chip)
 		}
 	}
 
+	/* L16: soft-JEITA charge current (FCC_CMP_CFG), PMI8996 only */
+	if (chip->data == &smbchg_pmi8996_data) {
+		static const int fcc_comp_ua[] = { 250000, 1100000, 1200000, 1500000 };
+		u32 comp;
+		int i;
+
+		if (!device_property_read_u32(chip->dev, "qcom,fastchg-current-comp-microamp",
+					      &comp)) {
+			for (i = 0; i < ARRAY_SIZE(fcc_comp_ua); i++)
+				if (fcc_comp_ua[i] == comp)
+					break;
+			if (i == ARRAY_SIZE(fcc_comp_ua))
+				return dev_err_probe(chip->dev, -EINVAL,
+						     "unsupported fastchg current comp %u\n", comp);
+			ret = qcom_pmic_sec_masked_write(chip->regmap,
+							 chip->base + SMBCHG_CHGR_FCC_CMP_CFG,
+							 0x3, i);
+			if (ret)
+				return ret;
+			dev_info(chip->dev, "soft JEITA charge current %u uA\n", comp);
+		}
+	}
+
 	/* Set constant charge current limit */
 	ret = smbchg_charging_set_ilim(
 		chip, chip->batt_info->constant_charge_current_max_ua);
@@ -1513,6 +1543,8 @@ static int smbchg_probe(struct platform_device *pdev)
 		return -ENODEV;
 	}
 
+	device_property_read_u32(chip->dev, "input-current-limit-microamp",
+				 (u32 *)&chip->ilim_max_ua);
 	ret = device_property_read_u32(chip->dev, "reg", &chip->base);
 	if (ret) {
 		dev_err(chip->dev, "Failed to get base address: %pe\n",
diff --git a/drivers/power/supply/qcom-smbchg.h b/drivers/power/supply/qcom-smbchg.h
index 06445e10b..b0eb1d1d9 100644
--- a/drivers/power/supply/qcom-smbchg.h
+++ b/drivers/power/supply/qcom-smbchg.h
@@ -239,6 +239,7 @@ struct smbchg_chip {
 	struct regmap *regmap;
 
 	struct power_supply_battery_info *batt_info;
+	int ilim_max_ua;
 	struct power_supply *usb_psy;
 
 	struct regulator_desc otg_rdesc;
