From: Riley <oreo4455@gmail.com>
Subject: [PATCH] slimbus: qcom-ngd-ctrl: set the NGD base before adding its device; wait longer for the QMI service

---
diff --git a/drivers/slimbus/qcom-ngd-ctrl.c b/drivers/slimbus/qcom-ngd-ctrl.c
index a4c0e74..09b2d97 100644
--- a/drivers/slimbus/qcom-ngd-ctrl.c
+++ b/drivers/slimbus/qcom-ngd-ctrl.c
@@ -1453,9 +1453,10 @@ static void qcom_slim_ngd_up_worker(struct work_struct *work)
 
 	ctrl = container_of(work, struct qcom_slim_ngd_ctrl, ngd_up_work);
 
-	/* Make sure qmi service is up before continuing */
+	/* Make sure qmi service is up before continuing: the ADSP announces it 1.2-1.6 s after
+	 * it boots on the L16, and 1 s missed it on 2 of 3 boots (no sound card) */
 	if (!wait_for_completion_interruptible_timeout(&ctrl->qmi_up,
-						       msecs_to_jiffies(MSEC_PER_SEC))) {
+						       msecs_to_jiffies(10 * MSEC_PER_SEC))) {
 		dev_err(ctrl->dev, "QMI wait timeout\n");
 		return;
 	}
@@ -1550,6 +1551,12 @@ static int of_qcom_slim_ngd_register(struct device *parent,
 			return ret;
 		}
 		ngd->pdev->dev.of_node = node;
+		/*
+		 * Set the base before adding the device: its probe starts the QMI
+		 * lookup, and the up worker can power the NGD up before we return.
+		 */
+		ngd->base = ctrl->base + ngd->id * data->offset +
+					(ngd->id - 1) * data->size;
 		ctrl->ngd = ngd;
 
 		ret = platform_device_add(ngd->pdev);
@@ -1559,8 +1566,6 @@ static int of_qcom_slim_ngd_register(struct device *parent,
 			of_node_put(node);
 			return ret;
 		}
-		ngd->base = ctrl->base + ngd->id * data->offset +
-					(ngd->id - 1) * data->size;
 
 		return 0;
 	}
