+static void anx7688_cc_detect_result(void)
+{
+	unchar cc_status = ReadReg(OHIO_CC_STATUS) & 0x0f;
+
+	if (cc_status == 0x05) {
+		pr_info("%s %s: Debug accessory mode\n", LOG_TAG, "");
+		WriteReg(0x42, 0x61);
+		WriteReg(0x46, 0x80);
+	} else {
+		pr_info("%s %s: CC status=0x%2x\n", LOG_TAG, "", cc_status);
+	}
+}
