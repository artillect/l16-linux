From: Riley <oreo4455@gmail.com>
Subject: [PATCH] arm64: dts: qcom: add Light L16

---
diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 821146b2a..5d43ea50e 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -365,3 +365,4 @@ x1p42100-hp-omnibook-x14-el2-dtbs := x1p42100-hp-omnibook-x14.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-hp-omnibook-x14.dtb x1p42100-hp-omnibook-x14-el2.dtb
 x1p42100-lenovo-thinkbook-16-el2-dtbs	:= x1p42100-lenovo-thinkbook-16.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1p42100-lenovo-thinkbook-16.dtb x1p42100-lenovo-thinkbook-16-el2.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= apq8096-light-l16.dtb
diff --git a/arch/arm64/boot/dts/qcom/apq8096-light-l16.dts b/arch/arm64/boot/dts/qcom/apq8096-light-l16.dts
new file mode 100644
index 000000000..5248fdcb4
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/apq8096-light-l16.dts
@@ -0,0 +1,1235 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Light L16 camera (APQ8096 v3.1 + PM8994 + PMI8996), board "LFC P2 PVT".
+ *
+ * Board devices are brought up one at a time with the stock kernel's values (noted
+ * next to each). The early console writes into the stock ramoops region, so the
+ * stock kernel can read our log after a warm reset.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,wcd9335.h>
+#include "msm8996.dtsi"
+#include "pm8994.dtsi"
+#include "pmi8994.dtsi"
+#include "pmi8996.dtsi"
+
+/ {
+	model = "Light L16";
+	compatible = "light,l16", "qcom,apq8096";
+	chassis-type = "embedded";
+
+	/* Matched by the stock LK against its DT table */
+	qcom,msm-id = <0x123 0x30001>;
+	qcom,board-id = <0x1 0x0 0x1000001 0x0>;
+	qcom,pmic-id = <0x20009 0x10013 0x0 0x0>;
+	/* FIH's LK also matches on this (project 7, rev 4 = P2 PVT, variant 1) */
+	fih,hwid = <7 4 1>;
+
+	chosen { };
+
+	/*
+	 * Buttons, stock gpio_keys: PM8994 GPIOs 2/4/5, active low, 15 ms debounce, wakeup.
+	 * Stock sends 0x2FE (a Light-specific code) for the full shutter press; use the
+	 * standard KEY_CAMERA here. Half press is KEY_CAMERA_FOCUS as in stock.
+	 */
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_keys_default>;
+
+		button-volume-up {
+			label = "volume_up";
+			gpios = <&pm8994_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_VOLUMEUP>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+
+		button-camera-snapshot {
+			label = "cam_snapshot";
+			gpios = <&pm8994_gpios 4 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_CAMERA>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+
+		button-camera-focus {
+			label = "cam_focus";
+			gpios = <&pm8994_gpios 5 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_CAMERA_FOCUS>;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+	};
+
+	/*
+	 * QCA6174 main power: stock rome_vreg, a regulator-fixed switched by PM8994 GPIO 9
+	 * (active high). Stock powers it 12 ms before raising wlan-en (cnss_pci.c:
+	 * POWER_ON_DELAY + WLAN_BOOTSTRAP_DELAY); keep it on, as mainline's Xiaomi MSM8996
+	 * boards do for the same chip, so it is up well before wlan_en.
+	 */
+	rome_vreg: rome-vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "rome_vreg";
+		gpio = <&pm8994_gpios 9 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_rome_vreg_default>;
+		regulator-always-on;
+	};
+
+	/*
+	 * QCA6174 enable: stock cnss wlan-en-gpio = PM8994 GPIO 8. Modelled like db820c
+	 * (same chip on PCIe0, same enable pin): a switch that PCIe0 turns on, with its
+	 * 70 ms card startup delay. Powered from rome_vreg.
+	 */
+	wlan_en: wlan-en-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "wlan_en";
+		gpio = <&pm8994_gpios 8 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <70000>;
+		vin-supply = <&rome_vreg>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_wlan_en_default>, <&l16_wlan_sleep_clk_default>;
+	};
+
+	/*
+	 * 32 kHz sleep clock for the QCA6174 (Wi-Fi and Bluetooth), routed out on PM8994
+	 * GPIO 16 func2 as stock does; like db820c's divclk4 (its GPIO 18). The pin state
+	 * is applied by wlan_en: fixed-clock nodes are set up early, not as devices, so
+	 * a pinctrl here would not be applied.
+	 */
+	sleep_clk_32k: sleep-clk-32k {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <32768>;
+		clock-output-names = "l16_sleep_clk";
+	};
+
+	/* WCD9335 MCLK: PM8994 GPIO 15 clock output (stock audio_ext_clk), as on DB820c */
+	div1_mclk: divclk1 {
+		compatible = "gpio-gate-clock";
+		pinctrl-0 = <&audio_mclk>;
+		pinctrl-names = "default";
+		clocks = <&rpmcc RPM_SMD_DIV_CLK1>;
+		#clock-cells = <0>;
+		enable-gpios = <&pm8994_gpios 15 0>;
+	};
+
+	/*
+	 * Speaker amplifier on the codec's LINEOUT1, enabled by PMI8994 GPIO 2 (stock
+	 * qcom,ext-spk-amp-gpio "ext_speaker_amp_gpio", driven high while playing).
+	 */
+	speaker_amp: audio-amplifier {
+		compatible = "simple-audio-amplifier";
+		enable-gpios = <&pmi8994_gpios 2 GPIO_ACTIVE_HIGH>;
+		sound-name-prefix = "Speaker Amp";
+	};
+
+	/* battery system rail (stock "vph_pwr"), feeds the PMI8994 SMPS */
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * Battery, as the stock kernel runs it (live values read from stock's
+	 * battery/bms power supplies; battery profile "lfc_p2_4120mah"):
+	 *   VOLTAGE_MAX_DESIGN          4400000 uV  (profile qcom,max-voltage-uv 0x432380;
+	 *                                            overrides the charger node's 4350 mV)
+	 *   CONSTANT_CHARGE_CURRENT_MAX 3000000 uA  (qcom,fastchg-current-ma 0xBB8 = 3000 mA)
+	 *   termination current         100 mA      (qcom,iterm-ma 0x64)
+	 *   nominal capacity            4120 mAh    (qcom,nom-batt-capacity-mah 0x1018)
+	 *   VOLTAGE_MIN_DESIGN          3400000 uV  (qpnp-fg qcom,fg-cutoff-voltage-mv 0xD48)
+	 * JEITA, stock qpnp-fg node (decidegC): cool-bat 0x32 = 5.0 C (soft cold),
+	 * warm-bat 0x1C2 = 45.0 C (soft hot), cold-bat 0x0 = 0.0 C (hard cold),
+	 * hot-bat 0x258 = 60.0 C (hard hot). These properties are whole degrees C.
+	 */
+	battery: battery {
+		compatible = "simple-battery";
+		voltage-max-design-microvolt = <4400000>;
+		voltage-min-design-microvolt = <3400000>;
+		constant-charge-current-max-microamp = <3000000>;
+		charge-term-current-microamp = <100000>;
+		charge-full-design-microamp-hours = <4120000>;
+		alert-celsius = <5 45>;
+		operating-range-celsius = <0 60>;
+	};
+
+	/* LK fills in RAM by looking up "/memory" by exact path */
+	/delete-node/ memory@80000000;
+
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x0>;
+	};
+
+	reserved-memory {
+		/* MDSS continuous splash; the panel is still scanned out from here */
+		cont_splash_mem: memory@83400000 {
+			reg = <0x0 0x83400000 0x0 0x2400000>;
+			no-map;
+		};
+
+		/*
+		 * Stock kernel's ramoops region. Reserved only: mainline's ramoops
+		 * driver hangs the boot when it probes here (probe #2), and the
+		 * l16ram early console already writes our log into this region.
+		 */
+		pstore_mem: memory@91b00000 {
+			reg = <0x0 0x91b00000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* FIH region, reserved no-map by the stock tree */
+		fih_mem: memory@91c00000 {
+			reg = <0x0 0x91c00000 0x0 0x100000>;
+			no-map;
+		};
+	};
+};
+
+/*
+ * RPM regulators used by the devices brought up so far. Values are the stock
+ * tree's, which are also in microvolts there (min = max = qcom,init-voltage):
+ *   pm8994_l12: 0x1B7740 = 1800000 uV
+ *   pm8994_l24: 0x2EEBB8 = 3075000 uV
+ */
+&rpm_requests {
+	regulators {
+		compatible = "qcom,rpm-pm8994-regulators";
+		/* LVS1/LVS2 are switches fed from S4 */
+		vdd_lvs1_2-supply = <&vreg_s4a_1p8>;
+
+		/*
+		 * UFS vccq2: stock pm8994_s4, 0x1B7740 = 1800000 uV. Main 1.8 V I/O rail, so
+		 * always-on (as mainline's OnePlus 3 does): never let late cleanup drop it.
+		 */
+		vreg_s4a_1p8: s4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
+		/*
+		 * Wi-Fi/BT (QCA6174) rails, stock cnss/bt_qca6174 supplies. Stock enables them
+		 * whenever WLAN is up; ath10k does not manage extra rails, so keep them on.
+		 * vdd-wlan-core: pm8994_s3, 0x13D620 = 1300000 uV.
+		 */
+		vreg_s3a_1p3: s3 {
+			regulator-name = "vreg_s3a_1p3";
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+			regulator-always-on;
+		};
+
+		/* DSI vdda: stock mdss_dsi@0 vdda-supply = pm8994_l2, 0x1312D0 = 1250000 uV */
+		vreg_l2a_1p25: l2 {
+			regulator-name = "vreg_l2a_1p25";
+			regulator-min-microvolt = <1250000>;
+			regulator-max-microvolt = <1250000>;
+		};
+
+		vreg_l12a_1p8: l12 {
+			regulator-name = "vreg_l12a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		/* TMP112 temperature sensors vdd: stock pm8994_l13, 0x1B7740 = 1800000 uV */
+		vreg_l13a_1p8: l13 {
+			regulator-name = "vreg_l13a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		/* touchscreen vdd: stock pm8994_l14, 0x1B7740 = 1800000 uV */
+		vreg_l14a_1p8: l14 {
+			regulator-name = "vreg_l14a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		/* UFS vcc: stock pm8994_l20, 0x2D0370 = 2950000 uV */
+		vreg_l20a_2p95: l20 {
+			regulator-name = "vreg_l20a_2p95";
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2950000>;
+			regulator-allow-set-load;
+		};
+
+		/*
+		 * Wi-Fi antenna switch: stock pm8994_l18_pin_ctrl, init 0x2932E0 = 2700000 uV
+		 * (range to 0x2C4020 = 2900000); its pin control only picks the power mode.
+		 */
+		vreg_l18a_2p7: l18 {
+			regulator-name = "vreg_l18a_2p7";
+			regulator-min-microvolt = <2700000>;
+			regulator-max-microvolt = <2700000>;
+			regulator-always-on;
+		};
+
+		/* touchscreen avdd: stock pm8994_l22, 0x2DC6C0 = 3000000 uV */
+		vreg_l22a_3p0: l22 {
+			regulator-name = "vreg_l22a_3p0";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
+		vreg_l24a_3p075: l24 {
+			regulator-name = "vreg_l24a_3p075";
+			regulator-min-microvolt = <3075000>;
+			regulator-max-microvolt = <3075000>;
+		};
+
+		/*
+		 * UFS vccq: stock pm8994_l25, 0x124F80 = 1200000 uV. Also the ANX7688's
+		 * HSUSB supply in stock's tree, so always-on like mainline's OnePlus 3.
+		 */
+		vreg_l25a_1p2: l25 {
+			regulator-name = "vreg_l25a_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-allow-set-load;
+			regulator-always-on;
+		};
+
+		/* Wi-Fi/BT crystal: stock vdd-wlan-xtal = pm8994_l30, 0x1B7740 = 1800000 uV */
+		vreg_l30a_1p8: l30 {
+			regulator-name = "vreg_l30a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+			regulator-always-on;
+		};
+
+		/*
+		 * 1.8 V switch off S4: stock pm8994_lvs1 is regulator-always-on. Supplies the
+		 * tca9545a I2C mux and the camera modules' I/O, and the blsp1 I2C5 (TMP112)
+		 * pull-ups: without it every transfer on that bus fails with -EIO.
+		 */
+		vreg_lvs1a_1p8: lvs1 {
+			regulator-name = "vreg_lvs1a_1p8";
+			regulator-always-on;
+		};
+
+		/*
+		 * 1.8 V switch off S4: stock SLPI (sensor DSP) vdd_px, kept on after boot
+		 * (stock qcom,keep-proxy-regs-on; stock shows it enabled, 1 user). The SLPI is
+		 * its only user here, so without always-on it goes off at remoteproc handover
+		 * and the SLPI watchdogs ~2 s later.
+		 */
+		vreg_lvs2a_1p8: lvs2 {
+			regulator-name = "vreg_lvs2a_1p8";
+			regulator-always-on;
+		};
+
+		/* DSI PHY vcca: stock mdss_dsi@0 vcca-supply = pm8994_l28, 0xE1D48 = 925000 uV */
+		vreg_l28a_0p925: l28 {
+			regulator-name = "vreg_l28a_0p925";
+			regulator-min-microvolt = <925000>;
+			regulator-max-microvolt = <925000>;
+		};
+	};
+};
+
+/*
+ * USB2 PHY (stock qusb@7411000). Stock vdda18 = pm8994_l12, vdda33 = pm8994_l24.
+ * Stock vdd is pm8994_s2_corner, a CX voltage-corner rail whose "microvolt"
+ * properties are corner numbers (1..7), not volts; it is left out here so the
+ * driver uses a dummy supply and CX is not touched.
+ */
+&hsusb_phy1 {
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+	vdda-phy-dpdm-supply = <&vreg_l24a_3p075>;
+	status = "okay";
+};
+
+/*
+ * Charger. Stock caps USB input at qcom,usb-psy-ma 0x7D0 = 2000 mA; upstream
+ * lets AICL go to the top of the table (3 A), so cap it (L16 driver patch).
+ */
+&pmi8996_smbchg {
+	monitored-battery = <&battery>;
+	input-current-limit-microamp = <2000000>;
+	/* stock qcom,fastchg-current-comp 0x4B0 = 1200 mA: charge current in the soft JEITA zones */
+	qcom,fastchg-current-comp-microamp = <1200000>;
+	status = "okay";
+};
+
+&pmi8996_fg {
+	monitored-battery = <&battery>;
+	status = "okay";
+};
+
+/*
+ * PM8994: only the PON block (power key; its reboot-mode values mode-recovery = 1 and
+ * mode-bootloader = 2 match the reasons FIH's LK reads), RTC and GPIO/MPP (read-only at
+ * probe) are used. The temperature alarm driver reprograms the PMIC over-temperature
+ * thresholds, and the SPMI regulators/ADC are not needed: keep those off.
+ */
+&pm8994_temp {
+	status = "disabled";
+};
+
+&pm8994_vadc {
+	status = "disabled";
+};
+
+&pm8994_spmi_regulators {
+	status = "disabled";
+};
+
+/*
+ * GPU rail: stock pmi8994_s2 (qpnp-regulator@1700, 400-1015 mV), set per GPU corner by
+ * stock's CPR3 gfx_corner controller. Its voltage ceilings are 960 mV at 560 MHz and
+ * 1015 mV at 624 MHz. Mainline has no GFX CPR, so hold it fixed. At db820c's 980 mV the
+ * GPU's cold power-up (boot, every resume) intermittently hung the whole SoC; hold it at
+ * stock's maximum of 1015 mV instead (as mainline's Sony Xperia MSM8996 boards do "to
+ * avoid random crashes"). The 624 MHz step stays dropped for now. The other PMI8994
+ * SPMI regulators have no node here, so the regulator core leaves them alone.
+ */
+&pmi8994_spmi_regulators {
+	vdd_s2-supply = <&vph_pwr>;
+
+	vdd_gfx: s2 {
+		regulator-name = "vdd_gfx";
+		regulator-min-microvolt = <1015000>;
+		regulator-max-microvolt = <1015000>;
+		/*
+		 * Keep the rail up across system suspend. Otherwise the GPU GX GDSC is the
+		 * rail's only user, so suspend switched S2 off and every resume was a cold
+		 * GPU power-up, which intermittently hung the whole SoC (every ~10 cycles;
+		 * 30/30 without GPU use, 60/60 with this). The GDSC still power-collapses
+		 * the GPU as during normal idle.
+		 */
+		regulator-always-on;
+	};
+};
+
+&mmcc {
+	vdd-gfx-supply = <&vdd_gfx>;
+};
+
+/* Adreno 530: pm4/pfp/gpmu and the signed zap shader come from stock /system/etc/firmware */
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/apq8096/l16/a530_zap.mdt";
+};
+
+&gpu_opp_table {
+	/delete-node/ opp-624000000;
+};
+
+/*
+ * SLPI sensor DSP: BMI160 accel/gyro, BMM150 magnetometer and stk3x1x light/proximity
+ * sit on its own I2C (stock Android reads them through sensors.ssc.so). Firmware from
+ * the stock modem partition (image/slpi.*), vdd_px as stock pm8994_lvs2; the sensor
+ * registry (stock /persist/sensors/sns.reg) is served by qcom_sns_reg.
+ */
+/* audio DSP (LPASS). Stock boots it before the SLPI. Firmware from stock modem image/adsp.* */
+&adsp_pil {
+	firmware-name = "qcom/apq8096/l16/adsp.mdt";
+	status = "okay";
+};
+
+/*
+ * Audio, as captured from stock (tinymix while playing / recording video):
+ *   speaker  SLIMBUS_0_RX -> SLIM RX0 -> RX INT3 (COMP3) -> LINEOUT1 -> amp (PMI8994 GPIO 2)
+ *   mics     DMIC0 + DMIC2 (stereo) -> DEC8/DEC7 -> SLIM TX8/TX7 -> SLIMBUS_0_TX
+ * WCD9335 v2.0 on SLIMbus as on DB820c: reset GPIO 64, interrupt GPIO 54 (stock
+ * wcd9xxx-irq gpio-connect; no second line), all supplies pm8994 S4 1.8 V.
+ */
+&q6asmdai {
+	dai@0 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+	};
+
+	dai@2 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
+	};
+};
+
+&slim_msm {
+	status = "okay";
+
+	slim@1 {
+		reg = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		tasha_ifd: tas-ifd@0,0 {
+			compatible = "slim217,1a0";
+			reg = <0 0>;
+		};
+
+		wcd9335: codec@1,0 {
+			compatible = "slim217,1a0";
+			reg = <1 0>;
+
+			clock-names = "mclk", "slimbus";
+			clocks = <&div1_mclk>,
+				 <&rpmcc RPM_SMD_BB_CLK1>;
+			interrupt-parent = <&tlmm>;
+			interrupts = <54 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "intr1";
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			pinctrl-0 = <&cdc_reset_active &wcd_intr_default>;
+			pinctrl-names = "default";
+
+			reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
+			slim-ifc-dev = <&tasha_ifd>;
+
+			#sound-dai-cells = <1>;
+
+			vdd-buck-supply = <&vreg_s4a_1p8>;
+			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+			vdd-tx-supply = <&vreg_s4a_1p8>;
+			vdd-rx-supply = <&vreg_s4a_1p8>;
+			vdd-io-supply = <&vreg_s4a_1p8>;
+		};
+	};
+};
+
+&sound {
+	compatible = "qcom,apq8096-sndcard";
+	model = "Light L16";
+	aux-devs = <&speaker_amp>;
+	widgets = "Speaker", "Speaker",
+		  "Microphone", "Digital Mic0",
+		  "Microphone", "Digital Mic2";
+	/*
+	 * DMICs powered from MIC BIAS1 as in the stock routing (DMIC0/DMIC2 <- MIC BIAS1).
+	 * Capture needs the codec MCLK too (stock ANA_BIAS 0x80 / ANA_CLK_TOP 0x84 while
+	 * recording): without the MCLK supply the DMIC clock, decimators and SLIMbus TX
+	 * ports never run and every sample is zero. Only RX_BIAS depended on it before.
+	 */
+	audio-routing = "RX_BIAS", "MCLK",
+			"Speaker Amp INL", "LINEOUT1",
+			"Speaker", "Speaker Amp OUTL",
+			"DMIC0", "MCLK",
