+
+&slpi_pil {
+	firmware-name = "qcom/apq8096/l16/slpi.mdt";
+	px-supply = <&vreg_lvs2a_1p8>;
+	status = "okay";
+};
+
+/*
+ * ANX7688 USB Type-C / PD controller (stock analogix_i2c@50 on i2c@75b6000,
+ * qcom,clk-freq-out 0x61A80 = 400 kHz). TLMM GPIOs as stock, all active high:
+ * p-on 0x3A = 58, reset 0x93 = 147, cbl-det 0x49 = 73, intr-comm 0x7C = 124,
+ * dp-ldo-on 0x92 = 146. The VCONN supply (pmi8994 5 V boost) is left out.
+ */
+&blsp2_i2c2 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	typec@50 {
+		compatible = "analogix,anx7688";
+		reg = <0x50>;
+		analogix,p-on-gpio = <&tlmm 58 GPIO_ACTIVE_HIGH>;
+		analogix,reset-gpio = <&tlmm 147 GPIO_ACTIVE_HIGH>;
+		analogix,cbl-det-gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+		analogix,intr-comm-gpio = <&tlmm 124 GPIO_ACTIVE_HIGH>;
+		analogix,dp-ldo-on-gpio = <&tlmm 146 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/*
+ * Display: Innolux NT35695 1080x1920 command-mode panel on DSI0, 4 lanes.
+ * Panel power is FIH's GPIO-switched +/-5 V bias (qcom,platform-p5-en-gpio 0x7A = 122,
+ * qcom,platform-n5-en-gpio 0x6C = 108) plus qcom,platform-enable-gpio 0x70 = 112;
+ * stock leaves the panel regulators (vddio/lab/ibb) alone on this board.
+ * Reset 0x8 = GPIO 8, TE 0xA = GPIO 10 (mdp_vsync). Pin settings from stock's
+ * msm8996_gpioN_active states.
+ */
+&tlmm {
+	l16_panel_default: l16-panel-default-state {
+		reset-pins {
+			pins = "gpio8";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		power-pins {
+			pins = "gpio108", "gpio112", "gpio122";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		te-pins {
+			pins = "gpio10";
+			function = "mdp_vsync";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+
+	/* blsp1 I2C5 (TMP112s): stock msm8996_gpio83/84_active states */
+	l16_i2c5_default: l16-i2c5-default-state {
+		pins = "gpio83", "gpio84";
+		function = "blsp_i2c5";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/* touchscreen: stock msm8996_gpio21/89/125_active states */
+	l16_touch_default: l16-touch-default-state {
+		enable-pins {
+			pins = "gpio21";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+			output-high;
+		};
+
+		reset-pins {
+			pins = "gpio89";
+			function = "gpio";
+			drive-strength = <16>;
+			output-high;
+		};
+
+		irq-pins {
+			pins = "gpio125";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
+
+/*
+ * Touchscreen: Synaptics S3528T (RMI4) at 0x20 on i2c@75ba000 (stock synaptics@20,
+ * qcom,clk-freq-out 0x61A80 = 400 kHz). IRQ 0x7D = GPIO 125, flags 0x2008 = level low.
+ * Stock avdd = pm8994_l22 3.0 V, vdd = pm8994_l14 1.8 V. Reset 0x59 = GPIO 89 and
+ * GPIO 21 are held high by the pin state as in stock; stock's power-gpio 62 is unused
+ * (synaptics,disable-gpios) and is a camera pin. Stock reports 720x1280, portrait.
+ */
+/*
+ * Camera ASIC control bus (stock "i2c-11", i2c_camera@10). ASIC1 answers at 7-bit 0x08 and
+ * relays to ASIC2/3; a PCA9543 mux sits at 0x70. Stock runs it at 1 MHz. No ASIC driver yet:
+ * userspace talks to it through i2c-dev (tools/l16-asic-probe). The ASICs' SPI (their boot
+ * flash) and debug UARTs stay disabled.
+ */
+&blsp2_i2c5 {
+	clock-frequency = <1000000>;
+	status = "okay";
+
+	/*
+	 * Each ASIC sends RAW10 over its own 4-lane CSI-2 link (stock: CSIPHY/CSID 0, 1, 2).
+	 * CAMSS wants a separate device per link, and which ASIC is on which PHY is not known
+	 * yet: one link is described at a time while finding out.
+	 */
+	camera@8 {
+		compatible = "light,l16-ccb";
+		reg = <0x08>;
+		pinctrl-0 = <&l16_ccb_default>;
+		pinctrl-names = "default";
+
+		/*
+		 * Stock asic_mode_gpio / fw_update.sh: boot straps, both low = boot from the
+		 * ASICs' own flash (high = programming modes; the driver never raises them).
+		 * Enables: ASIC power (stock pwr_en_gpio), then the two resets, raised in order.
+		 */
+		orientation = <1>;	/* back */
+		strap-gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>, <&tlmm 79 GPIO_ACTIVE_HIGH>;
+		enable-gpios = <&tlmm 130 GPIO_ACTIVE_HIGH>, <&tlmm 13 GPIO_ACTIVE_HIGH>,
+			       <&tlmm 128 GPIO_ACTIVE_HIGH>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* ASICn's CSI-2 output goes to CSIPHY n-1 (stock csiphy/csid-sd-index) */
+			port@0 {
+				reg = <0>;
+				ccb_out0: endpoint {
+					data-lanes = <1 2 3 4>;
+					link-frequencies = /bits/ 64 <750000000>;
+					remote-endpoint = <&camss_csiphy0_in>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				ccb_out1: endpoint {
+					data-lanes = <1 2 3 4>;
+					link-frequencies = /bits/ 64 <750000000>;
+					remote-endpoint = <&camss_csiphy1_in>;
+				};
+			};
+
+			port@2 {
+				reg = <2>;
+				ccb_out2: endpoint {
+					data-lanes = <1 2 3 4>;
+					link-frequencies = /bits/ 64 <750000000>;
+					remote-endpoint = <&camss_csiphy2_in>;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * 4 data lanes in order (stock lane_assign 0x4320: physical lanes 0, 2, 3, 4 around the clock
+ * lane 1, which is mainline's data-lanes 0..3 with the clock lane implied).
+ */
+&camss {
+	vdda-supply = <&vreg_l2a_1p25>;
+	status = "okay";
+
+	ports {
+		port@0 {
+			reg = <0>;
+			camss_csiphy0_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ccb_out0>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			camss_csiphy1_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ccb_out1>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;
+			camss_csiphy2_in: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&ccb_out2>;
+			};
+		};
+	};
+};
+
+&blsp2_i2c6 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchscreen@20 {
+		compatible = "syna,rmi4-i2c";
+		reg = <0x20>;
+		interrupts-extended = <&tlmm 125 IRQ_TYPE_LEVEL_LOW>;
+		vdd-supply = <&vreg_l22a_3p0>;
+		vio-supply = <&vreg_l14a_1p8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_touch_default>;
+		syna,startup-delay-ms = <100>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		rmi4-f01@1 {
+			reg = <0x1>;
+			syna,nosleep-mode = <1>;
+		};
+
+		rmi4-f12@12 {
+			reg = <0x12>;
+			syna,sensor-type = <1>;
+		};
+	};
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l2a_1p25>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&l16_panel_default>;
+	status = "okay";
+
+	panel: panel@0 {
+		compatible = "light,l16-innolux-nt35695";
+		/* portrait panel in a landscape camera: Right Side Up (Wayland transform 270) */
+		rotation = <90>;
+		reg = <0>;
+		enable-gpios = <&tlmm 112 GPIO_ACTIVE_HIGH>;
+		p5-gpios = <&tlmm 122 GPIO_ACTIVE_HIGH>;
+		n5-gpios = <&tlmm 108 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&tlmm 8 GPIO_ACTIVE_LOW>;
+		backlight = <&lm3630>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&vreg_l28a_0p925>;
+	status = "okay";
+};
+
+/*
+ * LM3630 backlight: stock lm3630_bl@38 on i2c@7577000 (qcom,clk-freq-out 0x61A80 =
+ * 400 kHz), HWEN ti,hwen-gpio 0x79 = GPIO 121. Register values exactly as stock.
+ */
+&blsp1_i2c3 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	lm3630: backlight@38 {
+		compatible = "ti,lm3630";
+		reg = <0x38>;
+		def_ctrl = <0x15>;
+		def_config = <0x8>;
+		def_boost_ctrl = <0x78>;
+		def_brt = <0x38>;
+		def_current = <0x15>;
+		def_filter_str = <0x3>;
+		ti,max-brt-led = <0xff>;
+		ti,hwen-gpio = <&tlmm 121 GPIO_ACTIVE_HIGH>;
+	};
+
+	/* vibration motor driver (stock "dw,dw7800"; no GPIOs or supplies there) */
+	haptics@59 {
+		compatible = "dongwoon,dw7800";
+		reg = <0x59>;
+	};
+};
+
+/*
+ * UFS (stock ufshc@624000 / ufsphy@627000). Rails and current limits as stock:
+ * vcc L20 2.95 V 0x927C0 = 600000 uA, vccq L25 1.2 V 0x6DDD0 = 450000 uA,
+ * vccq2 S4 1.8 V 450000 uA; PHY vdda-phy L28 0.925 V, vdda-pll L12 1.8 V.
+ * Stock's vdd-hba is the UFS GDSC, which msm8996.dtsi already attaches as a power domain.
+ */
+&ufsphy {
+	vdda-phy-supply = <&vreg_l28a_0p925>;
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+	status = "okay";
+};
+
+&ufshc {
+	vcc-supply = <&vreg_l20a_2p95>;
+	vccq-supply = <&vreg_l25a_1p2>;
+	vccq2-supply = <&vreg_s4a_1p8>;
+	vcc-max-microamp = <600000>;
+	vccq-max-microamp = <450000>;
+	vccq2-max-microamp = <450000>;
+	status = "okay";
+};
+
+/* USB 2.0 device mode only (no SuperSpeed PHY, no Type-C/ANX7688 handling yet) */
+&usb3 {
+	qcom,select-utmi-as-pipe-clk;
+	status = "okay";
+};
+
+&usb3_dwc3 {
+	phys = <&hsusb_phy1>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+	dr_mode = "peripheral";
+};
+
+/*
+ * Button pins, stock qpnp-pin gpio@c100/c300/c400 (GPIO 2/4/5): qcom,mode 0 (digital
+ * input), qcom,pull 0 (30 uA pull-up), qcom,vin-sel 2 (S4, 1.8 V).
+ */
+&pm8994_gpios {
+	audio_mclk: clk-div1-state {
+		pinconf {
+			pins = "gpio15";
+			function = "func1";
+			power-source = <PM8994_GPIO_S4>; /* 1.8V */
+		};
+	};
+
+	l16_keys_default: l16-keys-default-state {
+		pins = "gpio2", "gpio4", "gpio5";
+		function = "normal";
+		input-enable;
+		bias-pull-up;
+		qcom,pull-up-strength = <PMIC_GPIO_PULL_UP_30>;
+		power-source = <PM8994_GPIO_S4>;
+	};
+};
+
+/*
+ * blsp1 I2C5 (stock i2c@7579000: qup irq 0x63 = 99, dmas 0x14/0x15 = 20/21,
+ * qcom,clk-freq-out 0x61A80 = 400 kHz). Not in msm8996.dtsi, so defined here
+ * following its blsp1_i2c3 node.
+ */
+&{/soc@0} {
+	blsp1_i2c5: i2c@7579000 {
+		compatible = "qcom,i2c-qup-v2.2.1";
+		reg = <0x07579000 0x1000>;
+		interrupts = <GIC_SPI 99 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP1_QUP5_I2C_APPS_CLK>,
+			 <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_i2c5_default>;
+		dmas = <&blsp1_dma 20>, <&blsp1_dma 21>;
+		dma-names = "tx", "rx";
+		clock-frequency = <400000>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * TI TMP112 board temperature sensors (stock tmp112@48/4a/4b; stock's @49 is
+		 * not fitted), vdd pm8994_l13. The bus pull-ups need LVS1. The TMP112 is
+		 * register-compatible with the TMP102, which is the only compatible mainline's
+		 * tmp102 driver lists. Stock's pa224@1e ("ch2") on this bus is left out for now.
+		 */
+		temp-sensor@48 {
+			compatible = "ti,tmp102";
+			reg = <0x48>;
+			vcc-supply = <&vreg_l13a_1p8>;
+			#thermal-sensor-cells = <0>;
+		};
+
+		temp-sensor@4a {
+			compatible = "ti,tmp102";
+			reg = <0x4a>;
+			vcc-supply = <&vreg_l13a_1p8>;
+			#thermal-sensor-cells = <0>;
+		};
+
+		temp-sensor@4b {
+			compatible = "ti,tmp102";
+			reg = <0x4b>;
+			vcc-supply = <&vreg_l13a_1p8>;
+			#thermal-sensor-cells = <0>;
+		};
+	};
+};
+
+/* touch strip: stock msm8996_gpio51/52_active use 2 mA (msm8996.dtsi default is 16 mA) */
+&blsp2_i2c3_default {
+	drive-strength = <2>;
+};
+
+/*
+ * Touch strip: Elan eKTF controller at 0x15 on i2c@75b7000 (stock elan@15, driver
+ * elan-ktf, input "elan-touchscreen" with X 0..768 and Y 0..1, a one-dimensional
+ * strip). qcom,clk-freq-out 0x61A80 = 400 kHz. Stock supplies: avdd pm8994_l22
+ * (3.0 V), vdd pm8994_s4 (1.8 V); its bvdd (pm8994_l10) is status "disabled" in stock,
+ * so the strip runs without it. IRQ 0x73 = GPIO 115, flags 0x8 = level low; reset
+ * 0x4C = GPIO 76, which stock's fih-gpio holds high (out of reset), so active low.
+ * It sends Elan 2-finger reports (header 0x5a, 8 bytes), which mainline's elants_i2c
+ * does not parse, and does not answer elants' 6-byte info query; see
+ * overlay/drivers/input/misc/l16-touchstrip.c.
+ */
+&blsp2_i2c3 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	touchstrip@15 {
+		compatible = "light,l16-touchstrip";
+		reg = <0x15>;
+		interrupts-extended = <&tlmm 115 IRQ_TYPE_LEVEL_LOW>;
+		reset-gpios = <&tlmm 76 GPIO_ACTIVE_LOW>;
+		vcc33-supply = <&vreg_l22a_3p0>;
+		vccio-supply = <&vreg_s4a_1p8>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_strip_default>;
+	};
+};
+
+&tlmm {
+	/* touch strip: stock fih-gpio msm8996_gpio115/76_default */
+	l16_strip_default: l16-strip-default-state {
+		irq-pins {
+			pins = "gpio115";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		reset-pins {
+			pins = "gpio76";
+			function = "gpio";
+			drive-strength = <2>;
+			bias-disable;
+		};
+	};
+};
+
+/*
+ * Wi-Fi power pins, stock qpnp-pin gpio@c700 (GPIO 8, wlan-en) and gpio@c800 (GPIO 9,
+ * rome_vreg): qcom,mode 1 (output), CMOS, qcom,vin-sel 2 (S4), qcom,out-strength 2
+ * (medium); GPIO 8 qcom,pull 5 (none), GPIO 9 qcom,pull 4 (10 uA pull-down).
+ */
+&pm8994_gpios {
+	l16_wlan_en_default: l16-wlan-en-default-state {
+		pins = "gpio8";
+		function = "normal";
+		output-low;
+		drive-push-pull;
+		bias-disable;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		power-source = <PM8994_GPIO_S4>;
+	};
+
+	/*
+	 * QCA6174 32 kHz sleep clock: stock gpio@cf00 (GPIO 16) qcom,src-sel 3 (func2),
+	 * qcom,mode 1 (output), CMOS, qcom,pull 5 (none), qcom,vin-sel 2 (S4),
+	 * qcom,out-strength 1 (low). db820c routes the same clock on its GPIO 18 func2.
+	 */
+	l16_wlan_sleep_clk_default: l16-wlan-sleep-clk-default-state {
+		pins = "gpio16";
+		function = PMIC_GPIO_FUNC_FUNC2;
+		drive-push-pull;
+		bias-disable;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+		power-source = <PM8994_GPIO_S4>;
+	};
+
+	l16_rome_vreg_default: l16-rome-vreg-default-state {
+		pins = "gpio9";
+		function = "normal";
+		output-low;
+		drive-push-pull;
+		bias-pull-down;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		power-source = <PM8994_GPIO_S4>;
+	};
+};
+
+&tlmm {
+	/*
+	 * QCA6174 bootstrap: stock cnss_default pins GPIO 46 (16 mA, pull-down) and cnss_pci.c
+	 * drives it high (WLAN_BOOTSTRAP_HIGH) before raising wlan-en.
+	 */
+	l16_wlan_bootstrap_default: l16-wlan-bootstrap-default-state {
+		pins = "gpio46";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-down;
+		output-high;
+	};
+};
+
+/*
+ * PCIe0 with the QCA6174 (stock msm_pcie rc0: perst-gpio 0x23 = GPIO 35, wake-gpio 0x25
+ * = GPIO 37, vreg-0.9 = pm8994_l28 at 925 mV, vreg-1.8 = pm8994_l12).
+ */
+&pcie_phy {
+	vdda-phy-supply = <&vreg_l28a_0p925>;
+	vdda-pll-supply = <&vreg_l12a_1p8>;
+	status = "okay";
+};
+
+&pcie0 {
+	perst-gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+	wake-gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+	vdda-supply = <&vreg_l28a_0p925>;
+	vddpe-3v3-supply = <&wlan_en>;
+	pinctrl-0 = <&pcie0_state_on>, <&l16_wlan_bootstrap_default>;
+	status = "okay";
+};
+
+/*
+ * Bluetooth enable: stock bt_qca6174 qca,bt-reset-gpio = PM8994 GPIO 19; stock gpio@d200:
+ * qcom,mode 1 (output), CMOS, qcom,pull 5 (none), qcom,vin-sel 2 (S4),
+ * qcom,out-strength 2 (medium).
+ */
+&pm8994_gpios {
+	l16_bt_en_default: l16-bt-en-default-state {
+		pins = "gpio19";
+		function = "normal";
+		output-low;
+		drive-push-pull;
+		bias-disable;
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_MED>;
+		power-source = <PM8994_GPIO_S4>;
+	};
+};
+
+/* BT UART: stock msm8996_gpio41..44 states use 2 mA (msm8996.dtsi default is 16 mA) */
+&blsp1_uart2_default {
+	drive-strength = <2>;
+};
+
+/*
+ * Bluetooth: QCA6174 ("ROME" 3.2) on the stock high-speed UART uart@7570000 (blsp1
+ * UART2, GPIO 41-44), as on db820c. Stock supplies (core S3, pa rome_vreg, io S4,
+ * xtal L30) are the Wi-Fi rails, already on. Firmware: stock rampatch_tlv_3.2.tlv and
+ * nvm_tlv_3.2.bin, installed as qca/rampatch_00440302.bin and qca/nvm_00440302.bin.
+ */
+&blsp1_uart2 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "qcom,qca6174-bt";
+		enable-gpios = <&pm8994_gpios 19 GPIO_ACTIVE_HIGH>;
+		clocks = <&sleep_clk_32k>;
+		/*
+		 * The controller keeps the NVM file's default address, so the driver marks it
+		 * unconfigured without one here (FIH's LK does not fill it in). This is this
+		 * unit's stock address (Android settings bluetooth_address 38:45:4C:00:5A:9A),
+		 * little-endian.
+		 */
+		local-bd-address = [ 9a 5a 00 4c 45 38 ];
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_bt_en_default>;
+	};
+};
+
+/*
+ * The camera ASICs' debug UARTs (stock ttyHSL1..3, read by tlogd at 460800 baud). Which
+ * ASIC is on which port is not known yet. Only TX/RX are muxed; the other two pins of each
+ * QUP are its I2C bus (stock: blsp_i2c5/6/12).
+ */
+&soc {
+	l16_asic_uart_a: serial@7573000 {
+		compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
+		reg = <0x07573000 0x1000>;
+		interrupts = <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP1_UART5_APPS_CLK>, <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_asic_uart_a_default>;
+	};
+
+	l16_asic_uart_b: serial@7574000 {
+		compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
+		reg = <0x07574000 0x1000>;
+		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP1_UART6_APPS_CLK>, <&gcc GCC_BLSP1_AHB_CLK>;
+		clock-names = "core", "iface";
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_asic_uart_b_default>;
+	};
+
+	l16_asic_uart_c: serial@75b4000 {
+		compatible = "qcom,msm-uartdm-v1.4", "qcom,msm-uartdm";
+		reg = <0x075b4000 0x1000>;
+		interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_BLSP2_UART6_APPS_CLK>, <&gcc GCC_BLSP2_AHB_CLK>;
+		clock-names = "core", "iface";
+		pinctrl-names = "default";
+		pinctrl-0 = <&l16_asic_uart_c_default>;
+	};
+};
+
+&tlmm {
+	l16_asic_uart_a_default: l16-asic-uart-a-state {
+		pins = "gpio81", "gpio82";
+		function = "blsp_uart5";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	l16_asic_uart_b_default: l16-asic-uart-b-state {
+		pins = "gpio25", "gpio26";
+		function = "blsp_uart6";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	l16_asic_uart_c_default: l16-asic-uart-c-state {
+		pins = "gpio85", "gpio86";
+		function = "blsp_uart12";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/*
+	 * Stock msm8996_gpio40_default: no pull. The line is driven high only weakly; with the
+	 * default pull-down it reads low and ASIC3's camera modules (C1 C3 C4 C6) never deliver
+	 * a frame, so every autofocus involving them times out.
+	 */
+	l16_ccb_default: l16-ccb-default-state {
+		pins = "gpio40";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
