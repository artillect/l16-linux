+static int ccb_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct ccb *c = to_ccb(sd);
+	struct device *dev = &c->client->dev;
+	int ret = 0;
+
+	/*
+	 * With the raw-transfer control set, streams start and stop without touching the
+	 * ASICs: capture transfers (userspace streams virtual channel 1 while the ASICs hold
+	 * the photo; stopping the preview would release it), or l16-capture driving the
+	 * ASICs itself. A preview left running then carries on when streaming resumes.
+	 */
+	bool raw = c->raw_transfer->val;
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret)
+			return ret;
+		mutex_lock(&c->lock);
+		if (!raw) {
+			ret = ccb_ready(c);
+			if (!ret && !c->stream_count && !c->previewing)
+				ret = ccb_preview_start(c);
+		}
+		if (!ret)
+			c->stream_count++;
+		mutex_unlock(&c->lock);
+		if (ret)
+			pm_runtime_put_autosuspend(dev);
+		return ret;
+	}
+
+	mutex_lock(&c->lock);
+	if (c->stream_count && !--c->stream_count && !raw && c->previewing)
+		ret = ccb_preview_stop(c, c->module->val);
+	mutex_unlock(&c->lock);
+	pm_runtime_put_autosuspend(dev);
+	return ret;
+}
+
+/*
+ * With c->lock held, previewing. The sequence of stock's capture (I2C trace, CAPTURE-TRACE.md;
+ * liblight_ccb ccb_capture): precapture metering (auto only), preview off, crop and use case
+ * 5, UUID, burst (0x8010 {05 00 count}; for a burst, the frame rate first: 0x0050 {mask, UCID
+ * 5, 00, fps << 8}), capture start with {11 F1 00} per module; the ASICs' transfer
+ * descriptors (type 8, one set per burst frame) come before the start's reply. Then capture
+ * stop, use case 3, preview on (not waited for), AE unlock.
+ */
+static int ccb_capture(struct ccb *c, struct light_ccb_capture *cap)
+{
+	static const u8 trigger[] = { 0x02 };
+	static const u8 crop5[] = { 0x01, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00, 0x00,
+				    0x40, 0x10, 0x30, 0x0c, 0x01, 0x01 };
+	static const u8 ucid5[] = { 0x05, 0x00 }, ucid3[] = { 0x03, 0x00 };
+	u8 burst[] = { 0x05, 0x00, 0x01 };
+	u8 fps[] = { 0x01, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00 };
+	static const u8 unlock[] = { 0x00 };
+	static const u8 stack_off[] = { 0x00, 0x01 }, stack_on[] = { 0x01, 0x01 };
+	bool restack = false;
+	u8 body[3 + 3 * 16], prev[6], m[CCB_MSG_MAX];
+	unsigned long end;
+	int mod = c->module->cur.val, n = 0, i, t, ret;
+	u16 tid;
+
+	if (!c->previewing)
+		return -EBUSY;
+	cap->mask &= 0x1fffe;
+	for (i = 1; i <= 16; i++)
+		if (cap->mask & BIT(i))
+			n++;
+	if (!n)
+		return -EINVAL;
+	memset(cap->records, 0, sizeof(cap->records));
+	cap->record_bytes = 0;
+
+	if (cap->burst > 31)
+		return -EINVAL;
+	if (c->exp_auto->cur.val != V4L2_EXPOSURE_MANUAL &&
+	    !(cap->flags & LIGHT_CCB_CAPTURE_NO_PRECAPTURE))
+		ccb_send(c, ccb_tid(c, CCB_KIND_CAPTURE), 0x0061, trigger, sizeof(trigger));
+	memcpy(prev, ccb_module_masks[mod], 3);
+	prev[3] = 0x10;
+	prev[4] = prev[5] = 0;
+	ret = ccb_command(c, CCB_KIND_CAPTURE, 0x8002, prev, sizeof(prev));
+	if (ret < 0)
+		return ret;
+	c->previewing = false;
+	if (cap->flags & LIGHT_CCB_CAPTURE_NO_STACK) {
+		ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x006a, stack_off, sizeof(stack_off));
+		restack = c->exp_auto->cur.val != V4L2_EXPOSURE_MANUAL;
+	}
+	ccb_send(c, ccb_tid(c, CCB_KIND_CAPTURE), 0x002e, crop5, sizeof(crop5));
+	ret = ccb_command(c, CCB_KIND_CAPTURE, 0x9000, ucid5, sizeof(ucid5));
+	if (ret >= 0)
+		ret = ccb_command(c, CCB_KIND_CAPTURE, 0x8006, cap->uuid, sizeof(cap->uuid));
+	if (ret >= 0 && cap->burst > 1 && cap->fps) {
+		put_unaligned_le16(cap->fps << 8, fps + 5);
+		ret = ccb_command(c, CCB_KIND_CAPTURE, 0x0050, fps, sizeof(fps));
+	}
+	burst[2] = cap->burst > 1 ? cap->burst : 1;
+	if (ret >= 0)
+		ret = ccb_command(c, CCB_KIND_CAPTURE, 0x8010, burst, sizeof(burst));
+	if (ret < 0)
+		goto preview;
+
+	body[0] = cap->mask;
+	body[1] = cap->mask >> 8;
+	body[2] = cap->mask >> 16;
+	for (i = 0; i < n; i++) {
+		body[3 + 3 * i] = 0x11;
+		body[4 + 3 * i] = 0xf1;
+		body[5 + 3 * i] = 0x00;
+	}
+	tid = ccb_tid(c, CCB_KIND_CAPTURE);
+	ret = ccb_send(c, tid, 0x8002, body, 3 + 3 * n);
+	if (ret)
+		goto preview;
+	/*
+	 * Descriptor payload: tid, burst index, asic (bits 0-3; bit 7 = more follow),
+	 * size shift, record count, then a u16 size per record (in 2^shift bytes)
+	 */
+	ret = -ETIMEDOUT;
+	/* stock: (frame time + exposure) x frames, at least 500 ms; here more room */
+	end = jiffies + msecs_to_jiffies(3000 + 1000 * burst[2]);
+	while (time_before(jiffies, end)) {
+		t = ccb_read(c, m, sizeof(m));
+		if (t == CCB_TYPE_DESCRIPTOR && get_unaligned_le16(m + 2) >= 6) {
+			int asic = m[7] & 0x0f, count = m[9];
+
+			if (debug)
+				dev_info(&c->client->dev, "descriptor %*ph\n",
+					 min_t(int, get_unaligned_le16(m + 2), 24), m + 4);
+
+			if (asic < 3)
+				cap->records[asic] += count;
+			if (count && get_unaligned_le16(m + 2) >= 8 && m[7] & 0x80 &&
+			    !cap->record_bytes)
+				cap->record_bytes = (u32)get_unaligned_le16(m + 10) << m[8];
+		} else if (t == CCB_TYPE_REPLY && get_unaligned_be16(m + 4) == tid) {
+			cap->status = get_unaligned_le16(m + 6);
+			ret = 0;
+			break;
+		} else if (t < 0 || t == CCB_TYPE_EMPTY) {
+			usleep_range(2000, 4000);
+		}
+	}
+	if (ret)
+		dev_err(&c->client->dev, "capture start: %d\n", ret);
+
+	for (i = 0; i < n; i++)
+		body[3 + 3 * i] = 0x10;
+	ccb_command(c, CCB_KIND_CAPTURE, 0x8002, body, 3 + 3 * n);
+preview:
+	/* back to the preview use case, preview on; and the precapture AE lock released */
+	ccb_command(c, CCB_KIND_CAPTURE, 0x9000, ucid3, sizeof(ucid3));
+	prev[3] = 0x11;
+	/* not waited for (~140 ms): the drain worker reads the reply */
+	if (!ccb_send(c, ccb_tid(c, CCB_KIND_CAPTURE), 0x8002, prev, sizeof(prev)))
+		c->previewing = true;
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0061, unlock, sizeof(unlock));
+	if (restack)
+		ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x006a, stack_on, sizeof(stack_on));
+	schedule_delayed_work(&c->drain, msecs_to_jiffies(50));
+	return ret;
+}
+
+/* one record from ASIC @asic over its CSI-2 link: 0x8015 {01 5x 00 00}, x = the ASIC */
+static int ccb_transfer(struct ccb *c, u32 asic)
+{
+	u8 body[] = { 0x01, 0x50 | (asic & 0x0f), 0x00, 0x00 };
+
+	if (asic > 2)
+		return -EINVAL;
+	return ccb_command_wait(c, CCB_KIND_CAPTURE, 0x8015, body, sizeof(body), 3000);
+}
+
+static long ccb_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct ccb *c = to_ccb(sd);
+	struct device *dev = &c->client->dev;
+	struct light_ccb_msg *msg = arg;
+	int ret;
+
+	switch (cmd) {
+	case LIGHT_CCB_IOC_SEND:
+	case LIGHT_CCB_IOC_RECV:
+	case LIGHT_CCB_IOC_RESET:
+		ret = pm_runtime_resume_and_get(dev);
+		if (ret)
+			return ret;
+		mutex_lock(&c->lock);
+		ret = cmd == LIGHT_CCB_IOC_RESET ? 0 : ccb_ready(c);
+		if (ret)
+			;
+		else if (cmd == LIGHT_CCB_IOC_SEND)
+			ret = msg->len >= 4 && msg->len <= CCB_MSG_MAX ?
+			      ccb_write(c, msg->data, msg->len) : -EINVAL;
+		else if (cmd == LIGHT_CCB_IOC_RECV)
+			ret = ccb_read(c, msg->data, sizeof(msg->data));
+		else
+			ret = ccb_boot(c);
+		if (cmd == LIGHT_CCB_IOC_RECV && ret >= 0) {
+			msg->len = get_unaligned_le16(msg->data + 2) + 4;
+			ret = 0;
+		}
+		mutex_unlock(&c->lock);
+		pm_runtime_put_autosuspend(dev);
+		return ret;
+	case LIGHT_CCB_IOC_OFF:
+		mutex_lock(&c->lock);
+		ccb_power_off(c);
+		mutex_unlock(&c->lock);
+		return 0;
+	case LIGHT_CCB_IOC_CAPTURE:
+		mutex_lock(&c->lock);
+		ret = ccb_capture(c, arg);
+		mutex_unlock(&c->lock);
+		return ret;
+	case LIGHT_CCB_IOC_TRANSFER:
+		mutex_lock(&c->lock);
+		ret = c->booted ? ccb_transfer(c, *(u32 *)arg) : -ENODEV;
+		mutex_unlock(&c->lock);
+		return ret < 0 ? ret : 0;
+	}
+	return -ENOIOCTLCMD;
+}
+
+static void ccb_fmt(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = CCB_WIDTH;
+	fmt->height = CCB_HEIGHT;
+	fmt->code = CCB_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+}
+
+static int ccb_init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	unsigned int i;
+
+	for (i = 0; i < CCB_NUM_PADS; i++)
+		ccb_fmt(v4l2_subdev_state_get_format(state, i));
+
+	return 0;
+}
+
+static int ccb_enum_mbus_code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = CCB_CODE;
+	return 0;
+}
+
+static int ccb_enum_frame_size(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != CCB_CODE)
+		return -EINVAL;
+
+	/*
+	 * Only the preview size is listed (what libcamera picks from); set_fmt still takes
+	 * any size, for l16-capture's 1408x9219 capture records.
+	 */
+	fse->min_width = fse->max_width = CCB_WIDTH;
+	fse->min_height = fse->max_height = CCB_HEIGHT;
+	return 0;
+}
+
+/*
+ * The ASIC chooses the frame size itself (2080x1560 preview, 1408x9219 capture records),
+ * so accept the size userspace asks for; only the bus format is fixed.
+ */
+static int ccb_set_fmt(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		       struct v4l2_subdev_format *fmt)
+{
+	u32 width = clamp_t(u32, fmt->format.width, 64, 8192);
+	u32 height = clamp_t(u32, fmt->format.height, 64, 16384);
+	u32 code = fmt->format.code;
+
+	ccb_fmt(&fmt->format);
+	fmt->format.width = width;
+	fmt->format.height = height;
+	/*
+	 * The data is GRBG (all that enum_mbus_code offers), but another Bayer label is kept
+	 * when asked for: Megapixels' debayer reads the pattern one pixel off diagonally on
+	 * this GPU, so its config labels the pipeline GBRG.
+	 */
+	if (code == MEDIA_BUS_FMT_SBGGR10_1X10 || code == MEDIA_BUS_FMT_SGBRG10_1X10 ||
+	    code == MEDIA_BUS_FMT_SRGGB10_1X10)
+		fmt->format.code = code;
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+	return 0;
+}
+
+static int ccb_get_selection(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = CCB_NATIVE_W;
+		sel->r.height = CCB_NATIVE_H;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+static const struct v4l2_subdev_core_ops ccb_core_ops = {
+	.ioctl = ccb_ioctl,
+};
+
+static const struct v4l2_subdev_video_ops ccb_video_ops = {
+	.s_stream = ccb_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops ccb_pad_ops = {
+	.enum_mbus_code = ccb_enum_mbus_code,
+	.enum_frame_size = ccb_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = ccb_set_fmt,
+	.get_selection = ccb_get_selection,
+};
+
+static const struct v4l2_subdev_ops ccb_ops = {
+	.core = &ccb_core_ops,
+	.video = &ccb_video_ops,
+	.pad = &ccb_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops ccb_internal_ops = {
+	.init_state = ccb_init_state,
+};
+
+static const struct media_entity_operations ccb_entity_ops = {
+	.get_fwnode_pad = v4l2_subdev_get_fwnode_pad_1_to_1,
+};
+
+static int ccb_init_controls(struct ccb *c)
+{
+	struct v4l2_ctrl_handler *h = &c->ctrls;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *link_freq, *hblank, *vblank;
+	int ret;
+
+	/* orientation and rotation from the DT, for libcamera */
+	ret = v4l2_fwnode_device_parse(&c->client->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(h, 20);
+	link_freq = v4l2_ctrl_new_int_menu(h, NULL, V4L2_CID_LINK_FREQ, 0, 0, ccb_link_freqs);
+	if (link_freq)
+		link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_std(h, NULL, V4L2_CID_PIXEL_RATE, CCB_PIXEL_RATE, CCB_PIXEL_RATE, 1,
+			  CCB_PIXEL_RATE);
+
+	c->exp_auto = v4l2_ctrl_new_std_menu(h, &ccb_ctrl_ops, V4L2_CID_EXPOSURE_AUTO,
+					     V4L2_EXPOSURE_MANUAL, ~(BIT(V4L2_EXPOSURE_AUTO) |
+					     BIT(V4L2_EXPOSURE_MANUAL)), V4L2_EXPOSURE_AUTO);
+	/* for libcamera, which needs them (in lines, and ISO): stored, not used */
+	v4l2_ctrl_new_std(h, &ccb_ctrl_ops, V4L2_CID_EXPOSURE,
+					1, CCB_MAX_EXPOSURE, 1, CCB_FRAME_LINES / 2);
+	v4l2_ctrl_new_std(h, &ccb_ctrl_ops, V4L2_CID_ANALOGUE_GAIN, 100, 3200, 1, 100);
+	v4l2_ctrl_new_std(h, &ccb_ctrl_ops, V4L2_CID_AUTO_FOCUS_START, 0, 1, 1, 0);
+	hblank = v4l2_ctrl_new_std(h, NULL, V4L2_CID_HBLANK, CCB_HBLANK, CCB_HBLANK, 1, CCB_HBLANK);
+	if (hblank)
+		hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	vblank = v4l2_ctrl_new_std(h, NULL, V4L2_CID_VBLANK, CCB_VBLANK, CCB_VBLANK, 1, CCB_VBLANK);
+	if (vblank)
+		vblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+	v4l2_ctrl_new_fwnode_properties(h, &ccb_ctrl_ops, &props);
+	c->module = v4l2_ctrl_new_custom(h, &ccb_ctrl_module, NULL);
+	c->raw_transfer = v4l2_ctrl_new_custom(h, &ccb_ctrl_raw_transfer, NULL);
+	c->exp_us = v4l2_ctrl_new_custom(h, &ccb_ctrl_exp_us, NULL);
+	c->iso = v4l2_ctrl_new_custom(h, &ccb_ctrl_iso, NULL);
+	c->ae_us = v4l2_ctrl_new_custom(h, &ccb_ctrl_ae_us, NULL);
+	c->ae_iso = v4l2_ctrl_new_custom(h, &ccb_ctrl_ae_iso, NULL);
+	c->focus_x = v4l2_ctrl_new_custom(h, &ccb_ctrl_focus_x, NULL);
+	c->focus_y = v4l2_ctrl_new_custom(h, &ccb_ctrl_focus_y, NULL);
+	c->flash = v4l2_ctrl_new_custom(h, &ccb_ctrl_flash, NULL);
+	if (h->error)
+		return h->error;
+
+	c->sd.ctrl_handler = h;
+	return 0;
+}
+
+static int ccb_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct ccb *c;
+	unsigned int i;
+	int ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->client = client;
+	mutex_init(&c->lock);
+	INIT_DELAYED_WORK(&c->drain, ccb_drain_work);
+	INIT_WORK(&c->af, ccb_af_work);
+	INIT_DELAYED_WORK(&c->ae, ccb_ae_work);
+
+	/* boot straps low = boot from the ASICs' own flash; never driven high */
+	c->straps = devm_gpiod_get_array(dev, "strap", GPIOD_OUT_LOW);
+	if (IS_ERR(c->straps))
+		return dev_err_probe(dev, PTR_ERR(c->straps), "boot straps\n");
+	c->enable = devm_gpiod_get_array(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(c->enable))
+		return dev_err_probe(dev, PTR_ERR(c->enable), "enable gpios\n");
+
+	v4l2_i2c_subdev_init(&c->sd, client, &ccb_ops);
+	c->sd.internal_ops = &ccb_internal_ops;
+	c->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	c->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	c->sd.entity.ops = &ccb_entity_ops;
+
+	for (i = 0; i < CCB_NUM_PADS; i++)
+		c->pads[i].flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&c->sd.entity, CCB_NUM_PADS, c->pads);
+	if (ret)
+		return ret;
+
+	ret = ccb_init_controls(c);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_subdev_init_finalize(&c->sd);
+	if (ret)
+		goto err_ctrls;
+
+	/* the ASICs are off; boot them on first use, power off after a minute idle */
+	pm_runtime_set_suspended(dev);
+	pm_runtime_set_autosuspend_delay(dev, 60000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev(&c->sd);
+	if (ret)
+		goto err_pm;
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	v4l2_subdev_cleanup(&c->sd);
+err_ctrls:
+	v4l2_ctrl_handler_free(&c->ctrls);
+	media_entity_cleanup(&c->sd.entity);
+	return ret;
+}
+
+static void ccb_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct ccb *c = to_ccb(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	v4l2_ctrl_handler_free(&c->ctrls);
+	media_entity_cleanup(&sd->entity);
+	pm_runtime_disable(&client->dev);
+	cancel_delayed_work_sync(&c->drain);
+	cancel_work_sync(&c->af);
+	cancel_delayed_work_sync(&c->ae);
+	ccb_power_off(c);
+}
+
+static const struct dev_pm_ops ccb_pm_ops = {
+	RUNTIME_PM_OPS(ccb_runtime_suspend, ccb_runtime_resume, NULL)
+};
+
+static const struct of_device_id ccb_of_match[] = {
+	{ .compatible = "light,l16-ccb" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ccb_of_match);
+
+static struct i2c_driver ccb_driver = {
+	.driver = {
+		.name = "light-ccb",
+		.of_match_table = ccb_of_match,
+		.pm = pm_ptr(&ccb_pm_ops),
+	},
+	.probe = ccb_probe,
+	.remove = ccb_remove,
+};
+module_i2c_driver(ccb_driver);
+
+MODULE_DESCRIPTION("Light L16 camera ASICs as a CSI-2 source");
