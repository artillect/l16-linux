From: Riley <oreo4455@gmail.com>
Subject: [PATCH] media: i2c: add the Light L16 camera ASICs as a CSI-2 source

---
diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 861e8c41b..2219ac1eb 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -301,6 +301,13 @@ config VIDEO_IMX415
 	  To compile this driver as a module, choose M here: the
 	  module will be called imx415.
 
+config VIDEO_LIGHT_CCB
+	tristate "Light L16 camera ASICs"
+	help
+	  The three camera ASICs of the Light L16 as a CSI-2 source, so that
+	  CAMSS can receive their streams. The ASICs themselves are driven
+	  from userspace for now.
+
 config VIDEO_MAX9271_LIB
 	tristate
 
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index 7e76b7cc4..2e0517f75 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -75,6 +75,7 @@ obj-$(CONFIG_VIDEO_MAX96714) += max96714.o
 obj-$(CONFIG_VIDEO_MAX96717) += max96717.o
 obj-$(CONFIG_VIDEO_ML86V7667) += ml86v7667.o
 obj-$(CONFIG_VIDEO_MSP3400) += msp3400.o
+obj-$(CONFIG_VIDEO_LIGHT_CCB) += light-ccb.o
 obj-$(CONFIG_VIDEO_MT9M001) += mt9m001.o
 obj-$(CONFIG_VIDEO_MT9M111) += mt9m111.o
 obj-$(CONFIG_VIDEO_MT9M114) += mt9m114.o
diff --git a/drivers/media/i2c/light-ccb.c b/drivers/media/i2c/light-ccb.c
new file mode 100644
index 000000000..59b2f1c68
--- /dev/null
+++ b/drivers/media/i2c/light-ccb.c
@@ -0,0 +1,1338 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Light L16 camera ASICs ("CCB") as a CSI-2 source for CAMSS.
+ *
+ * The L16's 16 camera modules sit behind three Light ASICs. ASIC1 is controlled over I2C
+ * (7-bit 0x08) and relays commands to the other two; each ASIC sends RAW10 over its own
+ * 4-lane CSI-2 link. The ASICs run exposure and focus themselves; the host sends them
+ * commands and reads their message queue.
+ *
+ * This driver powers the ASICs up (as stock LightOS does at boot), starts and stops the
+ * preview stream with the camera, and offers exposure, gain, focus and the preview module
+ * as V4L2 controls. Captures (full-resolution records sent over virtual channel 1) are
+ * driven from userspace through the raw message ioctls below; with the raw-transfer
+ * control set, stream on/off leaves the ASICs alone.
+ *
+ * Messages: the host writes [tid BE][cmd LE][body]. Commands with bit 15 set get a type-1
+ * reply carrying the tid. The queue is read by writing 00 00 and reading 8 bytes
+ * {u16 type, u16 len, 4 bytes}, then, if len > 4, writing 01 00 and reading len - 4.
+ * Type 2 means the queue is empty.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/jiffies.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/time.h>
+#include <linux/timekeeping.h>
+#include <linux/unaligned.h>
+#include <linux/workqueue.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define CCB_NUM_PADS	3		/* one CSI-2 link per ASIC */
+#define CCB_LANES	4
+#define CCB_BPP		10
+#define CCB_LINK_FREQ	750000000LL	/* not known; >= 386 MHz from stock capture timing */
+#define CCB_PIXEL_RATE	(CCB_LINK_FREQ * 2 * CCB_LANES / CCB_BPP)
+#define CCB_WIDTH	2080		/* preview, UCID 3 */
+#define CCB_HEIGHT	1560
+#define CCB_CODE	MEDIA_BUS_FMT_SGRBG10_1X10
+#define CCB_NATIVE_W	4160		/* the AR1335 arrays; preview bins 2:1 */
+#define CCB_NATIVE_H	3120
+
+/*
+ * Line timing for libcamera and Megapixels: the ASIC's preview line time is 10.444 us (its AE
+ * log); a line here is two of those (the preview bins 2:1), 20.888 us, which at the pixel
+ * rate we report is a 12533-pixel line, and a 30 fps frame is 1596 of them. The ASICs time
+ * their sensors themselves, so these are fixed.
+ */
+#define CCB_LINE_NS	20888
+#define CCB_LINE_LEN	12533
+#define CCB_FRAME_LINES	1596
+#define CCB_HBLANK	(CCB_LINE_LEN - CCB_WIDTH)
+#define CCB_MAX_EXPOSURE (15000000000ULL / CCB_LINE_NS)
+#define CCB_VBLANK	(CCB_FRAME_LINES - CCB_HEIGHT)
+
+#define CCB_MSG_MAX	128
+#define CCB_TYPE_REPLY	1
+#define CCB_TYPE_EMPTY	2
+#define CCB_TYPE_EVENT	3
+#define CCB_TYPE_AE	7
+#define CCB_TYPE_DESCRIPTOR 8
+
+/* TID kinds as stock uses them (kind << 13) */
+#define CCB_KIND_AF	1
+#define CCB_KIND_CMD	3
+#define CCB_KIND_CAPTURE 4
+#define CCB_KIND_CFG	5
+
+/* raw message interface on the subdev node (l16-capture, l16-asic-probe) */
+struct light_ccb_msg {
+	__u16 len;
+	__u8 data[CCB_MSG_MAX];
+};
+#define LIGHT_CCB_IOC_SEND	_IOW('L', 1, struct light_ccb_msg)	/* data = [tid][cmd][body] */
+#define LIGHT_CCB_IOC_RECV	_IOR('L', 2, struct light_ccb_msg)	/* data = [type][len][payload] */
+#define LIGHT_CCB_IOC_RESET	_IO('L', 3)				/* power cycle and boot */
+#define LIGHT_CCB_IOC_OFF	_IO('L', 4)				/* power off now */
+
+/*
+ * A photo, as stock's shutter takes it, while previewing: the preview stops, the modules in
+ * @mask expose into the ASICs' memory, and the preview starts again (about a quarter of a
+ * second). The ASICs then hold @records[asic] records each (frames, then the LRI header
+ * record), which LIGHT_CCB_IOC_TRANSFER sends over each ASIC's CSI-2 link, virtual channel 1,
+ * data type 0x30, one per call, in order.
+ */
+struct light_ccb_capture {
+	__u32 mask;		/* modules: bit n + 1 = LRI camera n */
+	__u8 uuid[16];		/* the photo's id, stored in its LRI header */
+	__u16 records[3];	/* out: records held by ASIC1..3 */
+	__u32 record_bytes;	/* out: bytes in a frame record */
+	__s32 status;		/* out: the capture-start reply status */
+	__u8 burst;		/* frames per module, back to back (0 or 1: one; up to 31) */
+	__u8 flags;		/* LIGHT_CCB_CAPTURE_* */
+	__u16 fps;		/* burst frame rate (0: the ASICs' own) */
+};
+
+/* no precapture metering: the preview's exposure as it is (quicker) */
+#define LIGHT_CCB_CAPTURE_NO_PRECAPTURE	BIT(0)
+/*
+ * no stacked capture (0x006a): one frame per module. In auto the ASICs stack several
+ * exposures per module when they judge it dark, or always without the precapture metering.
+ */
+#define LIGHT_CCB_CAPTURE_NO_STACK	BIT(1)
+
+#define LIGHT_CCB_IOC_CAPTURE	_IOWR('L', 5, struct light_ccb_capture)
+#define LIGHT_CCB_IOC_TRANSFER	_IOW('L', 6, __u32)		/* ASIC index 0..2 */
+
+/* custom controls */
+#define V4L2_CID_LIGHT_BASE		(V4L2_CID_USER_BASE | 0x1c00)
+#define V4L2_CID_LIGHT_MODULE		(V4L2_CID_LIGHT_BASE + 0)
+#define V4L2_CID_LIGHT_RAW_TRANSFER	(V4L2_CID_LIGHT_BASE + 1)
+#define V4L2_CID_LIGHT_EXPOSURE_US	(V4L2_CID_LIGHT_BASE + 2)
+#define V4L2_CID_LIGHT_ISO		(V4L2_CID_LIGHT_BASE + 3)
+#define V4L2_CID_LIGHT_AE_EXPOSURE_US	(V4L2_CID_LIGHT_BASE + 4)
+#define V4L2_CID_LIGHT_AE_ISO		(V4L2_CID_LIGHT_BASE + 5)
+#define V4L2_CID_LIGHT_FOCUS_X		(V4L2_CID_LIGHT_BASE + 6)
+#define V4L2_CID_LIGHT_FOCUS_Y		(V4L2_CID_LIGHT_BASE + 7)
+#define V4L2_CID_LIGHT_FLASH		(V4L2_CID_LIGHT_BASE + 8)
+
+static const s64 ccb_link_freqs[] = { CCB_LINK_FREQ };
+
+/* preview modules: stock previews on A1 (28 mm), B4 (70 mm) or C5 (150 mm) */
+static const char * const ccb_flash_names[] = { "Off", "Auto", NULL };
+
+static const char * const ccb_module_names[] = { "A1", "B4", "C5" };
+static const u8 ccb_module_masks[][3] = {
+	{ 0x02, 0x00, 0x00 },	/* A1: bit 1 (LRI camera 0) */
+	{ 0x00, 0x02, 0x00 },	/* B4: bit 9 */
+	{ 0x00, 0x80, 0x00 },	/* C5: bit 15 */
+};
+/* zoom factor (f32) the ASIC needs to run AE on the module: 1.0, 2.5, 150/28 */
+static const u32 ccb_module_zoom[] = { 0x3f800000, 0x40200004, 0x40ab6db7 };
+
+struct ccb {
+	struct v4l2_subdev sd;
+	struct media_pad pads[CCB_NUM_PADS];
+	struct v4l2_ctrl_handler ctrls;
+	struct i2c_client *client;
+
+	struct gpio_descs *straps;	/* boot mode: only ever driven low */
+	struct gpio_descs *enable;	/* power, then the resets, raised in order */
+
+	struct mutex lock;		/* serialises messages, power and streaming */
+	bool booted;
+	int stream_count;		/* s_stream(1) calls not yet undone */
+	bool previewing;
+	u8 seq;
+	u32 zoom;			/* the zoom factor (f32) the ASIC has */
+	ktime_t last_send;
+	bool ae_seen;			/* an AE push since the preview started */
+	int read_errors;		/* queue reads failed in a row while previewing */
+	struct delayed_work drain;	/* reads the queue while previewing */
+	struct work_struct af;		/* a focus run (seconds; not under the control lock) */
+	struct delayed_work ae;		/* exposure settings, sent once a burst of changes ends */
+
+	/*
+	 * Exposure: libcamera writes the standard exposure and gain controls with every
+	 * request (its defaults, whatever the app wants), so they are only stored; manual
+	 * exposure is set through exp_us and iso, and the ASICs' metering read from ae_us
+	 * and ae_iso.
+	 */
+	struct v4l2_ctrl *exp_auto;
+	struct v4l2_ctrl *exp_us;	/* manual exposure time */
+	struct v4l2_ctrl *iso;		/* manual ISO (the ASIC's gain x 100) */
+	struct v4l2_ctrl *ae_us;	/* read-only: the ASICs' current exposure time */
+	struct v4l2_ctrl *ae_iso;	/* read-only: and ISO */
+	struct v4l2_ctrl *module;
+	struct v4l2_ctrl *raw_transfer;
+	struct v4l2_ctrl *focus_x;	/* the AF window's top left, sensor pixels */
+	struct v4l2_ctrl *focus_y;
+	struct v4l2_ctrl *flash;	/* 0 off, 1 auto */
+};
+
+static inline struct ccb *to_ccb(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct ccb, sd);
+}
+
+static u16 ccb_tid(struct ccb *c, int kind)
+{
+	return kind << 13 | c->seq++;
+}
+
+/* --- messages ------------------------------------------------------------------------ */
+
+static int ccb_write(struct ccb *c, const u8 *buf, int len)
+{
+	int ret = i2c_master_send(c->client, buf, len);
+
+	return ret == len ? 0 : ret < 0 ? ret : -EIO;
+}
+
+/*
+ * Messages are spaced out: the ASIC drops some of a burst (the preview start's AE config
+ * went unheeded when sent back to back), as stock's HAL never sends them that fast.
+ */
+#define CCB_SEND_GAP_US	15000
+
+static bool debug;
+module_param(debug, bool, 0644);
+MODULE_PARM_DESC(debug, "log each message to the ASICs and each AE push");
+
+static int ccb_send(struct ccb *c, u16 tid, u16 cmd, const void *body, int n)
+{
+	u8 buf[CCB_MSG_MAX];
+	s64 since = ktime_us_delta(ktime_get(), c->last_send);
+	int ret;
+
+	if (n + 4 > sizeof(buf))
+		return -EINVAL;
+	if (since >= 0 && since < CCB_SEND_GAP_US)
+		usleep_range(CCB_SEND_GAP_US - since, CCB_SEND_GAP_US - since + 1000);
+	buf[0] = tid >> 8;
+	buf[1] = tid;
+	put_unaligned_le16(cmd, buf + 2);
+	if (n)
+		memcpy(buf + 4, body, n);
+	ret = ccb_write(c, buf, n + 4);
+	c->last_send = ktime_get();
+	if (debug)
+		dev_info(&c->client->dev, "send %04x %*ph: %d\n", cmd, n, body, ret);
+	return ret;
+}
+
+/* one message from ASIC1's queue: m[0..1] type, m[2..3] len, then the payload */
+static int ccb_read(struct ccb *c, u8 *m, int size)
+{
+	u8 sel[2] = { 0, 0 };
+	struct i2c_msg xfer[2] = {
+		{ .addr = c->client->addr, .len = 2, .buf = sel },
+		{ .addr = c->client->addr, .flags = I2C_M_RD, .len = 8, .buf = m },
+	};
+	int type, len, ret;
+
+	ret = i2c_transfer(c->client->adapter, xfer, 2);
+	if (ret != 2)
+		return ret < 0 ? ret : -EIO;
+
+	type = get_unaligned_le16(m);
+	len = get_unaligned_le16(m + 2);
+	if (type != CCB_TYPE_EMPTY && len > 4) {
+		if (len + 4 > size)
+			return -EOVERFLOW;
+		sel[0] = 1;
+		xfer[1].len = len - 4;
+		xfer[1].buf = m + 8;
+		ret = i2c_transfer(c->client->adapter, xfer, 2);
+		if (ret != 2)
+			return ret < 0 ? ret : -EIO;
+	}
+	return type;
+}
+
+/*
+ * Wait for a message of @type (for replies: with @tid; 0xffff = any), reading past the
+ * others (AE pushes arrive every frame). @ms counts only time spent on an empty queue.
+ */
+static int ccb_wait(struct ccb *c, int type, u16 tid, int ms, u8 *out)
+{
+	u8 m[CCB_MSG_MAX];
+	unsigned long end = jiffies + msecs_to_jiffies(ms);
+	int t;
+
+	while (time_before(jiffies, end)) {
+		/* read errors: the ASIC is not answering yet (just powered up); keep trying */
+		t = ccb_read(c, m, sizeof(m));
+		if (t >= 0 && t == type && (tid == 0xffff || get_unaligned_be16(m + 4) == tid)) {
+			if (out)
+				memcpy(out, m, sizeof(m));
+			return 0;
+		}
+		if (t < 0 || t == CCB_TYPE_EMPTY)
+			usleep_range(5000, 10000);
+		else
+			end += msecs_to_jiffies(1);	/* busy queue: don't count it */
+	}
+	return -ETIMEDOUT;
+}
+
+/* send a bit-15 command and wait up to @ms for its reply; returns the reply status */
+static int ccb_command_wait(struct ccb *c, int kind, u16 cmd, const void *body, int n, int ms)
+{
+	u16 tid = ccb_tid(c, kind);
+	u8 m[CCB_MSG_MAX];
+	int ret;
+
+	ret = ccb_send(c, tid, cmd, body, n);
+	if (!ret)
+		ret = ccb_wait(c, CCB_TYPE_REPLY, tid, ms, m);
+	if (ret) {
+		dev_err(&c->client->dev, "command 0x%04x: %d\n", cmd, ret);
+		return ret;
+	}
+	return get_unaligned_le16(m + 6);
+}
+
+static int ccb_command(struct ccb *c, int kind, u16 cmd, const void *body, int n)
+{
+	return ccb_command_wait(c, kind, cmd, body, n, 2000);
+}
+
+/* --- power ----------------------------------------------------------------------------- */
+
+static void ccb_power_off(struct ccb *c)
+{
+	int i;
+
+	for (i = c->enable->ndescs - 1; i >= 0; i--)
+		gpiod_set_value_cansleep(c->enable->desc[i], 0);
+	c->booted = false;
+	c->previewing = false;
+}
+
+/* stock's sequence (fw_update.sh, prog_app_p2 -q): enables raised a second apart */
+static int ccb_boot(struct ccb *c)
+{
+	unsigned int i;
+	int ret;
+
+	ccb_power_off(c);
+	msleep(100);
+	for (i = 0; i < c->enable->ndescs; i++) {
+		if (i)
+			msleep(1000);
+		gpiod_set_value_cansleep(c->enable->desc[i], 1);
+	}
+	ret = ccb_wait(c, CCB_TYPE_EVENT, 0xffff, 5000, NULL);
+	if (ret) {
+		dev_err(&c->client->dev, "no boot event from the ASICs: %d\n", ret);
+		ccb_power_off(c);
+		return ret;
+	}
+	c->booted = true;
+	c->zoom = ccb_module_zoom[0];
+	dev_info(&c->client->dev, "ASICs booted\n");
+	return 0;
+}
+
+/*
+ * Power up and boot. A failed boot is not a failed resume (that would leave runtime PM
+ * refusing every later resume); users check c->booted through ccb_ready().
+ */
+static int ccb_runtime_resume(struct device *dev)
+{
+	struct ccb *c = to_ccb(i2c_get_clientdata(to_i2c_client(dev)));
+
+	mutex_lock(&c->lock);
+	if (!c->booted)
+		ccb_boot(c);
+	mutex_unlock(&c->lock);
+	return 0;
+}
+
+/* with c->lock held and runtime PM active: the ASICs booted, or one more try */
+static int ccb_ready(struct ccb *c)
+{
+	if (c->booted)
+		return 0;
+	return ccb_boot(c) ? -EIO : 0;
+}
+
+static int ccb_runtime_suspend(struct device *dev)
+{
+	struct ccb *c = to_ccb(i2c_get_clientdata(to_i2c_client(dev)));
+
+	cancel_delayed_work_sync(&c->drain);
+	cancel_work_sync(&c->af);
+	cancel_delayed_work_sync(&c->ae);
+	mutex_lock(&c->lock);
+	ccb_power_off(c);
+	mutex_unlock(&c->lock);
+	return 0;
+}
+
+/* --- preview ---------------------------------------------------------------------------- */
+
+/* IEEE-754 single-precision bits of n / d, for n >= d > 0 (no floating point here) */
+static u32 ccb_f32(u32 n, u32 d)
+{
+	int e = 0;
+	u64 m;
+
+	while ((u64)n >= (u64)d << (e + 1))
+		e++;
+	m = div_u64((u64)n << 23, d) >> e;
+	return (127 + e) << 23 | (m & 0x7fffff);
+}
+
+/* round(f * k) for the IEEE-754 single @bits of a non-negative f (no floating point here) */
+static u32 ccb_f32_mul(u32 bits, u32 k)
+{
+	int e = (int)((bits >> 23) & 0xff) - 127 - 23;
+	u64 m = (u64)((bits & 0x7fffff) | 0x800000) * k;
+
+	if (!(bits & 0x7f800000) || bits & 0x80000000)
+		return 0;
+	if (e >= 0)
+		return e > 8 ? U32_MAX : min_t(u64, m << e, U32_MAX);
+	return e < -63 ? 0 : (m + (1ULL << (-e - 1))) >> -e;
+}
+
+/*
+ * Exposure as stock's camera app sets it (I2C trace of its manual and priority modes):
+ * 0x0060 the AE mode (2 auto, 1 manual, then 00 00 3c 00), and 0x0067 the exposure
+ * {f32 gain, f32 gain, u64 exposure ns, u64 exposure ns}, gain in ISO/100, a zero meaning
+ * the ASIC's own choice (all zero in auto); 0x006a is 00 01 in manual, 01 01 in auto.
+ */
+static int ccb_ae_manual(struct ccb *c)
+{
+	static const u8 stack[] = { 0x00, 0x01 };
+	static const u8 mode[] = { 0x01, 0x00, 0x00, 0x00, 0x3c, 0x00 };
+	u64 ns = (u64)c->exp_us->cur.val * 1000;
+	u32 gain = ccb_f32(c->iso->cur.val, 100);
+	u8 b[24];
+
+	put_unaligned_le32(gain, b);
+	put_unaligned_le32(gain, b + 4);
+	put_unaligned_le64(ns, b + 8);
+	put_unaligned_le64(ns, b + 16);
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x006a, stack, sizeof(stack));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0060, mode, sizeof(mode));
+	return ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0067, b, sizeof(b));
+}
+
+static int ccb_ae_auto(struct ccb *c)
+{
+	static const u8 stack[] = { 0x01, 0x01 };
+	static const u8 mode[] = { 0x02, 0x00, 0x00, 0x00, 0x3c, 0x00 };
+	static const u8 zero[24] = { 0 };
+
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0060, mode, sizeof(mode));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0067, zero, sizeof(zero));
+	return ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x006a, stack, sizeof(stack));
+}
+
+/*
+ * The flash LEDs' torch / pre-flash currents (0x0066 {u16 led1, led2}, mA): stock's 1 and 149
+ * (warm, cool) when the flash may be used, so the ASICs light it to focus and meter in the
+ * dark (AF assist); zero when it is off.
+ */
+static int ccb_apply_flash(struct ccb *c)
+{
+	static const u8 on[] = { 0x01, 0x00, 0x95, 0x00 }, off[] = { 0, 0, 0, 0 };
+
+	return ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0066, c->flash->cur.val ? on : off,
+			sizeof(off));
+}
+
+static int ccb_apply_ae(struct ccb *c)
+{
+	if (!c->previewing)
+		return 0;
+	return c->exp_auto->cur.val == V4L2_EXPOSURE_MANUAL ? ccb_ae_manual(c) : ccb_ae_auto(c);
+}
+
+/*
+ * While previewing, the ASIC pushes its AE state (type 7) every frame and nothing else reads
+ * the queue; left alone it backs up until ASIC1 stops answering. Read it every 50 ms, and in
+ * auto mode report the metered exposure and gain through the controls, so that switching to
+ * manual (Megapixels does before a capture) holds them.
+ * AE push: u64 exposure ns, f32 (max gain), f32 gain in ASIC units (2x analog), ...
+ */
+static int ccb_restart_preview(struct ccb *c);
+
+static void ccb_drain_work(struct work_struct *work)
+{
+	struct ccb *c = container_of(to_delayed_work(work), struct ccb, drain);
+	u8 m[CCB_MSG_MAX];
+	u64 ns = 0;
+	u32 gain = 0;
+	bool ae = false;
+	int i, t;
+
+	mutex_lock(&c->lock);
+	if (!c->previewing) {
+		mutex_unlock(&c->lock);
+		return;
+	}
+	for (i = 0; i < 64; i++) {
+		t = ccb_read(c, m, sizeof(m));
+		if (t < 0 || t == CCB_TYPE_EMPTY)
+			break;
+		if (t == CCB_TYPE_AE && get_unaligned_le16(m + 2) >= 16) {
+			ns = get_unaligned_le64(m + 4);
+			gain = get_unaligned_le32(m + 16);
+			ae = true;
+			if (debug)
+				dev_info(&c->client->dev, "AE push %llu us, ISO %u\n",
+					 div_u64(ns, 1000), ccb_f32_mul(gain, 100));
+			if (!c->ae_seen)
+				dev_info(&c->client->dev, "AE running: %llu us, ISO %u\n",
+					 div_u64(ns, 1000), ccb_f32_mul(gain, 100));
+			c->ae_seen = true;
+		}
+	}
+	/*
+	 * ASIC1 can stop answering (after quick preview restarts, for one): if the queue
+	 * cannot be read for two seconds, boot the ASICs again and carry on previewing
+	 */
+	if (t < 0 && ++c->read_errors >= 40) {
+		c->read_errors = 0;
+		ccb_restart_preview(c);
+	} else if (t >= 0) {
+		c->read_errors = 0;
+	}
+	if (c->previewing)
+		schedule_delayed_work(&c->drain, msecs_to_jiffies(50));
+	mutex_unlock(&c->lock);
+
+	if (ae) {
+		v4l2_ctrl_s_ctrl(c->ae_us, clamp_t(u64, div_u64(ns, 1000), 0, c->ae_us->maximum));
+		v4l2_ctrl_s_ctrl(c->ae_iso, clamp_t(u32, ccb_f32_mul(gain, 100), 0, c->ae_iso->maximum));
+	}
+}
+
+/* stock's camera start (LightOS I2C traces), preview on the selected module */
+static int ccb_preview_start(struct ccb *c)
+{
+	static const u8 open[] = { 0x01, 0x00, 0x00, 0x02 };
+	/* crop 4160x3120: capture (UCID 5) 1:1, preview (UCID 3) 1:2 = 2080x1560 */
+	static const u8 crop5[] = { 0x01, 0x00, 0x00, 0x05, 0x00, 0x00, 0x00, 0x00, 0x00,
+				    0x40, 0x10, 0x30, 0x0c, 0x01, 0x01 };
+	static const u8 crop3[] = { 0x01, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x00,
+				    0x40, 0x10, 0x30, 0x0c, 0x01, 0x02 };
+	/* AE: gain 1.0 for capture; preview gain 1.0, 2.5 ms, as stock starts */
+	static const u8 ae5[] = { 0x01, 0x00, 0x00, 0x05, 0x00, 0x05, 0x00, 0x00, 0x80, 0x3f,
+				  0, 0, 0, 0, 0, 0, 0, 0, 0x00, 0x3c };
+	static const u8 ae3[] = { 0x01, 0x00, 0x00, 0x03, 0x00, 0x07, 0x00, 0x00, 0x80, 0x3f,
+				  0xa0, 0x25, 0x26, 0, 0, 0, 0, 0, 0x00, 0x3c };
+	static const u8 ucid3[] = { 0x03, 0x00 };
+	static const u8 evcomp[] = { 0x00, 0x01 };
+	static const u8 zero67[24] = { 0 };
+	static const u8 stack[] = { 0x01, 0x01 };
+	static const u8 ae3b[] = { 0x01, 0x00, 0x00, 0x03, 0x00, 0x03, 0x00, 0xa0, 0x90, 0x40,
+				   0x8c, 0xcc, 0x02, 0x01, 0, 0, 0, 0, 0, 0 };
+	int mod = c->module->val;
+	u8 on[6], time[16], z[4];
+	struct timespec64 now;
+	int ret;
+
+	ktime_get_real_ts64(&now);
+	put_unaligned_le32(now.tv_sec, time);
+	put_unaligned_le32(now.tv_nsec / 1000, time + 4);
+	put_unaligned_le32(0, time + 8);
+	put_unaligned_le32(-sys_tz.tz_minuteswest * 60, time + 12);
+	ret = ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x0201, time, sizeof(time));
+	if (ret)
+		return ret;
+	ret = ccb_command(c, CCB_KIND_CMD, 0x8000, open, sizeof(open));
+	if (ret < 0)
+		return ret;
+	ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x002e, crop5, sizeof(crop5));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x0033, ae5, sizeof(ae5));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x002e, crop3, sizeof(crop3));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x0033, ae3, sizeof(ae3));
+	ret = ccb_command(c, CCB_KIND_CMD, 0x9000, ucid3, sizeof(ucid3));
+	if (ret < 0)
+		return ret;
+
+	memcpy(on, ccb_module_masks[mod], 3);
+	on[3] = 0x11;
+	on[4] = 0x00;
+	on[5] = 0x00;
+	ret = ccb_command(c, CCB_KIND_CMD, 0x8002, on, sizeof(on));
+	if (ret < 0)
+		return ret;
+
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0062, evcomp, sizeof(evcomp));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0067, zero67, sizeof(zero67));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x006a, stack, sizeof(stack));
+	ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x0033, ae3b, sizeof(ae3b));
+	c->previewing = true;
+	c->ae_seen = false;
+	ccb_apply_flash(c);
+	ret = ccb_apply_ae(c);
+	if (ret)
+		return ret;
+
+	/*
+	 * the ASIC skips AE unless its zoom factor matches the preview module, and focuses
+	 * for its zoom factor too; it keeps the factor across a module switch. Only send a
+	 * change: 1.0 sent to a fresh A1 preview stops its AE (no more type 7 pushes).
+	 */
+	if (c->zoom != ccb_module_zoom[mod]) {
+		put_unaligned_le32(ccb_module_zoom[mod], z);
+		ccb_send(c, ccb_tid(c, CCB_KIND_CMD), 0x005c, z, sizeof(z));
+		c->zoom = ccb_module_zoom[mod];
+	}
+	schedule_delayed_work(&c->drain, msecs_to_jiffies(50));
+	return 0;
+}
+
+/* @mod: the module previewing (the control's value may already be the next one) */
+static int ccb_preview_stop(struct ccb *c, int mod)
+{
+	static const u8 close[] = { 0x01, 0x00, 0x00, 0x00 };
+	u8 off[6];
+	int ret;
+
+	memcpy(off, ccb_module_masks[mod], 3);
+	off[3] = 0x10;
+	off[4] = 0x00;
+	off[5] = 0x00;
+	c->previewing = false;
+	ret = ccb_command(c, CCB_KIND_CMD, 0x8002, off, sizeof(off));
+	if (ret >= 0)
+		ret = ccb_command(c, CCB_KIND_CMD, 0x8000, close, sizeof(close));
+	if (ret < 0) {
+		/* the ASICs are in an unknown state: power them off so the next start boots them */
+		ccb_power_off(c);
+		return ret;
+	}
+	return 0;
+}
+
+/*
+ * With c->lock held, while streaming: ASIC1 stopped answering (or a restart failed). Boot
+ * the ASICs again and restart the preview, so the stream keeps a preview behind it.
+ */
+static int ccb_restart_preview(struct ccb *c)
+{
+	int ret;
+
+	dev_warn(&c->client->dev, "ASICs not answering; restarting them\n");
+	ret = ccb_boot(c);
+	if (!ret)
+		ret = ccb_preview_start(c);
+	return ret;
+}
+
+/*
+ * Stock's autofocus: lock AE, AF on one 200x200 window {01, reason 1, u16 x, y, w, h, weight 1000}
+ * in the module's 4160x3120 pixels (stock's centre window is at 1958,1482), unlock.
+ */
+static int ccb_autofocus(struct ccb *c)
+{
+	static const u8 lock[] = { 0x01 }, unlock[] = { 0x00 };
+	u8 roi[] = { 0x01, 0x01, 0xa6, 0x07, 0xca, 0x05, 0xc8, 0x00, 0xc8, 0x00, 0xe8, 0x03 };
+	int ret;
+
+	put_unaligned_le16(c->focus_x->cur.val, roi + 2);
+	put_unaligned_le16(c->focus_y->cur.val, roi + 4);
+	/*
+	 * the reason byte stays 1: stock sends 3 for its routine centre focus and 2 or 5 for
+	 * touches, but with those A1 (the 28-70 mm preview) stopped focusing
+	 */
+
+	if (!c->previewing)
+		return -EBUSY;
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0061, lock, sizeof(lock));
+	/* on the B and C modules focus runs across the ASICs and takes a few seconds */
+	ret = ccb_command_wait(c, CCB_KIND_AF, 0x8058, roi, sizeof(roi), 6000);
+	if (ret == -EIO || ret == -ENXIO || ret == -EREMOTEIO) {
+		ccb_restart_preview(c);
+		return ret;
+	}
+	ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0061, unlock, sizeof(unlock));
+	if (debug)
+		dev_info(&c->client->dev, "autofocus at %d,%d: %d (1 focused, 2 failed)\n",
+			 c->focus_x->cur.val, c->focus_y->cur.val, ret);
+	return ret < 0 ? ret : 0;
+}
+
+static void ccb_ae_work(struct work_struct *work)
+{
+	struct ccb *c = container_of(to_delayed_work(work), struct ccb, ae);
+
+	mutex_lock(&c->lock);
+	ccb_apply_ae(c);
+	mutex_unlock(&c->lock);
+}
+
+static void ccb_af_work(struct work_struct *work)
+{
+	struct ccb *c = container_of(work, struct ccb, af);
+
+	mutex_lock(&c->lock);
+	if (c->previewing)
+		ccb_autofocus(c);
+	mutex_unlock(&c->lock);
+}
+
+/* --- V4L2 ------------------------------------------------------------------------------- */
+
+static int ccb_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct ccb *c = container_of(ctrl->handler, struct ccb, ctrls);
+	int ret = 0;
+
+	/* only send to the ASICs while they are previewing; otherwise remember the value */
+	switch (ctrl->id) {
+	case V4L2_CID_LIGHT_EXPOSURE_US:
+	case V4L2_CID_LIGHT_ISO:
+		/* in auto mode the ASICs meter themselves; the value is kept for manual mode */
+		if (c->exp_auto->cur.val != V4L2_EXPOSURE_MANUAL)
+			break;
+		fallthrough;
+	case V4L2_CID_EXPOSURE_AUTO:
+		/*
+		 * a dial being dragged sets these many times a second, and a burst of AE
+		 * messages stops ASIC1 answering: send the settings once the changes pause
+		 */
+		mod_delayed_work(system_wq, &c->ae, msecs_to_jiffies(60));
+		break;
+	case V4L2_CID_LIGHT_FLASH:
+		mutex_lock(&c->lock);
+		if (c->previewing)
+			ret = ccb_send(c, ccb_tid(c, CCB_KIND_CFG), 0x0066,
+				       ctrl->val ? (const u8[]){ 0x01, 0x00, 0x95, 0x00 } :
+						   (const u8[]){ 0, 0, 0, 0 }, 4);
+		mutex_unlock(&c->lock);
+		break;
+	case V4L2_CID_AUTO_FOCUS_START:
+		/*
+		 * a focus run takes seconds; the control handler's lock is held for the whole
+		 * of s_ctrl, which would stall every other control access (the camera app's
+		 * exposure readout) until it ends. Run it in the background, as stock does.
+		 */
+		if (!c->previewing)
+			ret = -EBUSY;
+		else
+			schedule_work(&c->af);
+		break;
+	case V4L2_CID_LIGHT_MODULE:
+		/*
+		 * while previewing, restart the ASICs' preview on the new module; the CSI-2
+		 * stream just pauses, and whoever is streaming keeps going
+		 */
+		mutex_lock(&c->lock);
+		if (c->previewing) {
+			ret = ccb_preview_stop(c, c->module->cur.val);
+			if (!ret)
+				ret = ccb_preview_start(c);
+			if (ret)
+				ret = ccb_restart_preview(c);
+		}
+		mutex_unlock(&c->lock);
+		break;
+	}
+	return ret;
+}
