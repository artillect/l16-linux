+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
@@ -863,7 +863,7 @@ static void csid_try_format(struct csid_device *csid,
 				fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 			fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-			fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+			fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 			fmt->field = V4L2_FIELD_NONE;
 		}
@@ -1256,7 +1256,7 @@ static int csid_link_setup(struct media_entity *entity,
 			   const struct media_pad *local,
 			   const struct media_pad *remote, u32 flags)
 {
-	if (flags & MEDIA_LNK_FL_ENABLED)
+	if ((flags & MEDIA_LNK_FL_ENABLED) && (local->flags & MEDIA_PAD_FL_SINK))
 		if (media_pad_remote_pad_first(local))
 			return -EBUSY;
 
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
