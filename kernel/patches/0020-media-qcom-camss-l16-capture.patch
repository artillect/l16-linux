diff --git a/drivers/media/platform/qcom/camss/camss-ispif.c b/drivers/media/platform/qcom/camss/camss-ispif.c
index 43d3b133f..743b5bf8e 100644
--- a/drivers/media/platform/qcom/camss/camss-ispif.c
+++ b/drivers/media/platform/qcom/camss/camss-ispif.c
@@ -795,7 +795,8 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 	enum ispif_intf intf = line->interface;
 	u8 csid = line->csid_id;
 	u8 vfe = line->vfe_id;
-	u8 vc = 0; /* Virtual Channel 0 */
+	/* L16: the ASICs send captures on VC 1 (all lines, or per line) */
+	u8 vc = camss_vc ? camss_vc : camss_ispif_vc[line->id & 3];
 	u8 cid = vc * 4; /* id of Virtual Channel and Data Type set */
 	int ret;
 
@@ -831,9 +832,22 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 				   intf, vfe, vc);
 		mutex_unlock(&ispif->config_lock);
 
+		/*
+		 * L16: an interface that never saw a frame (a photo stream left idle) never
+		 * reaches a frame boundary; stop it at once rather than leave it half enabled
+		 * (the unconfiguring below skipped, the next stream on the line got nothing)
+		 */
 		ret = ispif_wait_for_stop(ispif, intf, vfe);
-		if (ret < 0)
-			return ret;
+		if (ret < 0) {
+			mutex_lock(&ispif->config_lock);
+			ispif_set_intf_cmd(ispif, CMD_DISABLE_IMMEDIATELY,
+					   intf, vfe, vc);
+			mutex_unlock(&ispif->config_lock);
+			ret = ispif_wait_for_stop(ispif, intf, vfe);
+			if (ret < 0)
+				dev_warn(ispif->camss->dev,
+					 "%s: interface still not stopped\n", __func__);
+		}
 
 		mutex_lock(&ispif->config_lock);
 		if (camss->res->version == CAMSS_8x96 ||
@@ -903,7 +917,7 @@ static void ispif_try_format(struct ispif_line *line,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
index d84a375e3..611ead038 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -241,7 +241,9 @@ static int vfe_enable_output(struct vfe_line *line)
 		vfe->ops_gen1->enable_irq_wm_line(vfe, output->wm_idx[0], line->id, 1);
 		vfe->ops_gen1->bus_connect_wm_to_rdi(vfe, output->wm_idx[0], line->id);
 		vfe->ops_gen1->wm_set_subsample(vfe, output->wm_idx[0]);
-		vfe->ops_gen1->set_rdi_cid(vfe, line->id, 0);
+		/* L16: CID of the VC (all RDIs, or per RDI) */
+		vfe->ops_gen1->set_rdi_cid(vfe, line->id, 4 * (camss_vc ? camss_vc :
+					   camss_rdi_vc[(vfe->id * 3 + line->id) % 6]));
 		vfe->ops_gen1->wm_set_ub_cfg(vfe, output->wm_idx[0],
 					    (ub_size + 1) * output->wm_idx[0], ub_size);
 		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
