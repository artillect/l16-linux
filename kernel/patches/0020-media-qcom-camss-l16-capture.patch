diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 831486e14..0e9ebf740 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -21,7 +21,7 @@
 #define CAMSS_FRAME_MIN_WIDTH		1
 #define CAMSS_FRAME_MAX_WIDTH		8191
 #define CAMSS_FRAME_MIN_HEIGHT		1
-#define CAMSS_FRAME_MAX_HEIGHT_RDI	8191
+#define CAMSS_FRAME_MAX_HEIGHT_RDI	16383
 #define CAMSS_FRAME_MAX_HEIGHT_PIX	4096
 
 /* -----------------------------------------------------------------------------
@@ -240,6 +240,48 @@ static int video_prepare_streaming(struct vb2_queue *q)
 	return ret;
 }
 
+/*
+ * L16: start or stop a subdev for one pipeline, counting: several video nodes can share
+ * subdevs (the sensor, a CSIPHY and CSID carrying a preview on VC 0 and transfers on VC 1),
+ * which start with the first and stop with the last.
+ */
+static int video_subdev_stream(struct camss *camss, struct v4l2_subdev *sd, int enable)
+{
+	int i, free = -1, ret = 0;
+
+	mutex_lock(&camss->stream_lock);
+	for (i = 0; i < ARRAY_SIZE(camss->streams); i++) {
+		if (camss->streams[i].sd == sd)
+			break;
+		if (!camss->streams[i].sd && free < 0)
+			free = i;
+	}
+	if (i == ARRAY_SIZE(camss->streams)) {
+		if (!enable || free < 0) {
+			mutex_unlock(&camss->stream_lock);
+			return enable ? -ENOMEM : 0;
+		}
+		i = free;
+		camss->streams[i].sd = sd;
+		camss->streams[i].count = 0;
+	}
+	if (enable) {
+		if (!camss->streams[i].count)
+			ret = v4l2_subdev_call(sd, video, s_stream, 1);
+		if (ret >= 0 || ret == -ENOIOCTLCMD) {
+			camss->streams[i].count++;
+			ret = 0;
+		}
+	} else if (camss->streams[i].count && !--camss->streams[i].count) {
+		ret = v4l2_subdev_call(sd, video, s_stream, 0);
+		camss->streams[i].sd = NULL;
+		if (ret == -ENOIOCTLCMD)
+			ret = 0;
+	}
+	mutex_unlock(&camss->stream_lock);
+	return ret;
+}
+
 static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 {
 	struct camss_video *video = vb2_get_drv_priv(q);
@@ -249,7 +291,16 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 	struct v4l2_subdev *subdev;
 	int ret;
 
-	ret = video_device_pipeline_alloc_start(vdev);
+	/*
+	 * L16: a node started while another streams (transfers beside a preview) joins that
+	 * pipeline without taking part in its start count, which it could not give back: the
+	 * media core only counts pads found when the pipeline was built.
+	 */
+	mutex_lock(&vdev->entity.graph_obj.mdev->graph_mutex);
+	video->joined = video->camss->pipe.start_count &&
+			!media_pad_pipeline(&vdev->entity.pads[0]);
+	mutex_unlock(&vdev->entity.graph_obj.mdev->graph_mutex);
+	ret = video->joined ? 0 : video_device_pipeline_start(vdev, &video->camss->pipe);
 	if (ret < 0) {
 		dev_err(video->camss->dev, "Failed to start media pipeline: %d\n", ret);
 		goto flush_buffers;
@@ -272,15 +323,41 @@ static int video_start_streaming(struct vb2_queue *q, unsigned int count)
 		entity = pad->entity;
 		subdev = media_entity_to_v4l2_subdev(entity);
 
-		ret = v4l2_subdev_call(subdev, video, s_stream, 1);
-		if (ret < 0 && ret != -ENOIOCTLCMD)
-			goto error;
+		ret = video_subdev_stream(video->camss, subdev, 1);
+		if (ret < 0)
+			goto unwind;
 	}
 
 	return 0;
 
+unwind:
+	/*
+	 * L16: the subdevs started before the one that failed (the sensor, last, when the
+	 * ASICs don't boot) are stopped again: vb2 doesn't call stop_streaming after a failed
+	 * start, and their start counts stayed up for good, the hardware never stopped.
+	 */
+	{
+		struct v4l2_subdev *failed = subdev;
+
+		entity = &vdev->entity;
+		while (1) {
+			pad = &entity->pads[0];
+			if (!(pad->flags & MEDIA_PAD_FL_SINK))
+				break;
+			pad = media_pad_remote_pad_first(pad);
+			if (!pad || !is_media_entity_v4l2_subdev(pad->entity))
+				break;
+			entity = pad->entity;
+			subdev = media_entity_to_v4l2_subdev(entity);
+			if (subdev == failed)
+				break;
+			video_subdev_stream(video->camss, subdev, 0);
+		}
+	}
+
 error:
-	video_device_pipeline_stop(vdev);
+	if (!video->joined)
+		video_device_pipeline_stop(vdev);
 
 flush_buffers:
 	video->ops->flush_buffers(video, VB2_BUF_STATE_QUEUED);
@@ -310,7 +387,7 @@ static void video_stop_streaming(struct vb2_queue *q)
 		entity = pad->entity;
 		subdev = media_entity_to_v4l2_subdev(entity);
 
-		ret = v4l2_subdev_call(subdev, video, s_stream, 0);
+		ret = video_subdev_stream(video->camss, subdev, 0);
 
 		if (ret) {
 			dev_err(video->camss->dev, "Video pipeline stop failed: %d\n", ret);
@@ -318,7 +395,8 @@ static void video_stop_streaming(struct vb2_queue *q)
 		}
 	}
 
-	video_device_pipeline_stop(vdev);
+	if (!video->joined)
+		video_device_pipeline_stop(vdev);
 
 	video->ops->flush_buffers(video, VB2_BUF_STATE_ERROR);
 }
diff --git a/drivers/media/platform/qcom/camss/camss-video.h b/drivers/media/platform/qcom/camss/camss-video.h
index d3e56e240..0a76efd59 100644
--- a/drivers/media/platform/qcom/camss/camss-video.h
+++ b/drivers/media/platform/qcom/camss/camss-video.h
@@ -35,6 +35,7 @@ struct camss_video_ops {
 
 struct camss_video {
 	struct camss *camss;
+	bool joined;	/* L16: streams inside another node's started pipeline */
 	struct vb2_queue vb2_q;
 	struct video_device vdev;
 	struct media_pad pad;
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 1c9bb62b9..6ab1d42f5 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -3954,10 +3954,20 @@ int camss_get_pixel_clock(struct media_entity *entity, u64 *pixel_clock)
 	return 0;
 }
 
+/*
+ * A CSID powers up through a VFE. SoCs with more CSIDs than VFEs (msm8996: 4 and 2) would
+ * otherwise fail to power CSID2 and CSID3; they share a VFE instead.
+ */
+static int vfe_parent_dev_id(struct camss *camss, int id)
+{
+	return camss->res->vfe_num ? id % camss->res->vfe_num : id;
+}
+
 static int vfe_parent_dev_ops_get(struct camss *camss, int id)
 {
 	int ret = -EINVAL;
 
+	id = vfe_parent_dev_id(camss, id);
 	if (id < camss->res->vfe_num) {
 		struct vfe_device *vfe = &camss->vfe[id];
 
@@ -3969,6 +3979,7 @@ static int vfe_parent_dev_ops_get(struct camss *camss, int id)
 
 static int vfe_parent_dev_ops_put(struct camss *camss, int id)
 {
+	id = vfe_parent_dev_id(camss, id);
 	if (id < camss->res->vfe_num) {
 		struct vfe_device *vfe = &camss->vfe[id];
 
@@ -4059,23 +4070,19 @@ static int camss_of_parse_ports(struct camss *camss)
 {
 	struct device *dev = camss->dev;
 	struct device_node *node = NULL;
-	struct device_node *remote = NULL;
 	int ret, num_subdevs = 0;
 
 	for_each_endpoint_of_node(dev->of_node, node) {
 		struct camss_async_subdev *csd;
 
-		remote = of_graph_get_remote_port_parent(node);
-		if (!remote) {
-			dev_err(dev, "Cannot get remote parent\n");
-			ret = -EINVAL;
-			goto err_cleanup;
-		}
-
-		csd = v4l2_async_nf_add_fwnode(&camss->notifier,
-					       of_fwnode_handle(remote),
-					       struct camss_async_subdev);
-		of_node_put(remote);
+		/*
+		 * Match the remote endpoint rather than the remote device: a source
+		 * with several CSI-2 outputs (the Light L16's camera ASICs) connects to
+		 * several CSIPHYs and gets one bound call per connection.
+		 */
+		csd = v4l2_async_nf_add_fwnode_remote(&camss->notifier,
+						      of_fwnode_handle(node),
+						      struct camss_async_subdev);
 		if (IS_ERR(csd)) {
 			ret = PTR_ERR(csd);
 			goto err_cleanup;
@@ -4211,11 +4218,12 @@ static int camss_link_entities(struct camss *camss)
 	if (camss->ispif) {
 		for (i = 0; i < camss->res->csid_num; i++) {
 			for (j = 0; j < camss->ispif->line_num; j++) {
+				/* dynamic: a transfer path is linked while a preview streams */
 				ret = media_create_pad_link(&camss->csid[i].subdev.entity,
 							    MSM_CSID_PAD_SRC,
 							    &camss->ispif->line[j].subdev.entity,
 							    MSM_ISPIF_PAD_SINK,
-							    0);
+							    MEDIA_LNK_FL_DYNAMIC);
 				if (ret < 0) {
 					camss_link_err(camss,
 						       camss->csid[i].subdev.entity.name,
@@ -4394,11 +4402,30 @@ static int camss_subdev_notifier_bound(struct v4l2_async_notifier *async,
 		container_of(asd, struct camss_async_subdev, asd);
 	u8 id = csd->interface.csiphy_id;
 	struct csiphy_device *csiphy = &camss->csiphy[id];
+	struct media_entity *sensor = &subdev->entity;
+	int pad, ret;
 
 	csiphy->cfg.csi2 = &csd->interface.csi2;
-	subdev->host_priv = csiphy;
 
-	return 0;
+	/* the source pad for this connection's endpoint, else the first one */
+	pad = media_entity_get_fwnode_pad(sensor, asd->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0)
+		for (pad = 0; pad < sensor->num_pads; pad++)
+			if (sensor->pads[pad].flags & MEDIA_PAD_FL_SOURCE)
+				break;
+	if (pad >= sensor->num_pads) {
+		dev_err(camss->dev, "No source pad in external entity\n");
+		return -EINVAL;
+	}
+
+	ret = media_create_pad_link(sensor, pad, &csiphy->subdev.entity,
+				    MSM_CSIPHY_PAD_SINK,
+				    MEDIA_LNK_FL_IMMUTABLE | MEDIA_LNK_FL_ENABLED);
+	if (ret < 0)
+		camss_link_err(camss, sensor->name, csiphy->subdev.entity.name, ret);
+
+	return ret;
 }
 
 static int camss_subdev_notifier_complete(struct v4l2_async_notifier *async)
@@ -4587,6 +4614,7 @@ static int camss_probe(struct platform_device *pdev)
 
 	atomic_set(&camss->ref_count, 0);
 	camss->dev = dev;
+	mutex_init(&camss->stream_lock);
 	platform_set_drvdata(pdev, camss);
 
 	camss->csiphy = devm_kcalloc(dev, camss->res->csiphy_num,
@@ -4944,6 +4972,30 @@ static const struct of_device_id camss_dt_match[] = {
 
 MODULE_DEVICE_TABLE(of, camss_dt_match);
 
+int camss_vc;
+module_param_named(vc, camss_vc, int, 0644);
+MODULE_PARM_DESC(vc, "CSI-2 virtual channel to receive (L16: 0 preview, 1 capture)");
+
+int camss_dt;
+module_param_named(dt, camss_dt, int, 0644);
+
+int camss_vc1_dt;
+module_param_named(vc1_dt, camss_vc1_dt, int, 0644);
+MODULE_PARM_DESC(vc1_dt, "L16: also pass virtual channel 1 with this data type (0: off)");
+
+int camss_ispif_vc[4];
+module_param_array_named(ispif_vc, camss_ispif_vc, int, NULL, 0644);
+MODULE_PARM_DESC(ispif_vc, "L16: virtual channel of each ISPIF line (when vc is 0)");
+
