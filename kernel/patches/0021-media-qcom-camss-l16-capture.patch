From: Riley <oreo4455@gmail.com>
Subject: [PATCH] media: qcom: camss: L16 captures (virtual channel parameter, taller raw frames)

---
diff --git a/drivers/media/platform/qcom/camss/camss-csid-4-7.c b/drivers/media/platform/qcom/camss/camss-csid-4-7.c
index 66054d487..0aa14066c 100644
--- a/drivers/media/platform/qcom/camss/camss-csid-4-7.c
+++ b/drivers/media/platform/qcom/camss/camss-csid-4-7.c
@@ -53,7 +53,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 	if (enable) {
 		struct v4l2_mbus_framefmt *input_format;
 		const struct csid_format_info *format;
-		u8 vc = 0; /* Virtual Channel 0 */
+		u8 vc = camss_vc; /* L16: the ASICs send captures on VC 1 */
 		u8 cid = vc * 4; /* id of Virtual Channel and Data Type set */
 		u8 dt_shift;
 
@@ -111,7 +111,7 @@ static void csid_configure_stream(struct csid_device *csid, u8 enable)
 
 		val = readl_relaxed(csid->base + CAMSS_CSID_CID_LUT_VC_n(vc));
 		val &= ~(0xff << dt_shift);
-		val |= format->data_type << dt_shift;
+		val |= (camss_dt ? camss_dt : format->data_type) << dt_shift;
 		writel_relaxed(val, csid->base + CAMSS_CSID_CID_LUT_VC_n(vc));
 
 		val = CAMSS_CSID_CID_n_CFG_ISPIF_EN;
diff --git a/drivers/media/platform/qcom/camss/camss-csid.c b/drivers/media/platform/qcom/camss/camss-csid.c
index 5284b5857..2eb860d3d 100644
--- a/drivers/media/platform/qcom/camss/camss-csid.c
+++ b/drivers/media/platform/qcom/camss/camss-csid.c
@@ -833,7 +833,7 @@ static void csid_try_format(struct csid_device *csid,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
@@ -863,7 +863,7 @@ static void csid_try_format(struct csid_device *csid,
 				fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 			fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-			fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+			fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 			fmt->field = V4L2_FIELD_NONE;
 		}
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index 619abbf60..dc112e4e0 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1030,7 +1030,8 @@ static void csiphy_lanes_enable(struct csiphy_device *csiphy,
 	u8 val;
 	int i;
 
-	settle_cnt = csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
+	settle_cnt = camss_settle ? camss_settle :
+		     csiphy_settle_cnt_calc(link_freq, csiphy->timer_clk_rate);
 
 	val = CSIPHY_3PH_CMN_CSI_COMMON_CTRL5_CLK_ENABLE;
 	for (i = 0; i < c->num_data; i++)
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index a734fb7dd..834fef81f 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -382,7 +382,7 @@ static void csiphy_try_format(struct csiphy_device *csiphy,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
diff --git a/drivers/media/platform/qcom/camss/camss-ispif.c b/drivers/media/platform/qcom/camss/camss-ispif.c
index 43d3b133f..f4f90004b 100644
--- a/drivers/media/platform/qcom/camss/camss-ispif.c
+++ b/drivers/media/platform/qcom/camss/camss-ispif.c
@@ -795,7 +795,7 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 	enum ispif_intf intf = line->interface;
 	u8 csid = line->csid_id;
 	u8 vfe = line->vfe_id;
-	u8 vc = 0; /* Virtual Channel 0 */
+	u8 vc = camss_vc; /* L16: the ASICs send captures on VC 1 */
 	u8 cid = vc * 4; /* id of Virtual Channel and Data Type set */
 	int ret;
 
@@ -903,7 +903,7 @@ static void ispif_try_format(struct ispif_line *line,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
diff --git a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
index d84a375e3..0c2eb73c4 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe-gen1.c
@@ -241,7 +241,7 @@ static int vfe_enable_output(struct vfe_line *line)
 		vfe->ops_gen1->enable_irq_wm_line(vfe, output->wm_idx[0], line->id, 1);
 		vfe->ops_gen1->bus_connect_wm_to_rdi(vfe, output->wm_idx[0], line->id);
 		vfe->ops_gen1->wm_set_subsample(vfe, output->wm_idx[0]);
-		vfe->ops_gen1->set_rdi_cid(vfe, line->id, 0);
+		vfe->ops_gen1->set_rdi_cid(vfe, line->id, camss_vc * 4); /* L16: CID of the VC */
 		vfe->ops_gen1->wm_set_ub_cfg(vfe, output->wm_idx[0],
 					    (ub_size + 1) * output->wm_idx[0], ub_size);
 		vfe->ops_gen1->wm_frame_based(vfe, output->wm_idx[0], 1);
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
index d9105f73f..3e1fb9977 100644
--- a/drivers/media/platform/qcom/camss/camss-vfe.c
+++ b/drivers/media/platform/qcom/camss/camss-vfe.c
@@ -1393,7 +1393,7 @@ static void vfe_try_format(struct vfe_line *line,
 			fmt->code = MEDIA_BUS_FMT_UYVY8_1X16;
 
 		fmt->width = clamp_t(u32, fmt->width, 1, 8191);
-		fmt->height = clamp_t(u32, fmt->height, 1, 8191);
+		fmt->height = clamp_t(u32, fmt->height, 1, 16383);
 
 		fmt->field = V4L2_FIELD_NONE;
 		fmt->colorspace = V4L2_COLORSPACE_SRGB;
diff --git a/drivers/media/platform/qcom/camss/camss-video.c b/drivers/media/platform/qcom/camss/camss-video.c
index 831486e14..8adfdf6ad 100644
--- a/drivers/media/platform/qcom/camss/camss-video.c
+++ b/drivers/media/platform/qcom/camss/camss-video.c
@@ -21,7 +21,7 @@
 #define CAMSS_FRAME_MIN_WIDTH		1
 #define CAMSS_FRAME_MAX_WIDTH		8191
 #define CAMSS_FRAME_MIN_HEIGHT		1
-#define CAMSS_FRAME_MAX_HEIGHT_RDI	8191
+#define CAMSS_FRAME_MAX_HEIGHT_RDI	16383
 #define CAMSS_FRAME_MAX_HEIGHT_PIX	4096
 
 /* -----------------------------------------------------------------------------
diff --git a/drivers/media/platform/qcom/camss/camss.c b/drivers/media/platform/qcom/camss/camss.c
index 1c9bb62b9..d846bc736 100644
--- a/drivers/media/platform/qcom/camss/camss.c
+++ b/drivers/media/platform/qcom/camss/camss.c
@@ -3954,10 +3954,20 @@ int camss_get_pixel_clock(struct media_entity *entity, u64 *pixel_clock)
 	return 0;
 }
 
+/*
+ * A CSID powers up through a VFE. SoCs with more CSIDs than VFEs (msm8996: 4 and 2) would
+ * otherwise fail to power CSID2 and CSID3; they share a VFE instead.
+ */
+static int vfe_parent_dev_id(struct camss *camss, int id)
+{
+	return camss->res->vfe_num ? id % camss->res->vfe_num : id;
+}
+
 static int vfe_parent_dev_ops_get(struct camss *camss, int id)
 {
 	int ret = -EINVAL;
 
+	id = vfe_parent_dev_id(camss, id);
 	if (id < camss->res->vfe_num) {
 		struct vfe_device *vfe = &camss->vfe[id];
 
@@ -3969,6 +3979,7 @@ static int vfe_parent_dev_ops_get(struct camss *camss, int id)
 
 static int vfe_parent_dev_ops_put(struct camss *camss, int id)
 {
+	id = vfe_parent_dev_id(camss, id);
 	if (id < camss->res->vfe_num) {
 		struct vfe_device *vfe = &camss->vfe[id];
 
@@ -4059,23 +4070,19 @@ static int camss_of_parse_ports(struct camss *camss)
 {
 	struct device *dev = camss->dev;
 	struct device_node *node = NULL;
-	struct device_node *remote = NULL;
 	int ret, num_subdevs = 0;
 
 	for_each_endpoint_of_node(dev->of_node, node) {
 		struct camss_async_subdev *csd;
 
-		remote = of_graph_get_remote_port_parent(node);
-		if (!remote) {
-			dev_err(dev, "Cannot get remote parent\n");
-			ret = -EINVAL;
-			goto err_cleanup;
-		}
-
-		csd = v4l2_async_nf_add_fwnode(&camss->notifier,
-					       of_fwnode_handle(remote),
-					       struct camss_async_subdev);
-		of_node_put(remote);
+		/*
+		 * Match the remote endpoint rather than the remote device: a source
+		 * with several CSI-2 outputs (the Light L16's camera ASICs) connects to
+		 * several CSIPHYs and gets one bound call per connection.
+		 */
+		csd = v4l2_async_nf_add_fwnode_remote(&camss->notifier,
+						      of_fwnode_handle(node),
+						      struct camss_async_subdev);
 		if (IS_ERR(csd)) {
 			ret = PTR_ERR(csd);
 			goto err_cleanup;
@@ -4394,11 +4401,30 @@ static int camss_subdev_notifier_bound(struct v4l2_async_notifier *async,
 		container_of(asd, struct camss_async_subdev, asd);
 	u8 id = csd->interface.csiphy_id;
 	struct csiphy_device *csiphy = &camss->csiphy[id];
+	struct media_entity *sensor = &subdev->entity;
+	int pad, ret;
 
 	csiphy->cfg.csi2 = &csd->interface.csi2;
-	subdev->host_priv = csiphy;
 
-	return 0;
+	/* the source pad for this connection's endpoint, else the first one */
+	pad = media_entity_get_fwnode_pad(sensor, asd->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0)
+		for (pad = 0; pad < sensor->num_pads; pad++)
+			if (sensor->pads[pad].flags & MEDIA_PAD_FL_SOURCE)
+				break;
+	if (pad >= sensor->num_pads) {
+		dev_err(camss->dev, "No source pad in external entity\n");
+		return -EINVAL;
+	}
+
+	ret = media_create_pad_link(sensor, pad, &csiphy->subdev.entity,
+				    MSM_CSIPHY_PAD_SINK,
+				    MEDIA_LNK_FL_IMMUTABLE | MEDIA_LNK_FL_ENABLED);
+	if (ret < 0)
+		camss_link_err(camss, sensor->name, csiphy->subdev.entity.name, ret);
+
+	return ret;
 }
 
 static int camss_subdev_notifier_complete(struct v4l2_async_notifier *async)
@@ -4944,6 +4970,18 @@ static const struct of_device_id camss_dt_match[] = {
 
 MODULE_DEVICE_TABLE(of, camss_dt_match);
 
+int camss_vc;
+module_param_named(vc, camss_vc, int, 0644);
+MODULE_PARM_DESC(vc, "CSI-2 virtual channel to receive (L16: 0 preview, 1 capture)");
+
+int camss_dt;
+module_param_named(dt, camss_dt, int, 0644);
+MODULE_PARM_DESC(dt, "CSI-2 data type to receive instead of the format's (L16 captures: 0x30)");
+
+int camss_settle;
+module_param_named(settle, camss_settle, int, 0644);
+MODULE_PARM_DESC(settle, "CSIPHY settle count instead of the computed one (L16 stock: 14)");
+
 static int __maybe_unused camss_runtime_suspend(struct device *dev)
 {
 	struct camss *camss = dev_get_drvdata(dev);
diff --git a/drivers/media/platform/qcom/camss/camss.h b/drivers/media/platform/qcom/camss/camss.h
index e084fb77c..0b8e74734 100644
--- a/drivers/media/platform/qcom/camss/camss.h
+++ b/drivers/media/platform/qcom/camss/camss.h
@@ -13,6 +13,13 @@
 #include <linux/device.h>
 #include <linux/types.h>
 #include <media/v4l2-async.h>
+
+/* L16: CSI-2 virtual channel that CSID and ISPIF take (0 = preview, 1 = capture) */
+extern int camss_vc;
+/* L16: CSI-2 data type that CSID takes instead of the format's, if not 0 */
+extern int camss_dt;
+/* L16: CSIPHY settle count instead of the computed one, if not 0 */
+extern int camss_settle;
 #include <media/v4l2-device.h>
 #include <media/v4l2-subdev.h>
 #include <media/media-device.h>
