CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_PRINTK_TIME=y
CONFIG_L16_CANARY=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_CHARGER_QCOM_SMBCHG=y
CONFIG_BATTERY_QCOM_FG=y
CONFIG_DRM_MSM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_INNOLUX_NT35695_L16=y
CONFIG_BACKLIGHT_LM3630_L16=y
CONFIG_DRM=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_MSM_MMCC_8996=y
CONFIG_SCSI_UFS_QCOM=m
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=m
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F12=y
CONFIG_RMI4_F11=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_SENSORS_TMP102=y
# CONFIG_TOUCHSCREEN_ELAN is not set
CONFIG_INPUT_L16_TOUCHSTRIP=y
CONFIG_INPUT_DW7800_HAPTICS=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_IIO_QCOM_SMGR=m
# text console upright in landscape (fbcon=rotate:1 on the command line)
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# camera ASICs as a CSI-2 source for CAMSS
CONFIG_VIDEO_LIGHT_CCB=m

# dma-buf heaps for libcamera's software ISP (GNOME Snapshot, PipeWire)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_UDMABUF=y
