#!/sbin/openrc-run
# The Light L16's GNSS for geoclue (the modem's NMEA on /run/l16-gnss.sock)

description="Light L16 GNSS"
command=/usr/bin/l16-gnss
command_background=true
pidfile=/run/l16-gnss.pid
output_log=/var/log/l16-gnss.log
error_log=/var/log/l16-gnss.log

depend() {
	need rmtfs
	before geoclue
}
