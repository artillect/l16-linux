#!/usr/bin/python3
# l16-gnss: the Light L16's GNSS for geoclue. The receiver is the modem DSP's (QMI LOC over
# QRTR, node 0); ModemManager doesn't take this modem (it has no cellular services), so this
# holds the one LOC client and serves the engine's NMEA on a socket geoclue's network-nmea
# source reads. The engine runs only while a reader is connected. Each start injects the time
# and the last fix (kept in /var/lib/l16-gnss/last) so the engine knows roughly where to look;
# and the modem gets XTRA, Qualcomm's predicted orbits (a week's worth, from the servers the
# modem names), refreshed over Wi-Fi, so a first fix takes seconds rather than minutes.

import grp
import math
import os
import socket
import sys
import threading
import time
import urllib.request

import gi
gi.require_version('Qmi', '1.0')
gi.require_version('Qrtr', '1.0')
from gi.repository import GLib, Qmi, Qrtr

SOCKET = '/run/l16-gnss.sock'
LAST = '/var/lib/l16-gnss/last'
XTRA = '/var/lib/l16-gnss/xtra3grc.bin'
XTRA_AHEAD = 86400          # refresh when the modem's data runs out within this
XTRA_RETRY = 1800           # after every server failed (no network yet, say)
PART = 1024                 # stock's QMI_LOC_MAX_PREDICTED_ORBITS_PART_LEN
SESSION = 1

loop = GLib.MainLoop()
readers = {}       # connected sockets: their GLib watch
state = {'device': None, 'client': None, 'running': False, 'saved': 0.0}
# XTRA: the modem's servers, its data's end (unix s, 0 for none), a refresh under way (the
# server being tried, the file, whether its injection is being checked)
xtra = {'urls': [], 'valid_until': None, 'busy': False, 'job': None}


def log(*a):
    print('l16-gnss:', *a, file=sys.stderr, flush=True)


# --- the modem -------------------------------------------------------------------------------

def connect_modem():
    def got_bus(src, res):
        bus = Qrtr.Bus.new_finish(res)
        state['bus'] = bus
        # the modem boots ~20 s into the system's start
        bus.wait_for_node(0, 120000, None, got_node)

    def got_node(bus, res):
        try:
            node = bus.wait_for_node_finish(res)
        except GLib.Error as e:
            log('no modem:', e.message)
            loop.quit()
            return
        Qmi.Device.new_from_node(node, None, got_device)

    def got_device(src, res):
        device = Qmi.Device.new_from_node_finish(res)
        device.open(Qmi.DeviceOpenFlags.NONE, 10, None, opened)
        state['device'] = device

    def opened(device, res):
        device.open_finish(res)
        device.allocate_client(Qmi.Service.LOC, Qmi.CID_NONE, 10, None, allocated)

    def allocated(device, res):
        try:
            client = device.allocate_client_finish(res)
        except GLib.Error as e:
            # the modem isn't up yet (systemd starts this before the modem has booted): ask
            # again
            log('no LOC client yet:', e.message)
            GLib.timeout_add_seconds(5, lambda: (device.allocate_client(
                Qmi.Service.LOC, Qmi.CID_NONE, 10, None, allocated), False)[1])
            return
        client.connect('nmea', on_nmea)
        client.connect('position-report', on_position)
        inp = Qmi.MessageLocRegisterEventsInput()
        inp.set_event_registration_mask(Qmi.LocEventRegistrationFlag.NMEA |
                                        Qmi.LocEventRegistrationFlag.POSITION_REPORT)
        client.register_events(inp, 10, None, registered)
        state['client'] = client

    def registered(client, res):
        client.register_events_finish(res)
        log('modem ready')
        if readers:
            start()
        client.connect('get-predicted-orbits-data-source', on_xtra_source)
        client.connect('get-predicted-orbits-data-validity', on_xtra_validity)
        client.connect('inject-predicted-orbits-data', on_xtra_injected)
        xtra_query()
        GLib.timeout_add_seconds(6 * 3600, lambda: (xtra_query(), True)[1])

    Qrtr.Bus.new(1000, None, got_bus)


def on_nmea(client, out):
    try:
        line = out.get_nmea_string().strip()
    except GLib.Error:
        return
    data = (line + '\r\n').encode()
    for r in list(readers):
        try:
            r.sendall(data)
        except OSError:
            drop(r)


def on_position(client, out):
    # the last fix, for the next start's injection (at most once a minute)
    try:
        if out.get_session_status() != Qmi.LocSessionStatus.SUCCESS:
            return
        lat, lon = out.get_latitude(), out.get_longitude()
        unc = out.get_horizontal_uncertainty_circular()
    except GLib.Error:
        return
    now = time.monotonic()
    if now - state['saved'] < 60:
        return
    state['saved'] = now
    try:
        os.makedirs(os.path.dirname(LAST), exist_ok=True)
        with open(LAST + '.new', 'w') as f:
            f.write(f'{lat} {lon} {unc} {int(time.time())}\n')
        os.replace(LAST + '.new', LAST)
    except OSError as e:
        log('saving the fix:', e)


def ignore(client, res, finish):
    try:
        finish(res)
    except GLib.Error as e:
        log(e.message)


def inject():
    client = state['client']
    # the time (the system's, from NTP over Wi-Fi), within a second
    t = Qmi.MessageLocInjectUtcTimeInput()
    t.set_utc_time(int(time.time() * 1000))
    t.set_time_uncertainty(1000)
    client.inject_utc_time(t, 10, None, lambda c, r: ignore(c, r, c.inject_utc_time_finish))
    # the last fix, its uncertainty grown by how old it is (a camera moves on foot or by car)
    try:
        lat, lon, unc, when = open(LAST).read().split()
        age = max(0, time.time() - int(when))
        unc = min(float(unc) + age * 30, 500000.0)
    except (OSError, ValueError):
        return
    p = Qmi.MessageLocInjectPositionInput()
    p.set_latitude(float(lat))
    p.set_longitude(float(lon))
    p.set_horizontal_uncertainty_circular(unc)
    client.inject_position(p, 10, None, lambda c, r: ignore(c, r, c.inject_position_finish))


def start():
    client = state['client']
    if client is None or state['running']:
        return
    inject()
    inp = Qmi.MessageLocStartInput()
    inp.set_session_id(SESSION)
    inp.set_fix_recurrence_type(Qmi.LocFixRecurrenceType.PERIODIC_FIXES)
    inp.set_intermediate_report_state(Qmi.LocIntermediateReportState.ENABLE)
    inp.set_minimum_interval_between_position_reports(1000)
    client.start(inp, 10, None, lambda c, r: ignore(c, r, c.start_finish))
    state['running'] = True
    log('started')


def stop():
    client = state['client']
    if client is None or not state['running']:
        return
    inp = Qmi.MessageLocStopInput()
    inp.set_session_id(SESSION)
    client.stop(inp, 10, None, lambda c, r: ignore(c, r, c.stop_finish))
    state['running'] = False
    log('stopped')


# --- XTRA ------------------------------------------------------------------------------------
#
# Each of the modem's servers serves its own xtra3grc.bin, and not all suit this modem's 2016
# firmware: xtrapath1's is refused at the last part, older formats are taken but never dated
# (validity 1980). xtrapath3's is what stock's Android injects (seen in an strace of it), and
# xtrapath2's works too. So: try the servers in the modem's order and believe only the
# modem's validity afterwards. A refused injection wipes the modem's XTRA, so refresh only
# when its own runs out.

def xtra_query():
    client = state['client']
    client.get_predicted_orbits_data_source(None, 10, None,
        lambda c, r: ignore(c, r, c.get_predicted_orbits_data_source_finish))
    client.get_predicted_orbits_data_validity(None, 10, None,
        lambda c, r: ignore(c, r, c.get_predicted_orbits_data_validity_finish))


def on_xtra_source(client, out):
    try:
        xtra['urls'] = list(out.get_server_list())
    except GLib.Error as e:
        log('XTRA source:', e.message)
        return
    xtra_check()


def on_xtra_validity(client, out):
    try:
        start, hours = out.get_validity_info()
    except GLib.Error:
        start, hours = 0, 0
    # undated data (start at the GPS epoch) is none: the modem took a file it can't use
    xtra['valid_until'] = start + hours * 3600 if start > 946684800 else 0
    left = (xtra['valid_until'] - time.time()) / 3600
    job = xtra['job']
    if job and job.get('verify'):
        if left > 0:
            log(f'XTRA injected from {job["url"]}: valid {left:.0f} h')
            xtra['job'], xtra['busy'] = None, False
        else:
            log(f'XTRA from {job["url"]}: taken but not dated')
            xtra_try(job['i'] + 1)
        return
    log(f'XTRA in the modem: {left:.0f} h left' if left > 0 else 'XTRA in the modem: none valid')
    xtra_check()


def xtra_check():
    if not xtra['urls'] or xtra['valid_until'] is None or xtra['busy']:
        return
    if xtra['valid_until'] - time.time() < XTRA_AHEAD:
        xtra['busy'] = True
        xtra_try(0)


def xtra_try(i):
    """The modem's server i: download (in a thread: the network may be slow), then inject."""
    if i >= len(xtra['urls']):
        log(f'XTRA: no server\'s file taken; again in {XTRA_RETRY // 60} min')
        xtra['job'], xtra['busy'] = None, False
        GLib.timeout_add_seconds(XTRA_RETRY, lambda: (xtra_query(), False)[1])
        return
    url = xtra['urls'][i]

    def download():
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'l16-gnss'})
            with urllib.request.urlopen(req, timeout=30) as r:
                data = r.read()
            if not data:
                raise ValueError('empty')
        except Exception as e:
            log(f'XTRA from {url}: {e}')
            data = None
        GLib.idle_add(lambda: (downloaded(data), False)[1])

    def downloaded(data):
        if data is None:
            xtra_try(i + 1)
            return
        try:
            os.makedirs(os.path.dirname(XTRA), exist_ok=True)
            with open(XTRA, 'wb') as f:
                f.write(data)
        except OSError:
            pass
        xtra['job'] = {'i': i, 'url': url, 'data': data, 'parts': math.ceil(len(data) / PART)}
        xtra_send(1)
    threading.Thread(target=download, daemon=True).start()


def xtra_send(n):
    job = xtra['job']
    inp = Qmi.MessageLocInjectPredictedOrbitsDataInput()
    inp.set_total_size(len(job['data']))
    inp.set_total_parts(job['parts'])
    inp.set_part_number(n)
    inp.set_part_data(list(job['data'][(n - 1) * PART:n * PART]))
    state['client'].inject_predicted_orbits_data(inp, 10, None, xtra_sent)


def xtra_sent(client, res):
    """A part's request answered: an error (a timeout, a modem hiccup) brings no indication,
    and the job never moved on (busy for good, XTRA never refreshed): the next server."""
    try:
        client.inject_predicted_orbits_data_finish(res)
    except GLib.Error as e:
        job = xtra['job']
        log(f'XTRA: inject: {e.message}')
        if job is not None and not job.get('verify'):
            xtra_try(job['i'] + 1)


def on_xtra_injected(client, out):
    job = xtra['job']
    if job is None or job.get('verify'):
        return
    try:
        status = out.get_indication_status()
    except GLib.Error:
        status = None
    try:
        n = out.get_part_number()
    except GLib.Error:
        n = 0
    if status != Qmi.LocIndicationStatus.SUCCESS:
        log(f'XTRA from {job["url"]}: refused ({status.value_nick if status else "?"})')
        xtra_try(job['i'] + 1)
        return
    if n < job['parts']:
        xtra_send(n + 1)
        return
    job['verify'] = True
    client.get_predicted_orbits_data_validity(None, 10, None,
        lambda c, r: ignore(c, r, c.get_predicted_orbits_data_validity_finish))


# --- the readers -----------------------------------------------------------------------------

def drop(r, from_watch=False):
    """A reader gone: its watch removed (unless it is the watch's own doing: it returns False)
    before the socket is closed. A watch left on a closed fd spun the main loop."""
    if r in readers:
        watch = readers.pop(r)
        if not from_watch:
            GLib.source_remove(watch)
        r.close()
    if not readers:
        stop()


def on_reader_data(fd, cond, r):
    # readers send nothing; this is their hangup
    try:
        if cond & (GLib.IO_HUP | GLib.IO_ERR) or not r.recv(256):
            drop(r, True)
            return False
    except OSError:
        drop(r, True)
        return False
    return True


def on_accept(fd, cond, server):
    r, _ = server.accept()
    r.setblocking(False)
    readers[r] = GLib.io_add_watch(r.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, on_reader_data, r)
    start()
    return True


def main():
    try:
        os.unlink(SOCKET)
    except FileNotFoundError:
        pass
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(SOCKET)
    # geoclue's alone: it gives the location to the apps it allows, and any process
    # connecting here had it unasked (and kept the receiver running)
    try:
        os.chown(SOCKET, 0, grp.getgrnam('geoclue').gr_gid)
        os.chmod(SOCKET, 0o660)
    except (KeyError, OSError) as e:
        log('the socket for geoclue:', e)
    server.listen(4)
    GLib.io_add_watch(server.fileno(), GLib.IO_IN, on_accept, server)
    connect_modem()
    loop.run()


if __name__ == '__main__':
    main()
