#!/bin/sh
# L16 mainline initramfs: USB ACM serial shell (ttyGS0) + USB NCM network with ssh.
# Network: phone 172.16.42.1, PC gets 172.16.42.2 by DHCP (same addresses as postmarketOS).

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
# there is no console device, so init starts without stdin/stdout/stderr; give it real
# ones, or daemons get their sockets as fd 0-2 and then close them when they detach
exec 0</dev/null 1>/dev/null 2>&1
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config

log() { echo "l16 init: $*" > /dev/kmsg; }
log "started"

G=/sys/kernel/config/usb_gadget/l16
mkdir $G
echo 0x1d6b > $G/idVendor	# Linux Foundation
echo 0x0104 > $G/idProduct	# Multifunction Composite Gadget
echo 0x0200 > $G/bcdDevice	# new revision so Windows doesn't reuse the ACM-only setup
# composite with interface association descriptors (needed for Windows)
echo 0xEF > $G/bDeviceClass
echo 0x02 > $G/bDeviceSubClass
echo 0x01 > $G/bDeviceProtocol
mkdir $G/strings/0x409
echo "Light" > $G/strings/0x409/manufacturer
echo "L16 mainline" > $G/strings/0x409/product
echo "LFCLHMB822600250" > $G/strings/0x409/serialnumber
mkdir $G/functions/acm.usb0
mkdir $G/functions/ncm.usb0
echo 02:4c:31:36:00:01 > $G/functions/ncm.usb0/dev_addr
echo 02:4c:31:36:00:02 > $G/functions/ncm.usb0/host_addr
mkdir -p $G/configs/c.1/strings/0x409
echo "ACM + NCM" > $G/configs/c.1/strings/0x409/configuration
ln -s $G/functions/acm.usb0 $G/configs/c.1/
ln -s $G/functions/ncm.usb0 $G/configs/c.1/

# the UDC appears once the PHY and dwc3 have probed
for i in $(seq 1 60); do
	UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
	[ -n "$UDC" ] && break
	sleep 0.5
done
if [ -z "$UDC" ]; then
	log "no UDC after 30 s"
else
	echo "$UDC" > $G/UDC
	log "gadget bound to $UDC"
	# give a connected host a moment to configure us (no cable is fine too)
	for i in $(seq 1 20); do
		S=$(cat /sys/class/udc/$UDC/state)
		[ "$S" = configured ] && break
		sleep 0.5
	done
	log "udc state: $S, input limit $(cat /sys/class/power_supply/qcom-smbchg-usb/input_current_limit) uA"
fi

# UFS: the drivers are modules so they load after USB is up; UFS clock gating stalls USB
# DMA on this board (shared bus clock), so turn gating off as soon as the host is probed
cd /lib/modules/l16
insmod qcom_ice.ko; insmod phy-qcom-qmp-ufs.ko; insmod ufs-qcom.ko
U=/sys/bus/platform/devices/624000.ufshc
echo 0 > $U/clkgate_enable
echo on > $U/power/control
cd /
log "UFS: $(ls /sys/block | grep -c '^sd') LUNs, clock gating $(cat $U/clkgate_enable)"

# USB network: static address, DHCP for the PC, ssh (key login only)
NET=$(cat $G/functions/ncm.usb0/ifname 2>/dev/null)
if [ -n "$NET" ]; then
	ip link set lo up
	ip addr add 172.16.42.1/24 dev $NET
	ip link set $NET up
	cat > /etc/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface $NET
lease_file /tmp/udhcpd.leases
max_leases 1
option subnet 255.255.255.0
EOF
	touch /tmp/udhcpd.leases
	/bin/busybox-extras udhcpd /etc/udhcpd.conf
	# dropbear needs the kernel RNG initialised for its host keys; blocking on /dev/random
	# makes the kernel gather jitter entropy (about 1.5 s here)
	head -c 16 /dev/random > /dev/null
	/usr/sbin/dropbear -R -s
	log "network $NET 172.16.42.1 up, udhcpd + dropbear started"
else
	log "no NCM interface"
fi

# power key held 3 s -> reboot back to Android
/sbin/holdreboot &

# boot finished; the reset timer (catches hangs during boot, falls back to Android) can go
echo 1 > /sys/module/l16_canary/parameters/disarm
log "boot complete"

# postmarketOS on the "linux" partition: hand over to it unless it's missing, has no
# init, or has an /l16-shell file (then stay in this shell). The USB gadget, the UFS
# clock gating setting and holdreboot carry over; pmOS runs its own ssh and DHCP.
ROOT=
for p in /sys/class/block/sd*; do
	grep -q '^PARTNAME=linux$' $p/uevent 2>/dev/null && ROOT=/dev/${p##*/}
done
mkdir -p /newroot
if [ -n "$ROOT" ] && mount -o rw $ROOT /newroot; then
	# "l16shell" on the kernel command line also keeps us here (e.g. to repair the rootfs)
	if [ -x /newroot/sbin/init ] && [ ! -e /newroot/l16-shell ] &&
	   ! grep -qw l16shell /proc/cmdline; then
		log "switching to postmarketOS on $ROOT"
		# udhcpd runs as "busybox-extras"
		/usr/bin/killall busybox-extras dropbear
		mount --move /proc /newroot/proc
		mount --move /sys /newroot/sys
		mount --move /dev /newroot/dev
		exec switch_root /newroot /sbin/init
	fi
	umount /newroot
	log "staying in the initramfs shell"
fi

while true; do
	/sbin/getty -n -l /bin/sh 115200 ttyGS0
	sleep 1
done
